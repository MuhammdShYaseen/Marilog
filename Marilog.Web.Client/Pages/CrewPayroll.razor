@page "/payroll"
@using Marilog.Contracts.DTOs.Requests.CrewPayrollDTOs
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Contracts.Interfaces.Services.SystemServices
@using Marilog.Kernel.Enums
@using Marilog.Shared.UI.Pages.CrewPayroll
@using MudBlazor
@using Marilog.Web.Client.Services.Interfaces
@inject ICrewPayrollService PayrollService
@inject ICrewContractService CrewContractService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IManageStoredFiles ManageStoredFiles
@inject ICurrencyService CurrencyService

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
@if (_initialized)
{
    <SharedCrewPayrollPage PayrollByMonth="_byMonth"
                           PayrollByStatus="_byStatus"
                           Outstanding="_outstanding"
                           Selected="_selected"
                           OnSelectedChanged="SelectAsync"
                           OnAddClicked="OpenAddDialog"
                           OnEditClicked="OpenEditDialog"
                           OnDeleteClicked="ConfirmDelete"
                           OnApproveClicked="Approve"
                           OnCancelClicked="Cancel"
                           OnPayClicked="OpenPayDialog"
                           OnConfirmDisbursementClicked="@(a => ConfirmDisbursement(a.payrollId, a.disbursement))"
                           OnCancelDisbursementClicked="@(a => CancelDisbursement(a.payrollId, a.disbursement))"
                           OnMonthSelected="LoadByMonth"
                           OnStatusChanged="LoadByStatus"
                           OnManageAttachedFilesClicked="@(arg => ManageStoredFiles.OpenManageStoredFilesDialogAsync(arg, XLabel(arg.entityId)))" />
}

@code {
    private IReadOnlyList<CrewPayrollResponse> _byMonth = [];
    private IReadOnlyList<CrewPayrollResponse> _byStatus = [];
    private IReadOnlyList<CrewPayrollResponse> _outstanding = [];
    private IReadOnlyList<CrewContractResponse> _contracts = [];
    private IReadOnlyList<CurrencyResponse> _currencies = [];
    private bool _loading = true;

    private DateOnly _selectedMonth = DateOnly.FromDateTime(DateTime.Today);
    private PayrollStatus _selectedStatus = PayrollStatus.Draft;

    string? XLabel(int payrollId) =>
    _byMonth.Concat(_byStatus).Concat(_outstanding)
            .FirstOrDefault(x => x.Id == payrollId) is { } p
        ? $"Crew Member : {p.PersonFullName} — {p.PayrollMonth:MMM yyyy}"
        : null;
    private bool _initialized;
    private CrewPayrollResponse? _selected;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _currencies = await CurrencyService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        await LoadAsync();
        _initialized = true;
    }
    // ─── Loading ───────────────────────────────────────────────────────────

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var t1 = PayrollService.GetByMonthAsync(_selectedMonth);
            var t2 = PayrollService.GetByStatusAsync(_selectedStatus);
            var t3 = PayrollService.GetOutstandingAsync();
            var t4 = CrewContractService.GetAllAsync();
            await Task.WhenAll(t1, t2, t3, t4);

            _byMonth = t1.Result;
            _byStatus = t2.Result;
            _outstanding = t3.Result;
            _contracts = t4.Result;
            if (_selected is not null)
                _selected = await PayrollService.GetByIdAsync(_selected.Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadByMonth(DateOnly month)
    {
        _selectedMonth = month;
        try
        {
            _byMonth = await PayrollService.GetByMonthAsync(month);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        StateHasChanged();
    }

    private async Task LoadByStatus(PayrollStatus? status)
    {
        _selectedStatus = status ?? PayrollStatus.Draft;
        try
        {
            _byStatus = await PayrollService.GetByStatusAsync(_selectedStatus);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        StateHasChanged();
    }

    private async Task SelectAsync(CrewPayrollResponse? payroll)
    {
        if (payroll is null)
        {
            _selected = null;
            return;
        }

        try
        {
            _selected = await PayrollService.GetByIdAsync(payroll.Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>Runs a command, shows the outcome, reloads on success.</summary>
    private async Task RunAsync(Func<Task> action, string successMessage, Severity severity = Severity.Success)
    {
        try
        {
            await action();
            Snackbar.Add(successMessage, severity);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // ─── Payroll Dialogs ───────────────────────────────────────────────────

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters
        {
            ["Contracts"] = _contracts,
            ["Currencies"] = _currencies
        };

        var dialog = await DialogService.ShowAsync<CrewPayrollFormDialog>("New Payroll", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        if (result.Data is CreateCrewPayrollRequest request)
        {
            await RunAsync(() => PayrollService.CreateAsync(
                                     request.ContractId,
                                     request.PayrollMonth,
                                     request.CurrencyId,
                                     request.Allowances,
                                     request.Deductions,
                                     request.Notes),
                           "Payroll added.");
        }
    }

    private async Task OpenEditDialog(CrewPayrollResponse payroll)
    {
        var parameters = new DialogParameters
        {
            ["Payroll"] = payroll,
            ["Contracts"] = _contracts
        };

        var dialog = await DialogService.ShowAsync<CrewPayrollFormDialog>("Edit Payroll", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        if (result.Data is UpdateCrewPayrollRequest request)
        {
            await RunAsync(() => PayrollService.UpdateAsync(
                                     payroll.Id,
                                     request.ContractId,
                                     request.CurrencyId,
                                     request.Allowances,
                                     request.Deductions,
                                     request.Notes),
                           "Payroll updated.");
        }
    }

    // ─── Payroll Actions ───────────────────────────────────────────────────

    private Task Approve(CrewPayrollResponse payroll) =>
        RunAsync(() => PayrollService.ApproveAsync(payroll.Id), "Payroll approved.");

    private async Task Cancel(CrewPayrollResponse payroll)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Cancel Payroll",
            $"Cancel payroll for '{payroll.PersonFullName}' — {payroll.PayrollMonth:MMM yyyy}?",
            yesText: "Cancel Payroll",
            cancelText: "Back");

        if (confirmed != true) return;

        await RunAsync(() => PayrollService.CancelAsync(payroll.Id, "Cancelled by user"),
                       "Payroll cancelled.", Severity.Warning);
    }

    private async Task ConfirmDelete(CrewPayrollResponse payroll)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Payroll",
            $"Delete payroll for '{payroll.PersonFullName}' — {payroll.PayrollMonth:MMM yyyy}?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true) return;

        await RunAsync(async () =>
        {
            await PayrollService.DeleteAsync(payroll.Id);
            if (_selected?.Id == payroll.Id) _selected = null;
        }, 
        "Payroll deleted.");
    }

    // ─── Disbursement ──────────────────────────────────────────────────────

    private async Task OpenPayDialog(CrewPayrollResponse payroll)
    {
        var parameters = new DialogParameters
        {
            ["RemainingBalance"] = payroll.RemainingBalance,
            ["CurrencyCode"] = payroll.CurrencyCode
        };

        var dialog = await DialogService.ShowAsync<PaymentDialog>("Record Payment", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        if (result.Data is PayCrewPayrollRequest request)
        {
            await RunAsync(() => PayrollService.PayAsync(payroll.Id, request), "Payment recorded.");
        }
    }

    // ─── Disbursement Actions ──────────────────────────────────────────────

    public async Task ConfirmDisbursement(int payrollId, DisbursementResponse disbursement)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Confirm Disbursement",
            $"Confirm disbursement of {disbursement.Amount:N2} via {disbursement.Method}? A confirmed disbursement cannot be cancelled.",
            yesText: "Confirm",
            cancelText: "Back");

        if (confirmed != true) return;

        await RunAsync(() => PayrollService.ConfirmDisbursementAsync(payrollId, disbursement.Id),
                       "Disbursement confirmed.");
    }

    public async Task CancelDisbursement(int payrollId, DisbursementResponse disbursement)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Cancel Disbursement",
            $"Cancel disbursement of {disbursement.Amount:N2} via {disbursement.Method}?",
            yesText: "Cancel Disbursement",
            cancelText: "Back");

        if (confirmed != true) return;

        await RunAsync(() => PayrollService.CancelDisbursementAsync(payrollId, disbursement.Id, "Cancelled by user"),
                       "Disbursement cancelled.", Severity.Warning);
    }
}