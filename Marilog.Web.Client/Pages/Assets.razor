@attribute [RequirePage(EntityType.Document)]
@page "/assets"
<PageTitle>Assets</PageTitle>
@using Kernel.Enums
@using Marilog.Contracts.Common
@using Marilog.Contracts.DTOs.Reports.DocumentReports
@using Marilog.Contracts.DTOs.Requests.DocumentDTOs
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Contracts.Interfaces.Services.SystemServices
@using Marilog.Shared.UI.Pages.Assets
@using Marilog.Web.Client.Services.Interfaces
@using MudBlazor
@inject IDocumentService DocumentService
@inject IVesselService VesselService
@inject IRecordCreator RecordCreator
@inject IManageStoredFiles ManageStoredFiles
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}

<SharedAssetsPage Items="_items"
                  Vessels="_vessels"
                  CurrentPage="_page"
                  TotalPages="_totalPages"
                  OnAddClicked="OpenAddDialog"
                  OnRefreshClicked="() => LoadPageAsync(_page)"
                  OnAssetSelected="OpenDetail"
                  OnDeleteClicked="ConfirmDelete"
                  OnManageAttachedFilesClicked="@(arg => ManageStoredFiles.OpenManageStoredFilesDialogAsync(arg, Label(arg.entityId)))"
                  OnPageChanged="LoadPageAsync"
                  OnFilterChanged="OnFilterChanged" />

@code {
    private const int PageSize = 20;

    private IReadOnlyList<DocumentResponse> _items = [];
    private IReadOnlyList<VesselLookupResponse> _vessels = [];
    private int _page = 1;
    private int _totalPages;
    private bool _loading = true;

    private DocumentFilterOptions _options = new();
    private string? _search;

    protected override async Task OnInitializedAsync()
    {
        _vessels = await VesselService.GetAllAsLookUpAsync();
        await LoadPageAsync(1);
    }

    private async Task LoadPageAsync(int page)
    {
        _loading = true;
        try
        {
            var result = await DocumentService.GetFilteredAssetsAsync(
                _options, new PagedRequest { Page = page, PageSize = PageSize, SearchTerm = _search });

            _items = result.Items;
            _totalPages = result.TotalPages;
            _page = page;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task OnFilterChanged((DocumentFilterOptions Options, string? Search) filter)
    {
        _options = filter.Options;
        _search = filter.Search;
        return LoadPageAsync(1);
    }

    // The document page already has payments, adjustments, edit, files and comments.
    private void OpenDetail(DocumentResponse doc) => Nav.NavigateTo($"/documents/{doc.Id}");

    private async Task OpenAddDialog()
    {
        var id = await RecordCreator.CreateDocumentAsync(new CreateDocumentRequest { Side = FinancialSide.AssetPurchase });
        if (id is null) return;

        Snackbar.Add("Asset created.", Severity.Success);
        await LoadPageAsync(1);
    }

    private async Task ConfirmDelete(DocumentResponse doc)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Asset", $"Delete '{doc.DocNumber}'?",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;

        await DocumentService.DeleteAsync(doc.Id);
        Snackbar.Add("Asset deleted.", Severity.Success);
        await LoadPageAsync(_page);
    }

    private string? Label(int documentId) =>
        _items.FirstOrDefault(d => d.Id == documentId)?.DocNumber;
}