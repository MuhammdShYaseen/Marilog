@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@using Marilog.Contracts.DTOs.Requests.UserIdenty
@using Marilog.Contracts.Interfaces.Services.SystemServices
@using Marilog.Web.Client.Auth
@inject ICompanyService CompanyService
@inject CookieAuthStateProvider AuthProvider
@inject NavigationManager Nav

<div class="az-login">
    <div class="az-login-card">
        <img src="_content/Marilog.Shared.UI/images/marilog-logo.svg" alt="Marilog" class="az-login-logo" />

        @if (!string.IsNullOrWhiteSpace(_companyName))
        {
            <div class="az-login-company">@_companyName</div>
        }

        <MudText Typo="Typo.h5" Class="az-login-title">Sign in</MudText>

        <EditForm Model="_model" OnSubmit="SubmitAsync">
            <MudTextField @bind-Value="_model.UserName"
                          Label="Username"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          AutoFocus="true"
                          Disabled="_busy"
                          Class="mb-3" />

            <MudTextField @bind-Value="_model.Password"
                          Label="Password"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Disabled="_busy"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                          OnAdornmentClick="() => _showPassword = !_showPassword"
                          AdornmentAriaLabel="Show password"
                          Class="mb-3" />

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
            }

            <div class="az-login-actions">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           DropShadow="false"
                           Disabled="_busy"
                           Class="az-login-submit">
                    @(_busy ? "Signing in..." : "Sign in")
                </MudButton>
            </div>
        </EditForm>
    </div>

    <div class="az-login-footer">Marilog &middot; &copy; @DateTime.Now.Year</div>
</div>

<style>
    .az-login {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px 16px;
        background: var(--mud-palette-background);
    }

    .az-login-card {
        width: 100%;
        max-width: 440px;
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-top: 3px solid var(--mud-palette-primary);
        border-radius: 2px;
        padding: 40px 44px 32px;
    }

    .az-login-logo {
        display: block;
        height: 64px;
        width: auto;
    }

    .az-login input:-webkit-autofill,
    .az-login input:-webkit-autofill:hover,
    .az-login input:-webkit-autofill:focus {
        -webkit-box-shadow: 0 0 0 1000px var(--mud-palette-surface) inset !important;
        -webkit-text-fill-color: var(--mud-palette-text-primary) !important;
        caret-color: var(--mud-palette-text-primary);
    }

    .az-login-company {
        margin-top: 4px;
        font-size: .95rem;
        color: var(--mud-palette-text-primary);
    }

    .az-login-title {
        font-weight: 600 !important;
        margin: 24px 0 20px !important;
    }

    .az-login-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 8px;
    }

    .az-login-submit {
        min-width: 108px;
        border-radius: 2px !important;
        text-transform: none !important;
    }

    .az-login-footer {
        margin-top: 16px;
        font-size: .75rem;
        color: var(--mud-palette-text-secondary);
    }

    @@media (max-width: 480px) {
        .az-login-card {
            padding: 28px 24px 24px;
        }
    }
</style>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private string? _companyName;

    private readonly LoginModel _model = new();
    private bool _busy;
    private bool _showPassword;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo(SafeReturnUrl(), replace: true);
            return;
        }

        try
        {
            _companyName = (await CompanyService.GetOwnCompanyNameAsync())?.Name;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            // The company name is cosmetic — never block sign-in over it.
        }
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.UserName) || string.IsNullOrEmpty(_model.Password))
        {
            _error = "Enter username and password.";
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            await AuthProvider.LoginAsync(new LoginRequest(_model.UserName.Trim(), _model.Password));
            Nav.NavigateTo(SafeReturnUrl(), replace: true);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _error = ex.Message;
            _model.Password = string.Empty;
        }
        finally
        {
            _busy = false;
        }
    }

    private string SafeReturnUrl()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl)) return "";
        if (ReturnUrl.Contains("://") || ReturnUrl.StartsWith('/') || ReturnUrl.StartsWith('\\')) return "";
        if (ReturnUrl.StartsWith("login", StringComparison.OrdinalIgnoreCase)) return "";
        return ReturnUrl;
    }

    private sealed class LoginModel
    {
        public string UserName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}