@using MudBlazor
@namespace Marilog.Web.Client.Pages
<div class="az-forbidden">
    <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Error" Size="Size.Large" />
    <MudText Typo="Typo.h6">Access denied</MudText>
    <MudText Typo="Typo.body2" Class="az-muted">
        You don't have permission to view this page. Ask an administrator if you need access.
    </MudText>
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">
        Back to home
    </MudButton>
</div>

<style>
    .az-forbidden {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .75rem;
        padding: 4rem 1rem;
        text-align: center;
    }
</style>