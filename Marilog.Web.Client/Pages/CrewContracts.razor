@attribute [RequirePage(EntityType.CrewContract)]
@page "/crew-contracts"
@page "/crew-contracts/{Id:int}"
@using Marilog.Contracts.DTOs.Requests.CrewDTOs
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Contracts.Interfaces.Services.SystemServices
@using Marilog.Kernel.Enums
@using Marilog.Shared.UI.Pages.CrewContracts
@using Marilog.Web.Client.Services.Interfaces
@using MudBlazor

@inject ICrewContractService CrewContractService
@inject IVesselService       VesselService
@inject IPersonService       PersonService
@inject IRankService         RankService
@inject IPortService         PortService
@inject ISnackbar            Snackbar
@inject IDialogService       DialogService
@inject IManageStoredFiles ManageStoredFiles
@inject IManageComments ManageComments
@inject NavigationManager Nav
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}

@if (Id is not null)
{
    @if (_contract is not null)
    {
        <MudPaper Class="pa-4" Outlined="true" Elevation="0">
            <CrewContractDetails Contract="_contract"
                                 OnClose="@(() => Nav.NavigateTo("/crew-contracts"))"
                                 OnEditClicked="OpenEditDialog"
                                 OnDeleteClicked="ConfirmDelete"
                                 OnSignOffClicked="OpenSignOffDialog"
                                 OnManageAttachedFilesClicked="@(arg => ManageStoredFiles.OpenManageStoredFilesDialogAsync(arg, CrewContractLabel(arg.entityId)))"
                                 OnCommentsClicked="@(arg => ManageComments.OpenCommentsDialogAsync(arg, CrewContractLabel(arg.entityId)))" />
        </MudPaper>
    }
    else if (!_loading)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            Crew contract @Id was not found. <MudLink Href="/crew-contracts">Back to crew contracts</MudLink>
        </MudAlert>
    }
}
else if (!_loading)
{
    <SharedCrewContractsPage Contracts="@_contracts"
                             ExpiringContracts="@_expiring"
                             Vessels="@_vessels"
                             OnAddClicked="OpenAddDialog"
                             OnEditClicked="OpenEditDialog"
                             OnDeleteClicked="ConfirmDelete"
                             OnSignOffClicked="OpenSignOffDialog"
                             OnManageAttachedFilesClicked="@(arg => ManageStoredFiles.OpenManageStoredFilesDialogAsync(arg, CrewContractLabel(arg.entityId)))"
                             OnCommentsClicked="@(arg => ManageComments.OpenCommentsDialogAsync(arg, CrewContractLabel(arg.entityId)))" />
}

@code {
    private IReadOnlyList<CrewContractResponse> _contracts = [];
    private IReadOnlyList<CrewContractResponse> _expiring  = [];
    private IReadOnlyList<VesselResponse>       _vessels   = [];
    private IReadOnlyList<PersonResponse>       _persons   = [];
    private IReadOnlyList<RankResponse>         _ranks     = [];
    private IReadOnlyList<PortResponse>         _ports     = [];
    private bool _loading = true;
    [Parameter] public int? Id { get; set; }
    private CrewContractResponse? _contract;
    private bool _initialized;
    private int? _shownId;

    // Same component for /crew-contracts and /crew-contracts/{id}: reload only when the route changes.
    protected override async Task OnParametersSetAsync()
    {
        if (_initialized && _shownId == Id) return;
        _initialized = true;
        _shownId = Id;

        if (Id is null) _contract = null;
        await LoadAsync();
    }

    // A missing (or just deleted) contract is null, not an error.
    private async Task<CrewContractResponse?> LoadContractAsync(int id)
    {
        try { return await CrewContractService.GetByIdAsync(id); }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound) { return null; }
    }

    // ─── Load ──────────────────────────────────────────────────────────────
    string? CrewContractLabel(int id)
    {
        var c = _contract?.ContractId == id ? _contract : _contracts.Concat(_expiring).FirstOrDefault(x => x.ContractId == id);
        return c is null ? null : $"Crew Contract — {c.PersonFullName} · {c.RankName} · {c.VesselName}";
    }
    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var t1 = CrewContractService.GetAllAsync();
            var t2 = CrewContractService.GetAboutExpireAsync();
            var t3 = VesselService.GetActiveAsync();
            var t4 = PersonService.GetActiveAsync();
            var t5 = RankService.GetActiveAsync();
            var t6 = PortService.GetAllAsync();

            await Task.WhenAll(t1, t2, t3, t4, t5, t6);

            _contracts = t1.Result;
            _expiring  = t2.Result;
            _vessels   = t3.Result;
            _persons   = t4.Result;
            _ranks     = t5.Result;
            _ports     = t6.Result;

            if (Id is int id)
                _contract = await LoadContractAsync(id);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // ─── Dialogs ───────────────────────────────────────────────────────────

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters
        {
            [nameof(CrewContractFormDialog.Persons)] = _persons,
            [nameof(CrewContractFormDialog.Vessels)] = _vessels,
            [nameof(CrewContractFormDialog.Ranks)] = _ranks,
            [nameof(CrewContractFormDialog.Ports)] = _ports,
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CrewContractFormDialog>("New Contract", parameters, options);
        var result  = await dialog.Result;
        if (result is null || result.Canceled) return;

        var req = (CreateCrewContractRequest)result.Data!;
        try
        {
            await CrewContractService.CreateAsync(
                req.DurationInMonth,
                req.PersonId,
                req.VesselId,
                req.RankId,
                req.MonthlyWage,
                req.SignOnDate,
                req.SignOnPort,
                req.Notes);

            Snackbar.Add("Contract created.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenEditDialog(CrewContractResponse contract)
    {
        var parameters = new DialogParameters
        {
            [nameof(CrewContractFormDialog.Contract)] = contract,
            [nameof(CrewContractFormDialog.Persons)] = _persons,
            [nameof(CrewContractFormDialog.Vessels)] = _vessels,
            [nameof(CrewContractFormDialog.Ranks)] = _ranks,
            [nameof(CrewContractFormDialog.Ports)] = _ports,
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CrewContractFormDialog>("Edit Contract", parameters, options);
        var result  = await dialog.Result;
        if (result is null || result.Canceled) return;

        var req     = (UpdateCrewContractRequest)result.Data!;
        var outcome = await CrewContractService.UpdateAsync(
            req.Id,
            req.DurationInMonth,
            req.PersonId,
            req.VesselId,
            req.RankId,
            req.MonthlyWage,
            req.SignOnDate,
            req.SignOnPort,
            req.Notes);

        if (outcome.IsSuccess)
        {
            Snackbar.Add("Contract updated.", Severity.Success);
            await LoadAsync();
        }
        else
            Snackbar.Add(outcome.Error!, Severity.Error);
    }

    private async Task OpenSignOffDialog(CrewContractResponse contract)
    {
        var parameters = new DialogParameters
        {
            [nameof(SignOffDialog.Contract)] = contract,
            [nameof(SignOffDialog.Ports)]    = _ports,
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog  = await DialogService.ShowAsync<SignOffDialog>("Sign Off", parameters, options);
        var result  = await dialog.Result;
        if (result is null || result.Canceled) return;

        var req     = (SignOffCrewContractRequest)result.Data!;
        var outcome = await CrewContractService.SignOffAsync(
            contract.ContractId,
            req.SignOffDate,
            req.SignOffPort);

        if (outcome.IsSuccess)
        {
            Snackbar.Add("Signed off successfully.", Severity.Success);
            await LoadAsync();
        }
        else
            Snackbar.Add(outcome.Error!, Severity.Error);
    }

    // ─── Delete ────────────────────────────────────────────────────────────

    private async Task ConfirmDelete(CrewContractResponse contract)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Contract",
            $"Delete contract for '{contract.PersonFullName}'? This action cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true) return;

        var outcome = await CrewContractService.DeleteAsync(contract.ContractId);
        if (outcome.IsSuccess)
        {
            Snackbar.Add("Contract deleted.", Severity.Success);
            if (Id is not null) { Nav.NavigateTo("/crew-contracts"); return; }
            await LoadAsync();
        }
        else
            Snackbar.Add(outcome.Error!, Severity.Error);
    }
}