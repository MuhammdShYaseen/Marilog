@attribute [RequirePage(EntityType.VesselCertificate)]
@page "/vessel-certificates"
@using Marilog.Kernel.Enums
@using MudBlazor
@inject NavigationManager Navigation

<MudPaper Class="pa-4" Elevation="0">
    <MudText Typo="Typo.h5" Class="mb-2">Vessel Certificates</MudText>

    <VesselCertificatesPanel OnVesselClicked="OpenVessel" />
</MudPaper>

@code {
    private void OpenVessel(int vesselId) => Navigation.NavigateTo($"/vessels/{vesselId}");
}