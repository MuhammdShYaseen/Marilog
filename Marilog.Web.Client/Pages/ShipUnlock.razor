@attribute [Authorize(Roles = CookieAuthStateProvider.SuperAdminRole)]
@page "/admin/ship-unlock"
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Contracts.Interfaces.Services.SystemServices
@using Marilog.Shared.UI.Pages.ShipUnlock
@inject IShipUnlockService ShipUnlockService
@inject IVesselService VesselService
@inject ISnackbar Snackbar

<SharedShipUnlockPage Vessels="@_vessels"
                      ShipKey="@_shipKey"
                      UnlockCode="@_unlockCode"
                      Busy="@_busy"
                      OnShowKeyClicked="ShowKeyAsync"
                      OnGetCodeClicked="GetCodeAsync" />

@code {
    private IReadOnlyList<VesselResponse> _vessels = [];
    private string? _shipKey;
    private string? _unlockCode;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _vessels = await VesselService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ShowKeyAsync(string imo)
    {
        _busy = true;
        try
        {
            _shipKey = await ShipUnlockService.GetShipKeyAsync(imo);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task GetCodeAsync((string Imo, string RequestCode) args)
    {
        _busy = true;
        _unlockCode = null;
        try
        {
            _unlockCode = await ShipUnlockService.GetUnlockCodeAsync(args.Imo, args.RequestCode);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}