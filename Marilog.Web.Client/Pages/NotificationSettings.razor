@attribute [Authorize(Roles = CookieAuthStateProvider.SuperAdminRole)]
@page "/admin/notifications"
@using Marilog.Contracts.DTOs.EmailNotificationDTOs
@using Marilog.Contracts.Interfaces.Services.EmailNotificationConfig
@using Marilog.Shared.UI.Pages.EmailNotification
@using MudBlazor
@inject INotificationSenderEmailSettingsStore SenderStore
@inject INotificationSchedule ScheduleStore
@inject ISnackbar Snackbar

<SharedNotificationSettingsPage IsLoading="_isLoading"
                                
                                 SenderSettings="_senderSettings"
                                 IsSenderDirty="_isSenderDirty"
                                 IsSavingSender="_isSavingSender"
                                 OnSenderChanged="@(() => _isSenderDirty = true)"
                                 OnSaveSender="SaveSenderAsync"
                                
                                 ScheduleSettings="_scheduleSettings"
                                 IsScheduleDirty="_isScheduleDirty"
                                 IsSavingSchedule="_isSavingSchedule"
                                 OnScheduleChanged="@(() => _isScheduleDirty = true)"
                                 OnSaveSchedule="SaveScheduleAsync" />

@code {
    private bool _isLoading = true;



    private NotificationSenderEmailSettingsOptions _senderSettings = new();
    private bool _isSenderDirty;
    private bool _isSavingSender;

    private NotificationScheduleOptions _scheduleSettings = new();
    private bool _isScheduleDirty;
    private bool _isSavingSchedule;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;


        _senderSettings = await SenderStore.GetAsync();

        _scheduleSettings = await ScheduleStore.GetAsync();

        _isLoading = false;
    }

    private async Task SaveSenderAsync(NotificationSenderEmailSettingsOptions settings)
    {
        _isSavingSender = true;
        StateHasChanged();

        try
        {
            await SenderStore.UpdateAsync(settings);
            _isSenderDirty = false;
            Snackbar.Add("Sender email settings saved.", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to save sender email settings.", Severity.Error);
        }
        finally
        {
            _isSavingSender = false;
            StateHasChanged();
        }
    }

    

    private async Task SaveScheduleAsync(NotificationScheduleOptions settings)
    {
        _isSavingSchedule = true;
        StateHasChanged();

        try
        {
            await ScheduleStore.SaveAsync(settings);
            _isScheduleDirty = false;
            Snackbar.Add("Schedule settings saved.", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to save schedule settings.", Severity.Error);
        }
        finally
        {
            _isSavingSchedule = false;
            StateHasChanged();
        }
    }
}
