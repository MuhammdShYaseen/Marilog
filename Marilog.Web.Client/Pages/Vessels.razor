@* VesselsPageHost.razor *@
@page "/vessels"
@page "/vessels/{Id:int}"
@using Marilog.Contracts.DTOs.Requests.VesselDTOs
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Contracts.Interfaces.Services.SystemServices
@using Marilog.Shared.UI.Pages.Vessels
@using Marilog.Web.Client.Services.Interfaces
@using MudBlazor
@inject IManageComments ManageComments
@inject IVesselService  VesselService
@inject ICompanyService CompanyService
@inject ICountryService CountryService
@inject ISnackbar       Snackbar
@inject IDialogService  DialogService
@inject IManageStoredFiles ManageStoredFiles
@inject IVesselTypeService VesselTypeService
@inject NavigationManager Nav
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}

@if (_initialized && Id is not null)
{
    @if (_vessel is null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            Vessel @Id was not found. <MudLink Href="/vessels">Back to vessels</MudLink>
        </MudAlert>
    }
    else
    {
        <MudPaper Outlined="true" Elevation="0">
            <VesselDetailsView Vessel="_vessel"
                               OnCloseClicked="@(() => Nav.NavigateTo("/vessels"))"
                               OnEditClicked="OpenEditDialog"
                               OnDeleteClicked="ConfirmDelete"
                               OnToggleActiveClicked="ToggleActive"
                               OnManageAttachedFilesClicked="@(arg => ManageStoredFiles.OpenManageStoredFilesDialogAsync(arg, VesselLabel(arg.entityId)))"
                               OnCommentsClicked="@(arg => ManageComments.OpenCommentsDialogAsync(arg, VesselLabel(arg.entityId)))"
                               CertificatesContent="CertificatesFragment"
                               PositionContent="PositionFragment"
                               WeatherContent="WeatherFragment" />
        </MudPaper>
    }
}
else if (_initialized)
{
    <SharedVesselPage Vessels="@_vessels"
                      OnAddClicked="OpenAddDialog"
                      OnEditClicked="OpenEditDialog"
                      OnDeleteClicked="ConfirmDelete"
                      OnToggleActiveClicked="ToggleActive"
                      OnManageAttachedFilesClicked="@(arg => ManageStoredFiles.OpenManageStoredFilesDialogAsync(arg, VesselLabel(arg.entityId)))"
                      OnCommentsClicked="@(arg => ManageComments.OpenCommentsDialogAsync(arg, VesselLabel(arg.entityId)))"
                      CertificatesContent="CertificatesFragment"
                      PositionContent="PositionFragment"
                      WeatherContent="WeatherFragment" />
}

@code {
    [Parameter] public int? Id { get; set; }
    private IReadOnlyList<VesselResponse> _vessels = [];
    private VesselResponse? _vessel;
    private IReadOnlyList<CompanyResponse> _companies = [];
    private IReadOnlyList<CountryResponse> _countries = [];
    private IReadOnlyList<VesselTypeResponse> _vesselTypes = [];
    private bool _loading = true;
    private bool _initialized;
    private int? _shownId;

    // Same component for /vessels and /vessels/{id}: reload only when the route changes.
    protected override async Task OnParametersSetAsync()
    {
        if (_initialized && _shownId == Id) return;
        _shownId = Id;
        await LoadAsync();
    }

    // Shared by the list drawer and the details page.
    private RenderFragment<VesselResponse> CertificatesFragment => vessel => @<VesselCertificatesPanel VesselId="vessel.Id" OnChanged="LoadAsync" />;
    private RenderFragment<VesselResponse> PositionFragment => vessel => @<VesselPositionPanel Vessel="vessel" />;
    private RenderFragment<VesselResponse> WeatherFragment => vessel => @<VesselWeatherPanel Vessel="vessel" />;
    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var t2 = CompanyService.GetActiveAsync();
            var t3 = CountryService.GetAllAsync();
            var t4 = VesselTypeService.GetAllAsync();

            if (Id is int id)
                _vessel = await VesselService.GetByIdAsync(id);
            else
                _vessels = await VesselService.GetAllAsync();

            await Task.WhenAll(t2, t3, t4);

            _companies = t2.Result;
            _countries = t3.Result;
            _vesselTypes = t4.Result;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
            _initialized = true;
        }
    }
    private string? VesselLabel(int id)
    {
        var v = _vessel?.Id == id ? _vessel : _vessels.FirstOrDefault(x => x.Id == id);
        if (v is null) return null;

        return string.IsNullOrWhiteSpace(v.IMONumber)
            ? $"Vessel : {v.Name}"
            : $"Vessel : {v.Name} · IMO {v.IMONumber}";
    }
    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters
        {
            [nameof(VesselDialog.Companies)] = _companies,
            [nameof(VesselDialog.Countries)] = _countries,
            [nameof(VesselDialog.VesselTypes)] = _vesselTypes,
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog  = await DialogService.ShowAsync<VesselDialog>("New Vessel", parameters, options);
        var result  = await dialog.Result;
        if (result is null || result.Canceled) return;

        var req = (CreateVesselRequest)result.Data!;
        try
        {
            await VesselService.CreateAsync(
                req.CompanyId,
                req.VesselName,
                req.ImoNumber,
                req.GrossTonnage,
                req.FlagCountryId,
                req.Notes,
                req.VesselTypeId);

            Snackbar.Add("Vessel created.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenEditDialog(VesselResponse vessel)
    {
        var parameters = new DialogParameters
        {
            [nameof(VesselDialog.Vessel)]    = vessel,
            [nameof(VesselDialog.Companies)] = _companies,
            [nameof(VesselDialog.Countries)] = _countries,
            [nameof(VesselDialog.VesselTypes)] = _vesselTypes,
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog  = await DialogService.ShowAsync<VesselDialog>("Edit Vessel", parameters, options);
        var result  = await dialog.Result;
        if (result is null || result.Canceled) return;

        var req = (UpdateVesselRequest)result.Data!;
        try
        {
            await VesselService.UpdateAsync(
                vessel.Id,
                req.VesselName,
                req.ImoNumber,
                req.GrossTonnage,
                req.FlagCountryId,
                 req.Notes,
                req.VesselTypeId);

            Snackbar.Add("Vessel updated.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ToggleActive(VesselResponse vessel)
    {
        try
        {
            if (vessel.IsActive)
                await VesselService.DeactivateAsync(vessel.Id);
            else
                await VesselService.ActivateAsync(vessel.Id);

            Snackbar.Add(vessel.IsActive ? "Vessel deactivated." : "Vessel activated.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ConfirmDelete(VesselResponse vessel)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Vessel",
            $"Delete '{vessel.Name}'? This action cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true) return;

        try
        {
            await VesselService.DeleteAsync(vessel.Id);
            Snackbar.Add("Vessel deleted.", Severity.Success);
            if (Id is not null) Nav.NavigateTo("/vessels");
            else await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    
}