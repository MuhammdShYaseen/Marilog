@attribute [RequirePage(EntityType.InboxEntry)]
@page "/inbox-entry"
@page "/inbox-entry/{Id:int}"
@using Marilog.Contracts.Common
@using Marilog.Contracts.DTOs.Reports.InboxEntryReport
@using Marilog.Contracts.DTOs.Requests.DocumentDTOs
@using Marilog.Contracts.DTOs.Requests.InboxEntryDTOs
@using Marilog.Contracts.Interfaces.Services.SystemServices
@using Marilog.Kernel.Enums
@using Marilog.Shared.UI.Pages.Inbox
@using Marilog.Web.Client.Services.Interfaces
@using MudBlazor
@inject IManageComments ManageComments
@inject IInboxService InboxService
@inject IVesselService VesselService
@inject IDialogService DialogService
@inject IManageStoredFiles ManageStoredFiles
@inject ISnackbar Snackbar
@inject IRecordCreator RecordCreator
@inject NavigationManager Nav
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}

@if (Id is not null)
{
    @if (_entry is not null)
    {
        <MudPaper Outlined="true" Elevation="0">
            <InboxEntryDetails Entry="_entry"
                               VesselNames="_vesselNames"
                               OnClose="@(() => Nav.NavigateTo("/inbox-entry"))"
                               OnEditClicked="OpenEditDialog"
                               OnManageAttachedFilesClicked="@(arg => ManageStoredFiles.OpenManageStoredFilesDialogAsync(arg, InboxLabel(arg.entityId)))"
                               OnCommentsClicked="@(arg => ManageComments.OpenCommentsDialogAsync(arg, InboxLabel(arg.entityId)))"
                               OnProcessedClicked="MarkProcessed"
                               OnCancelClicked="ConfirmCancel"
                               OnDeleteClicked="ConfirmDelete"
                               OnCreateFromClicked="CreateFrom"
                               OnAddLinkClicked="OpenLinkDialog"
                               OnUnlinkClicked="ConfirmUnlink"
                               OnOpenEntryClicked="OpenEntry" />
        </MudPaper>
    }
    else if (!_loading)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            Inbox entry @Id was not found. <MudLink Href="/inbox-entry">Back to inbox</MudLink>
        </MudAlert>
    }
}
else
{
    <SharedInboxPage @ref="_sharedPage"
                     Result="_result"
                     VesselNames="_vesselNames"
                     OnLoadRequested="LoadAsync"
                     OnCreate="CreateAsync"
                     OnEditClicked="OpenEditDialog"
                     OnManageAttachedFilesClicked="@(arg => ManageStoredFiles.OpenManageStoredFilesDialogAsync(arg, InboxLabel(arg.entityId)))"
                     OnCommentsClicked="@(arg => ManageComments.OpenCommentsDialogAsync(arg, InboxLabel(arg.entityId)))"
                     OnProcessedClicked="MarkProcessed"
                     OnCancelClicked="ConfirmCancel"
                     OnDeleteClicked="ConfirmDelete"
                     OnCreateFromClicked="CreateFrom"
                     OnAddLinkClicked="OpenLinkDialog"
                     OnUnlinkClicked="ConfirmUnlink"
                     OnOpenEntryClicked="OpenEntry" />
}
@code {
    private PagedResponse<InboxEntryResponse> _result = new();
    private IReadOnlyDictionary<int, string> _vesselNames = new Dictionary<int, string>();
    private InboxEntryFilter _filter = new();
    private bool _loading = true;
    private SharedInboxPage _sharedPage = default!;
    private string? _selectedNumber;
    [Parameter] public int? Id { get; set; }
    private InboxEntryResponse? _entry;
    private bool _initialized;
    private int? _shownId;

    string? InboxLabel(int id)
    {
        var x = _entry?.Id == id ? _entry : _result.Items.FirstOrDefault(e => e.Id == id);
        if (x is null) return null;

        var desc = x.Description.Length > 60 ? x.Description[..60] + "…" : x.Description;
        return $"Inbox {x.Number} — {desc}";
    }

    private async Task RefreshAsync(int id)
    {
        if (Id is not null) { _entry = await LoadEntryAsync(id); return; }
        await LoadAsync(_filter);
        var fresh = await InboxService.GetByIdAsync(id, default);
        _selectedNumber = fresh?.Number;
        _sharedPage.UpdateSelected(fresh);
    }

    private async Task OpenEntry(int id)
    {
        if (Id is not null) { Nav.NavigateTo($"/inbox-entry/{id}"); return; }
        var entry = await InboxService.GetByIdAsync(id, default);
        if (entry is null)
        {
            Snackbar.Add("Entry not found.", Severity.Warning);
            return;
        }
        _selectedNumber = entry.Number;
        _sharedPage.UpdateSelected(entry);
    }

    private async Task MarkProcessed(InboxEntryResponse entry)
    {
        await InboxService.MarkProcessedAsync(entry.Id);
        Snackbar.Add($"{entry.Number} marked as processed.", Severity.Success);
        await RefreshAsync(entry.Id);
    }

    private async Task ConfirmCancel(InboxEntryResponse entry)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Cancel Entry",
            $"Cancel '{entry.Number}'? The number stays reserved and won't be reused.",
            yesText: "Cancel entry",
            cancelText: "Back");
        if (confirmed != true) return;

        await InboxService.CancelAsync(entry.Id);
        Snackbar.Add($"{entry.Number} cancelled.", Severity.Warning);
        await RefreshAsync(entry.Id);
    }

    private async Task ConfirmDelete(InboxEntryResponse entry)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Entry",
            $"Delete '{entry.Number}' permanently? The number becomes free and can be used again. " +
            "If this number was already written anywhere, use Cancel instead.",
            yesText: "Delete",
            cancelText: "Back");
        if (confirmed != true) return;

        await InboxService.DeleteAsync(entry.Id);
        Snackbar.Add($"{entry.Number} deleted.", Severity.Success);
        if (Id is not null) { Nav.NavigateTo("/inbox-entry"); return; }
        _sharedPage.UpdateSelected(null);
        await LoadAsync(_filter);
    }

    private async Task OpenLinkDialog(InboxEntryResponse entry)
    {
        // The entry itself is excluded from inbox results.
        Func<EntityType, string?, Task<List<LinkCandidateResponse>>> search = async (type, term) =>
            (await InboxService.SearchLinkCandidatesAsync(type, term))
                .Where(x => !(type == EntityType.InboxEntry && x.Id == entry.Id))
                .ToList();

        var parameters = new DialogParameters { ["Search"] = search };
        var dialog = await DialogService.ShowAsync<LinkRecordDialog>($"Link {entry.Number} to", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        var (type, entityId) = ((EntityType, int))result.Data!;
        await InboxService.LinkAsync(entry.Id, type, entityId);

        Snackbar.Add($"{entry.Number} linked.", Severity.Success);
        await RefreshAsync(entry.Id);
    }

    private async Task ConfirmUnlink((InboxEntryResponse entry, InboxEntryLinkResponse link) args)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Unlink",
            $"Remove the link to {args.link.Label ?? $"{args.link.EntityType} #{args.link.EntityId}"}?",
            yesText: "Unlink",
            cancelText: "Back");
        if (confirmed != true) return;

        await InboxService.UnlinkAsync(args.link.Id);
        Snackbar.Add("Link removed.", Severity.Success);
        await RefreshAsync(args.entry.Id);
    }

    // Same component for /inbox-entry and /inbox-entry/{id}: reload only when the route changes.
    protected override async Task OnParametersSetAsync()
    {
        if (_initialized && _shownId == Id) return;
        _shownId = Id;

        if (!_initialized)
        {
            _initialized = true;
            var vessels = await VesselService.GetAllAsLookUpAsync();
            _vesselNames = vessels.ToDictionary(v => v.Id, v => v.Name);
        }

        if (Id is int id)
            _entry = await LoadEntryAsync(id);
        else
            await LoadAsync(_filter);
    }

    // A missing (or just deleted) entry is null, not an error.
    private async Task<InboxEntryResponse?> LoadEntryAsync(int id)
    {
        _loading = true;
        try { return await InboxService.GetByIdAsync(id, default); }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound) { return null; }
        finally { _loading = false; }
    }

    private async Task LoadAsync(InboxEntryFilter filter)
    {
        _loading = true;
        _filter = filter;
        _result = await InboxService.GetFilteredAsync(filter);
        _loading = false;
    }

    private async Task<string?> CreateAsync(CreateInboxEntryRequest request)
    {
        var number = await InboxService.CreateAsync(
            request.ReceivedDate, request.Source, request.VesselIds ?? [], request.Description, request.StartSequence);

        Snackbar.Add($"{number} registered.", Severity.Success);
        await LoadAsync(_filter);
        return number;
    }

    private async Task OpenEditDialog(InboxEntryResponse entry)
    {
        var parameters = new DialogParameters
        {
            ["Entry"] = entry,
            ["VesselNames"] = _vesselNames
        };
        var dialog = await DialogService.ShowAsync<InboxEntryFormDialog>($"Edit {entry.Number}", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        var request = (UpdateInboxEntryRequest)result.Data!;
        await InboxService.UpdateAsync(entry.Id, request.ReceivedDate, request.Source, request.VesselIds ?? [], request.Description);

        Snackbar.Add($"{entry.Number} updated.", Severity.Success);
        await RefreshAsync(entry.Id);
    }

    private async Task CreateFrom((InboxEntryResponse entry, EntityType type) args)
    {
        switch (args.type)
        {
            case EntityType.Document:
                await CreateDocumentFrom(args.entry);
                break;
        }
    }

    private async Task CreateDocumentFrom(InboxEntryResponse entry)
    {
        var prefill = new CreateDocumentRequest
        {
            DocDate = entry.ReceivedDate,
            Reference = entry.Number,
            VesselId = entry.VesselIds is { Count: 1 } ? entry.VesselIds[0] : (int?)null
        };

        var id = await RecordCreator.CreateDocumentAsync(prefill);
        if (id is null) return;

        await LinkCreated(entry, EntityType.Document, id.Value);
    }

    private async Task LinkCreated(InboxEntryResponse entry, EntityType type, int entityId)
    {
        try
        {
            await InboxService.LinkAsync(entry.Id, type, entityId);
            Snackbar.Add($"{InboxTypeNames.Of(type)} created and linked to {entry.Number}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{InboxTypeNames.Of(type)} created, but linking to {entry.Number} failed: {ex.Message}", Severity.Warning);
        }

        await RefreshAsync(entry.Id);
    }
}