@page "/emails/outbox"

@using Marilog.Contracts.Common
@using Marilog.Contracts.DTOs.Requests.EmailDTOs
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Contracts.Interfaces.Services.EmailServices
@using Marilog.Contracts.Interfaces.Services.SystemServices
@using Marilog.Kernel.Enums
@using Marilog.Shared.UI.Components.ManagingStoredFiles
@using Marilog.Shared.UI.Pages.EmailInbox
@using Marilog.Shared.UI.Pages.Outbox
@using MudBlazor
@inject IEmailService EmailService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject HttpClient Http

@* ASSUMPTION: attachments reuse the same StoredFile client service used on the Documents page.
   Adjust the injected type name below if yours differs (e.g. IStoredFileService). *@
@inject IStoredFileService StoredFileService

<SharedEmailOutboxPage Items="_emails"
                        IsLoading="_isLoading"
                        CurrentPage="_page"
                        PageCount="_pageCount"
                        SearchTerm="_searchTerm"
                        SelectedEmail="_selectedEmail"
                        OnSelect="SelectEmail"
                        OnCloseDetail="@(() => _selectedEmail = null)"
                        OnPageChanged="ChangePageAsync"
                        OnSearchChanged="SearchAsync"
                        OnReply="OpenReplyDialogAsync"
                        OnManageAttachments="OpenAttachmentsDialogAsync"
                        OnDelete="DeleteAsync"
                        OnRetry="RetryAsync" />

@code {
    private IReadOnlyList<EmailResponse> _emails = Array.Empty<EmailResponse>();
    private bool _isLoading;
    private int _page = 1;
    private const int PageSize = 20;
    private int _pageCount = 1;
    private string? _searchTerm;
    private EmailResponse? _selectedEmail;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;
        StateHasChanged();

        var result = await EmailService.GetOutboxAsync(new PagedRequest
        {
            Page = _page,
            PageSize = PageSize,
            SearchTerm = _searchTerm
        });

        _emails = result.Items;
        _pageCount = Math.Max(1, (int)Math.Ceiling(result.TotalCount / (double)PageSize));

        _isLoading = false;
        StateHasChanged();
    }

    private void SelectEmail(EmailResponse email)
    {
        _selectedEmail = email;
    }

    private async Task ChangePageAsync(int page)
    {
        _page = page;
        await ReloadAsync();
    }

    private async Task SearchAsync(string term)
    {
        _searchTerm = term;
        _page = 1;
        await ReloadAsync();
    }

    private async Task RetryAsync(EmailResponse email)
    {
        try
        {
            await EmailService.RetryAsync(email.Id);
            Snackbar.Add("Retrying...", Severity.Info);
            await ReloadAsync();
        }
        catch (Exception)
        {
            Snackbar.Add("Retry failed to start.", Severity.Error);
        }
    }

    private async Task OpenReplyDialogAsync(EmailResponse email)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var parameters = new DialogParameters<EmailReplyDialog>
        {
            { x => x.OriginalEmail, email }
        };

        var dialog = await DialogService.ShowAsync<EmailReplyDialog>("Reply", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
            return;


        var request = (CreateEmailRequest)result.Data!;



        try
        {
            var created = await EmailService.CreateAsync(request);
            await EmailService.SendEmailAsync(created.Id);
            Snackbar.Add("Reply sent.", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to send reply.", Severity.Error);
        }
    }

    private async Task OpenAttachmentsDialogAsync(EmailResponse email)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };

        var parameters = new DialogParameters<ManageStoredFilesDialog>
        {
            { x => x.LoadFilesFunc, ct => StoredFileService.GetByEntityIdAsync(email.Id, EntityType.Email, ct) },
            { x => x.DeleteFileFunc, (id, ct) => StoredFileService.DeleteAsync(id, ct) },
            { x => x.AddTagFunc, (id, name, color, ct) => StoredFileService.AddTagAsync(id, name, color, ct) },
            { x => x.RemoveTagFunc, (id, tagId, ct) => StoredFileService.RemoveTagAsync(id, tagId, ct) },
            { x => x.BuildDownloadUrl, file => $"{Http.BaseAddress}api/StoredFiles/{file.Id}/stream" },
            { x => x.BuildThumbnailUrl, file => $"{Http.BaseAddress}api/StoredFiles/{file.Id}/thumbnail" },
            { x => x.UploadFilesFunc, async (files, ct) =>
                {
                    var requests = files.Select(f => new Marilog.Contracts.DTOs.Requests.StoregFileDTOs.UploadFileRequest
                    {
                        ContentType = f.ContentType,
                        EntityId = email.Id,
                        EntityType = EntityType.Email,
                        FileName = f.Name,
                        FileStream = f.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024),
                        Size = f.Size
                    });

                    var outcome = await StoredFileService.UploadAsync(requests, ct);
                    return outcome.Count > 0;
                }
            }
        };

        await DialogService.ShowAsync<ManageStoredFilesDialog>("Attachments", parameters, options);
    }

    private async Task DeleteAsync(EmailResponse email)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            $"Are you sure you want to delete \"{email.Subject}\"?",
            yesText: "Delete",
            cancelText: "Cancel",
            options: new DialogOptions { CloseButton = true });

        if (confirmed != true)
            return;

        try
        {
            await EmailService.DeleteAsync(email.Id);

            if (_selectedEmail?.Id == email.Id)
                _selectedEmail = null;

            Snackbar.Add("Message deleted.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to delete message.", Severity.Error);
        }
    }
}
