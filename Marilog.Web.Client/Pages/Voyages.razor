@page "/voyages"
@using Marilog.Contracts.DTOs.Requests.VoyageDTOs
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Contracts.Interfaces.Services.SystemServices
@using Marilog.Kernel.Enums
@using Marilog.Shared.UI.Pages.Voyages
@* VoyagePageHost.razor *@
@inject IVoyageService VoyageService
@inject IVesselService VesselService
@inject IPortService PortService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<VoyageListPage Voyages="_filtered"
                Vessels="_vessels"
                StatusCounts="_statusCounts"
                ScopeCount="_scopeCount"
                Filter="_filter"
                IsLoading="_loading"
                OnFilterChanged="OnFilterChanged"
                OnAddClicked="OpenCreateDialog"
                OnRefreshClicked="ReloadAsync"
                OnOpenClicked="OpenVoyage"
                OnEditClicked="OpenEditDialog"
                OnDeleteClicked="ConfirmDelete" />

@code {
    private static readonly DialogOptions FormDialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseOnEscapeKey = true,
        BackdropClick = false
    };

    private IReadOnlyList<VoyageResponse> _all = [];
    private IReadOnlyList<VoyageResponse> _filtered = [];
    private IReadOnlyList<VesselResponse> _vessels = [];
    private IReadOnlyDictionary<VoyageStatus, int> _statusCounts = new Dictionary<VoyageStatus, int>();
    private int _scopeCount;
    private VoyageListFilter _filter = new();
    private bool _loading;

    // ── Load ──────────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        await TryAsync(async () =>
        {
            var voyagesTask = VoyageService.GetActiveVoyagesAsync();
            var vesselsTask = VesselService.GetActiveAsync();
            await Task.WhenAll(voyagesTask, vesselsTask);
            _all = await voyagesTask;
            _vessels = await vesselsTask;
        });
        ApplyFilter();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        await TryAsync(async () => _all = await VoyageService.GetActiveVoyagesAsync());
        ApplyFilter();
        _loading = false;
    }

    // ── Filtering ─────────────────────────────────────────────────────────────
    private void OnFilterChanged(VoyageListFilter filter)
    {
        _filter = filter;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        IEnumerable<VoyageResponse> scope = _all;

        if (_filter.VesselId is int vesselId)
            scope = scope.Where(v => v.VesselId == vesselId);

        if (_filter.Month is DateOnly month)
            scope = scope.Where(v => v.VoyageMonth.Year == month.Year && v.VoyageMonth.Month == month.Month);

        if (!string.IsNullOrWhiteSpace(_filter.Search))
        {
            var term = _filter.Search.Trim();
            scope = scope.Where(v => Matches(v, term));
        }

        // Status counts are computed before the status filter so every pill shows its real count.
        var scoped = scope.ToList();
        _scopeCount = scoped.Count;
        _statusCounts = scoped.GroupBy(v => v.Status).ToDictionary(g => g.Key, g => g.Count());

        _filtered = (_filter.Status is VoyageStatus status ? scoped.Where(v => v.Status == status) : scoped)
            .OrderByDescending(v => v.VoyageMonth)
            .ThenBy(v => v.VoyageNumber)
            .ToList();
    }

    private static bool Matches(VoyageResponse v, string term) =>
        Contains(v.VoyageNumber, term) ||
        Contains(v.VesselName, term) ||
        Contains(v.DeparturePortName, term) ||
        Contains(v.ArrivalPortName, term) ||
        Contains(v.MasterFullName, term) ||
        Contains(v.CargoType, term);

    private static bool Contains(string? source, string term)
        => source?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;

    // ── Navigation ────────────────────────────────────────────────────────────
    private void OpenVoyage(VoyageResponse voyage)
        => Nav.NavigateTo($"/voyages/{voyage.VoyageId}");

    // ── Create / Edit ─────────────────────────────────────────────────────────
    private async Task OpenCreateDialog()
    {
        IReadOnlyList<PortResponse> ports = [];
        if (!await TryAsync(async () => ports = await PortService.GetActiveAsync())) return;

        var parameters = new DialogParameters
        {
            [nameof(VoyageDialog.Vessels)] = _vessels,
            [nameof(VoyageDialog.Ports)] = ports,
            [nameof(VoyageDialog.OnCreate)] = new Func<CreateVoyageRequest, Task<bool>>(CreateVoyageAsync)
        };

        var dialog = await DialogService.ShowAsync<VoyageDialog>("New voyage", parameters, FormDialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false }) await ReloadAsync();
    }

    private Task<bool> CreateVoyageAsync(CreateVoyageRequest r) =>
        TryAsync(() => VoyageService.CreateAsync(
            r.VesselId, r.VoyageNumber, r.VoyageMonth,
            masterContractId: r.MasterContractId,
            departurePortId: r.DeparturePortId,
            arrivalPortId: r.ArrivalPortId,
            departureDate: r.DepartureDate,
            arrivalDate: r.ArrivalDate,
            cargoType: r.CargoType,
            cargoQuantityMt: r.CargoQuantityMt,
            notes: r.Notes),
        "Voyage created");

    private async Task OpenEditDialog(VoyageResponse voyage)
    {
        IReadOnlyList<PortResponse> ports = [];
        if (!await TryAsync(async () => ports = await PortService.GetActiveAsync())) return;

        var parameters = new DialogParameters
        {
            [nameof(VoyageDialog.Voyage)] = voyage,
            [nameof(VoyageDialog.Ports)] = ports,
            [nameof(VoyageDialog.OnUpdate)] = new Func<UpdateVoyageRequest, Task<bool>>(r =>
                TryAsync(() => VoyageService.UpdateAsync(
                    voyage.VoyageId,
                    r.DeparturePortId, r.ArrivalPortId,
                    r.DepartureDate, r.ArrivalDate,
                    r.CargoType, r.CargoQuantityMt,
                    r.Notes),
                "Voyage updated"))
        };

        var dialog = await DialogService.ShowAsync<VoyageDialog>("Edit voyage", parameters, FormDialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false }) await ReloadAsync();
    }

    // ── Delete ────────────────────────────────────────────────────────────────
    private async Task ConfirmDelete(VoyageResponse voyage)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete voyage",
            $"Voyage {voyage.VoyageNumber} ({voyage.VesselName}) will be permanently deleted, " +
            "together with its port stops and bills of lading. This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed is not true) return;

        if (await TryAsync(() => VoyageService.DeleteAsync(voyage.VoyageId), "Voyage deleted"))
            await ReloadAsync();
    }

    // ── Error handling ────────────────────────────────────────────────────────
    private async Task<bool> TryAsync(Func<Task> action, string? successMessage = null)
    {
        try
        {
            await action();
            if (successMessage is not null) Snackbar.Add(successMessage, Severity.Success);
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return false;
        }
    }
}