@attribute [RequirePage(EntityType.AContract)]
@page "/contracts"
@using Marilog.Contracts.Common
@using Marilog.Contracts.DTOs.Reports.Contract
@using Marilog.Contracts.DTOs.Requests.ContractDTOs
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Contracts.Interfaces.Services.SystemServices
@using Marilog.Kernel.Enums
@using Marilog.Kernel.Primitives
@using Marilog.Shared.UI.Pages.Contracts
@using Marilog.Web.Client.Services.Interfaces
@using MudBlazor

@inject IContractService ContractService
@inject IContractTypeService ContractTypeService
@inject IContractRoleService ContractRoleService
@inject ICompanyService CompanyService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IManageStoredFiles ManageStoredFiles
@inject IManageComments ManageComments
@inject NavigationManager Navigation

<SharedContractsPage @ref="_sharedPage"
                     Paged="_paged"
                     Report="_report"
                     ContractTypes="_types"
                     IsLoading="_loading"
                     GetContractDetail="GetDetailAsync"
                     ContractTypeId="_typeId"
                     StatusFilter="_status"
                     OnAddClicked="OpenCreateDialogAsync"
                     OnRefreshClicked="ReloadAllAsync"
                     OnSettingsClicked="@(() => Navigation.NavigateTo("/admin/contract-settings"))"
                     OnSearchChanged="OnSearchChangedAsync"
                     OnTypeChanged="OnTypeChangedAsync"
                     OnStatusChanged="OnStatusChangedAsync"
                     OnPrevPage="PrevPageAsync"
                     OnNextPage="NextPageAsync"
                     OnEditClicked="OpenEditDialogAsync"
                     OnDeleteClicked="DeleteAsync"
                     OnActivateClicked="ActivateAsync"
                     OnSuspendClicked="SuspendAsync"
                     OnTerminateClicked="TerminateAsync"
                     OnMarkExpiredClicked="MarkExpiredAsync"
                     OnCharterTermsClicked="@(id => Navigation.NavigateTo($"/operations/laytime/charter-terms/{id}"))"
                     OnManageAttachedFilesClicked="@(arg => ManageStoredFiles.OpenManageStoredFilesDialogAsync(arg, ContractLabel(arg.entityId)))"
                     OnCommentsClicked="@(arg => ManageComments.OpenCommentsDialogAsync(arg, ContractLabel(arg.entityId)))"
                     OnAddPartyClicked="OpenAddPartyDialogAsync"
                     OnRemovePartyClicked="RemovePartyAsync"
                     OnRecordAmendmentClicked="OpenRecordAmendmentDialogAsync"
                     OnChangeExpiryClicked="OpenChangeExpiryDialogAsync" />

@code {
    private const int PageSize = 25;

    private SharedContractsPage _sharedPage = default!;
    private PagedResponse<ContractSummary>? _paged;
    private ContractReport? _report;
    private IReadOnlyList<ContractLookupResponse> _types = [];
    private IReadOnlyList<ContractLookupResponse> _roles = [];
    private IReadOnlyList<CompanyResponse> _companies = [];
    private bool _loading;

    // Filter state
    private int _page = 1;
    private string? _search;
    private int? _typeId;
    private string _status = string.Empty;

    private static readonly DialogOptions Options = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseButton = true
    };

    protected override async Task OnInitializedAsync()
    {
        await TryAsync(async () =>
        {
            _types = await ContractTypeService.GetAllAsync();
            _roles = await ContractRoleService.GetAllAsync();
            _companies = await CompanyService.GetActiveAsync();
        });
        await ReloadAllAsync();
    }

    // ─── Load ──────────────────────────────────────────────────────────────

    private async Task LoadPageAsync()
    {
        _loading = true;
        StateHasChanged();

        await TryAsync(async () =>
        {
            var expiringOnly = _status == SharedContractsPage.ExpiringFilter;

            _paged = await ContractService.GetPagedAsync(new ContractFilter
            {
                Page = _page,
                PageSize = PageSize,
                SearchTerm = _search,
                ContractTypeId = _typeId,
                Status = expiringOnly ? "Active" : (_status.Length == 0 ? null : _status),
                ExpiryDateTo = expiringOnly ? DateOnly.FromDateTime(DateTime.Today.AddDays(30)) : null,
                SortBy = "EffectiveDate",
                Ascending = false
            });
        });

        _loading = false;
    }

    private async Task ReloadAllAsync()
    {
        await TryAsync(async () => _report = await ContractService.GetReportAsync());
        await LoadPageAsync();
        if (_sharedPage is not null)
            await _sharedPage.RefreshSelectedIfOpenAsync();
    }

    private Task<ContractDetailResponse?> GetDetailAsync(int id) => ContractService.GetByIdAsync(id);

    private string? ContractLabel(int id)
    {
        var c = _paged?.Items.FirstOrDefault(x => x.Id == id);
        if (c is null) return null;

        var parties = string.Join(" / ", c.Parties
            .Where(p => !string.IsNullOrWhiteSpace(p.CompanyName))
            .Select(p => p.CompanyName));

        return string.IsNullOrEmpty(parties)
            ? $"{c.Type} {c.ContractNumber}"
            : $"{c.Type} {c.ContractNumber} — {parties}";
    }

    // ─── Filters / paging ────────────────────────────────────────────────

    private async Task OnSearchChangedAsync(string term)
    {
        _search = string.IsNullOrWhiteSpace(term) ? null : term.Trim();
        _page = 1;
        await LoadPageAsync();
    }

    private async Task OnTypeChangedAsync(int? typeId)
    {
        _typeId = typeId;
        _page = 1;
        await LoadPageAsync();
    }

    private async Task OnStatusChangedAsync(string status)
    {
        _status = status;
        _page = 1;
        await LoadPageAsync();
    }

    private async Task PrevPageAsync()
    {
        if (_page > 1) { _page--; await LoadPageAsync(); }
    }

    private async Task NextPageAsync()
    {
        if (_paged?.HasNext == true) { _page++; await LoadPageAsync(); }
    }

    // ─── Create / Edit / Delete ─────────────────────────────────────────

    private async Task OpenCreateDialogAsync()
    {
        var parameters = new DialogParameters<ContractFormDialog> { { x => x.ContractTypes, _types } };
        var dialog = await DialogService.ShowAsync<ContractFormDialog>("New contract", parameters, Options);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: CreateContractRequest r }) return;

        await RunAsync(() => ContractService.CreateAsync(r.ContractNumber, r.ContractTypeId, r.EffectiveDate, r.ExpiryDate, r.Notes),
            "Contract created.");
    }

    private async Task OpenEditDialogAsync(int id)
    {
        var contract = await ContractService.GetByIdAsync(id);
        if (contract is null) return;

        var parameters = new DialogParameters<ContractFormDialog>
        {
            { x => x.ContractTypes, _types },
            { x => x.Existing, contract }
        };
        var dialog = await DialogService.ShowAsync<ContractFormDialog>($"Edit contract — {contract.ContractNumber}", parameters, Options);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: CreateContractRequest r }) return;

        await RunAsync(() => ContractService.UpdateAsync(id, r.ContractNumber, r.ContractTypeId, r.EffectiveDate, r.ExpiryDate, r.Notes),
            "Contract updated.");
    }

    private async Task DeleteAsync(int id)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete contract",
            "Delete this draft contract? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;

        if (await RunAsync(() => ContractService.DeleteAsync(id), "Contract deleted."))
            _sharedPage?.CloseDetail();
    }

    // ─── Status ──────────────────────────────────────────────────────────

    private Task ActivateAsync(int id) =>
        RunAsync(() => ContractService.ActivateAsync(id), "Contract activated.");

    private Task MarkExpiredAsync(int id) =>
        RunAsync(() => ContractService.MarkExpiredAsync(id), "Contract marked as expired.");

    private async Task SuspendAsync(int id)
    {
        var reason = await AskReasonAsync("Suspend contract", "Suspend", Color.Warning, null);
        if (reason is not null)
            await RunAsync(() => ContractService.SuspendAsync(id, reason), "Contract suspended.");
    }

    private async Task TerminateAsync(int id)
    {
        var reason = await AskReasonAsync("Terminate contract", "Terminate", Color.Error,
            "Termination is final — the contract can't be edited or reactivated afterwards.");
        if (reason is not null)
            await RunAsync(() => ContractService.TerminateAsync(id, reason), "Contract terminated.");
    }

    private async Task<string?> AskReasonAsync(string title, string buttonText, Color color, string? message)
    {
        var parameters = new DialogParameters<ContractReasonDialog>
        {
            { x => x.ButtonText, buttonText },
            { x => x.ButtonColor, color },
            { x => x.Message, message }
        };
        var dialog = await DialogService.ShowAsync<ContractReasonDialog>(title, parameters, Options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: string reason } ? reason : null;
    }

    // ─── Parties ─────────────────────────────────────────────────────────

    private async Task OpenAddPartyDialogAsync(int contractId)
    {
        var parameters = new DialogParameters<AddPartyDialog>
        {
            { x => x.Companies, _companies },
            { x => x.Roles, _roles }
        };
        var dialog = await DialogService.ShowAsync<AddPartyDialog>("Add party", parameters, Options);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: PartyRequest r }) return;

        await RunAsync(() => ContractService.AddPartyAsync(contractId, r.CompanyId, r.RoleId), "Party added.");
    }

    private async Task RemovePartyAsync((int ContractId, ContractPartyResponse Party) arg)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Remove party",
            $"Remove {arg.Party.CompanyName} ({arg.Party.Role}) from this contract?",
            yesText: "Remove", cancelText: "Cancel");
        if (confirmed != true) return;

        await RunAsync(() => ContractService.RemovePartyAsync(arg.ContractId, arg.Party.CompanyId, arg.Party.RoleId), "Party removed.");
    }

    // ─── Amendments ──────────────────────────────────────────────────────

    private async Task OpenRecordAmendmentDialogAsync(int contractId)
    {
        var dialog = await DialogService.ShowAsync<RecordAmendmentDialog>("Record amendment", Options);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: AmendmentRequest r }) return;

        await RunAsync(() => ContractService.RecordAmendmentAsync(contractId, r.Description, r.EffectiveDate), "Amendment recorded.");
    }

    private async Task OpenChangeExpiryDialogAsync(ContractDetailResponse contract)
    {
        var parameters = new DialogParameters<ChangeExpiryDialog>
        {
            { x => x.CurrentExpiry, contract.ExpiryDate },
            { x => x.EffectiveDate, contract.EffectiveDate }
        };
        var dialog = await DialogService.ShowAsync<ChangeExpiryDialog>("Change expiry", parameters, Options);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: ChangeExpiryRequest r }) return;

        await RunAsync(() => ContractService.ChangeExpiryAsync(contract.Id, r.NewExpiryDate), "Expiry date changed.");
    }

    // ─── Helpers ─────────────────────────────────────────────────────────

    /// <summary>Runs a write, shows the server's message on failure, reloads list + report + open drawer on success.</summary>
    private async Task<bool> RunAsync(Func<Task<Result>> action, string successMessage)
    {
        try
        {
            var result = await action();
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Error ?? "Operation failed.", Severity.Error);
                return false;
            }

            Snackbar.Add(successMessage, Severity.Success);
            await ReloadAllAsync();
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return false;
        }
    }

    private async Task TryAsync(Func<Task> action)
    {
        try { await action(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
