
@using Marilog.Contracts.Interfaces.FrontendServices
@using Marilog.Contracts.Interfaces.Services.SystemServices
@using Marilog.Shared.UI.Layout
@using Marilog.Shared.UI.Services
@using Marilog.Web.Client.Auth
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject INavigationService NavService
@inject IAppThemeService ThemeService
@inject AppStateService AppState
@inject CookieAuthStateProvider AuthProvider
@inject ICompanyService CompanyService
@implements IDisposable
@inherits LayoutComponentBase


<SharedMainLayout Items="AppState.NavItems"
                  Theme="AppState.Theme"
                  Themes="AppState.Themes"
                  OnThemeSelected="OnThemeSelectedAsync"
                  AppTitle="Marilog"
                  UserDisplayName="@_userDisplayName"
                  OnLogout="LogoutAsync"
                  AppSubtitle="@_CompanyName">

    @Body

</SharedMainLayout>
@code {
    private const string ThemeStorageKey = "marilog.themeId";

    private string _CompanyName = "";


    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += HandleStateChanged;

        var savedThemeId = await GetSavedThemeIdAsync();
        var getCompany = await CompanyService.GetOwnCompanyNameAsync();
        _CompanyName = getCompany != null ? getCompany.Name : "";
        await AppState.InitializeAsync(
            loadNav: () => NavService.GetAsync(),
            loadThemes: () => ThemeService.GetActiveAsync(),
            savedThemeId: savedThemeId);
    }

    private async Task OnThemeSelectedAsync(int themeId)
    {
        AppState.SetTheme(themeId);

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ThemeStorageKey, themeId.ToString());
        }
        catch (JSException ex)
        {
            Console.WriteLine($"Saving theme failed: {ex.Message}");
        }
    }

    private async Task<int?> GetSavedThemeIdAsync()
    {
        try
        {
            var value = await JS.InvokeAsync<string?>("localStorage.getItem", ThemeStorageKey);
            return int.TryParse(value, out var id) ? id : null;
        }
        catch (JSException ex)
        {
            Console.WriteLine($"Reading saved theme failed: {ex.Message}");
            return null;
        }
    }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string? _userDisplayName;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is null) return;

        var user = (await AuthStateTask).User;
        _userDisplayName = user.FindFirst(CookieAuthStateProvider.FullNameClaim)?.Value
                           ?? user.Identity?.Name;
    }

    private Task LogoutAsync() => AuthProvider.LogoutAsync();

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => AppState.OnChange -= HandleStateChanged;
}