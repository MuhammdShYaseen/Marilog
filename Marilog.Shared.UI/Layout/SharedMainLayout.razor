@using Marilog.Contracts.DTOs.Frontend.AppTheme
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Shared.UI.Components.Navigation
@using MudBlazor
@namespace Marilog.Shared.UI.Layout


<MudThemeProvider Theme="_mudTheme" IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <MudAppBar Elevation="0">

        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer" />

        <MudText Typo="Typo.h6" Class="ml-3">
            @AppTitle
        </MudText>

        <MudSpacer />
        @if (Themes.Count > 1)
        {
            <MudMenu Icon="@Icons.Material.Filled.Palette"
                     Color="Color.Inherit"
                     Dense="true"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight">
                @foreach (var t in Themes)
                {
                    <MudMenuItem OnClick="@(() => OnThemeSelected.InvokeAsync(t.Id))"
                                 Icon="@(t.Id == Theme?.Id ? Icons.Material.Filled.Check : string.Empty)">
                        @t.ThemeName
                    </MudMenuItem>
                }
            </MudMenu>
        }
        <MudText Typo="Typo.body2" Class="mr-3">
            @AppSubtitle
        </MudText>

    </MudAppBar>

    <MudDrawer @bind-Open="drawerOpen"
               Elevation="2"
               Variant="DrawerVariant.Responsive">

        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Navigation</MudText>
        </MudDrawerHeader>

        <MudNavMenu>

            @if (Items?.Any() != true)
            {
                <MudText>Loading...</MudText>
            }
            else
            {
                <NavMenu Items="Items" />
            }

        </MudNavMenu>

    </MudDrawer>

    <MudMainContent>

        <MudContainer MaxWidth="MaxWidth.ExtraLarge"
                      Class="mt-4">

            @ChildContent

        </MudContainer>

    </MudMainContent>

</MudLayout>

@code {

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public List<NavItemResponse> Items { get; set; }
        = new();

    [Parameter]
    public string AppTitle { get; set; }
        = "Marilog";

    [Parameter]
    public string AppSubtitle { get; set; }
        = "";
    [Parameter]
    public AppThemeResponse? Theme { get; set; }

    [Parameter]
    public IReadOnlyList<AppThemeResponse> Themes { get; set; } = [];

    [Parameter]
    public EventCallback<int> OnThemeSelected { get; set; }

    private MudTheme _mudTheme = new();
    private bool _isDark;
    private bool drawerOpen = true;
    private AppThemeResponse? _appliedTheme;

    protected override void OnParametersSet()
    {
        if (Theme is null || ReferenceEquals(Theme, _appliedTheme)) return;
        _appliedTheme = Theme;

        _isDark = Theme.IsDarkMode;

        _mudTheme = new MudTheme
        {
            Typography = new Typography
            {
                Default = new DefaultTypography
                {
                    FontFamily = [Theme.FontFamily, "Segoe UI", "Arial", "sans-serif"],
                    FontSize = Theme.BaseFontSize
                }
            }
        };

        if (Theme.IsDarkMode)
        {
            _mudTheme.PaletteDark = new PaletteDark
            {
                Primary = Theme.PrimaryColor,
                Secondary = Theme.SecondaryColor,
                AppbarBackground = Theme.AppBarColor,
                Background = Theme.BackgroundColor,
                Surface = Theme.SurfaceColor,
                Error = Theme.ErrorColor,
                Success = Theme.SuccessColor,
                Warning = Theme.WarningColor
            };
        }
        else
        {
            _mudTheme.PaletteLight = new PaletteLight
            {
                Primary = Theme.PrimaryColor,
                Secondary = Theme.SecondaryColor,
                AppbarBackground = Theme.AppBarColor,
                Background = Theme.BackgroundColor,
                Surface = Theme.SurfaceColor,
                Error = Theme.ErrorColor,
                Success = Theme.SuccessColor,
                Warning = Theme.WarningColor
            };
        }
    }
    private void ToggleDrawer()
        => drawerOpen = !drawerOpen;

    private void ToggleTheme()
    {
        _isDark = !_isDark;
    }
}