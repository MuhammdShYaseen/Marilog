@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.EmailInbox

<div class="email-detail-panel">

    @* Header *@
    <div class="email-header">

        <div class="email-header-top">
            <MudText Typo="Typo.h6" Class="email-subject">
                @(string.IsNullOrWhiteSpace(Email.Subject)
                    ? "(No subject)"
                    : Email.Subject)
            </MudText>

            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           OnClick="@(() => OnClose.InvokeAsync())" />
        </div>

        @* Email metadata *@
        <div class="email-metadata">

            <div class="email-metadata-row">
                <span class="email-metadata-label">From</span>
                <span class="email-metadata-value">
                    @SenderLabel
                </span>
            </div>

            @if (Recipients.Count > 0)
            {
                <div class="email-metadata-row">
                    <span class="email-metadata-label">To</span>
                    <span class="email-metadata-value">
                        @string.Join(", ",
                            Recipients.Select(r =>
                                r.DisplayName ?? r.EmailAddress))
                    </span>
                </div>
            }

            @if (CcList.Count > 0)
            {
                <div class="email-metadata-row">
                    <span class="email-metadata-label">Cc</span>
                    <span class="email-metadata-value">
                        @string.Join(", ",
                            CcList.Select(c =>
                                c.DisplayName ?? c.EmailAddress))
                    </span>
                </div>
            }

            <div class="email-date">
                @(Email.SentAt?.ToString("dddd, yyyy-MM-dd HH:mm") ?? "Draft")
            </div>

        </div>

    </div>

    <MudDivider />

    @* Email body *@
    <div class="email-body">
        @((MarkupString)Email.Body)
    </div>

    @* Actions *@
    <div class="email-actions">

        @if (OnSend.HasDelegate)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Send"
                       OnClick="@(() => OnSend.InvokeAsync(Email))">
                Send
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Reply"
                       OnClick="@(() => OnReply.InvokeAsync(Email))">
                Reply
            </MudButton>
        }

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.AttachFile"
                   OnClick="@(() => OnManageAttachments.InvokeAsync(Email))">
            Attachments
        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Delete"
                   OnClick="@(() => OnDelete.InvokeAsync(Email))">
            Delete
        </MudButton>

    </div>

</div>

<style>

    /* =========================================================
           Main panel
           ========================================================= */

    .email-detail-panel {
        height: 100%;
        min-height: 0;
        display: flex;
        flex-direction: column;
        background: var(--mud-palette-surface);
    }


    /* =========================================================
           Header
           ========================================================= */

    .email-header {
        padding: 16px 18px 14px 18px;
        flex-shrink: 0;
    }

    .email-header-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .email-subject {
        font-weight: 600;
        line-height: 1.3;
        min-width: 0;
        overflow-wrap: anywhere;
    }


    /* =========================================================
           Metadata
           ========================================================= */

    .email-metadata {
        margin-top: 12px;
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .email-metadata-row {
        display: grid;
        grid-template-columns: 48px minmax(0, 1fr);
        gap: 8px;
        align-items: start;
        font-size: 13px;
    }

    .email-metadata-label {
        color: var(--mud-palette-text-secondary);
        font-weight: 600;
    }

    .email-metadata-value {
        min-width: 0;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .email-date {
        margin-top: 4px;
        color: var(--mud-palette-text-secondary);
        font-size: 12px;
    }


    /* =========================================================
           Email body
           ========================================================= */

    .email-body {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 18px;
        line-height: 1.55;
    }


        /* =========================================================
           HTML email content
           ========================================================= */

        .email-body img {
            max-width: 100%;
            height: auto;
        }

        .email-body table {
            width: 100% !important;
            max-width: 100%;
            border-collapse: collapse;
            table-layout: auto;
        }

        .email-body th {
            padding: 10px 8px;
            text-align: left;
            font-weight: 600;
            border-bottom: 2px solid #d6d6d6;
            vertical-align: bottom;
            white-space: normal;
        }

        .email-body td {
            padding: 10px 8px;
            border-bottom: 1px solid #e5e5e5;
            vertical-align: top;
            overflow-wrap: anywhere;
            word-break: normal;
        }

        .email-body tr:last-child td {
            border-bottom: none;
        }

        /* Numbers / currency */
        .email-body td:nth-child(3) {
            white-space: nowrap;
            text-align: right;
        }

        /* Dates */
        .email-body td:nth-child(4) {
            white-space: nowrap;
        }

        .email-body h1,
        .email-body h2,
        .email-body h3 {
            margin-top: 20px;
            margin-bottom: 12px;
        }

        .email-body p {
            margin-top: 0;
            margin-bottom: 12px;
        }


    /* =========================================================
           Actions
           ========================================================= */

    .email-actions {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 18px;
        border-top: 1px solid var(--mud-palette-divider);
        background: var(--mud-palette-surface);
    }

        .email-actions .mud-button {
            white-space: nowrap;
        }


    /* =========================================================
           Smaller screens
           ========================================================= */

    @@media (max-width: 600px) {

        .email-header {
            padding: 14px;
        }

        .email-body {
            padding: 14px;
        }

        .email-actions {
            padding: 10px 14px;
            flex-wrap: wrap;
        }

        .email-metadata-row {
            grid-template-columns: 42px minmax(0, 1fr);
        }
    }
</style>

@code {
    [Parameter, EditorRequired]
    public EmailResponse Email { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<EmailResponse> OnReply { get; set; }

    // When bound, shows "Send" instead of "Reply" — used by the Drafts view.
    [Parameter]
    public EventCallback<EmailResponse> OnSend { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<EmailResponse> OnManageAttachments { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<EmailResponse> OnDelete { get; set; }

    private EmailParticipantResponse? Sender =>
        Email.Participants.FirstOrDefault(
            p => p.Role == ParticipantRole.From);

    private string SenderLabel =>
        Sender?.DisplayName ??
        Sender?.EmailAddress ??
        "Unknown";

    private List<EmailParticipantResponse> Recipients =>
        Email.Participants
            .Where(p => p.Role == ParticipantRole.To)
            .ToList();

    private List<EmailParticipantResponse> CcList =>
        Email.Participants
            .Where(p => p.Role == ParticipantRole.Cc)
            .ToList();
}