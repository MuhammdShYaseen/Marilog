@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.EmailInbox

<MudPaper Class="email-detail-panel mt-4 pa-4" Outlined="true">

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
        <MudText Typo="Typo.h6">@(string.IsNullOrWhiteSpace(Email.Subject) ? "(No subject)" : Email.Subject)</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => OnClose.InvokeAsync())" />
    </MudStack>

    <MudStack Spacing="1" Class="mb-3">
        <MudText Typo="Typo.body2">
            <b>From:</b> @SenderLabel
        </MudText>

        @if (Recipients.Count > 0)
        {
            <MudText Typo="Typo.body2">
                <b>To:</b> @string.Join(", ", Recipients.Select(r => r.DisplayName ?? r.EmailAddress))
            </MudText>
        }

        @if (CcList.Count > 0)
        {
            <MudText Typo="Typo.body2">
                <b>Cc:</b> @string.Join(", ", CcList.Select(c => c.DisplayName ?? c.EmailAddress))
            </MudText>
        }

        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @(Email.SentAt?.ToString("dddd, yyyy-MM-dd HH:mm") ?? "Draft")
        </MudText>
    </MudStack>

    <MudDivider Class="mb-3" />

    <div class="email-body">
        @((MarkupString)Email.Body)
    </div>

    <MudDivider Class="mt-4 mb-3" />

    <MudStack Row="true" Spacing="2">
        @if (OnSend.HasDelegate)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Send"
                       OnClick="@(() => OnSend.InvokeAsync(Email))">
                Send
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Reply"
                       OnClick="@(() => OnReply.InvokeAsync(Email))">
                Reply
            </MudButton>
        }

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.AttachFile"
                   OnClick="@(() => OnManageAttachments.InvokeAsync(Email))">
            Attachments
        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Delete"
                   OnClick="@(() => OnDelete.InvokeAsync(Email))">
            Delete
        </MudButton>
    </MudStack>

</MudPaper>

<style>
    .email-detail-panel {
        border-radius: 8px;
    }

    .email-body {
        max-height: 400px;
        overflow-y: auto;
        line-height: 1.5;
    }
</style>

@code {
    [Parameter, EditorRequired]
    public EmailResponse Email { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<EmailResponse> OnReply { get; set; }

    // When bound, shows "Send" instead of "Reply" — used by the Drafts view.
    [Parameter]
    public EventCallback<EmailResponse> OnSend { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<EmailResponse> OnManageAttachments { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<EmailResponse> OnDelete { get; set; }

    private EmailParticipantResponse? Sender =>
        Email.Participants.FirstOrDefault(p => p.Role == ParticipantRole.From);

    private string SenderLabel =>
        Sender?.DisplayName ?? Sender?.EmailAddress ?? "Unknown";

    private List<EmailParticipantResponse> Recipients =>
        Email.Participants.Where(p => p.Role == ParticipantRole.To).ToList();

    private List<EmailParticipantResponse> CcList =>
        Email.Participants.Where(p => p.Role == ParticipantRole.Cc).ToList();
}
