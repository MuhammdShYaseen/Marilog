@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.Companies

<MudPaper Class="pa-4" Elevation="0">
    <MudText Typo="Typo.h5" Class="mb-2">Companies</MudText>

    <div class="d-flex align-center gap-1 mb-3 pb-1"
         style="border-bottom:1px solid var(--mud-palette-lines-default);">
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => OnAddClicked.InvokeAsync())">
            New company
        </MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="@(() => OnRefreshClicked.InvokeAsync())">
            Refresh
        </MudButton>
        <MudSpacer />
        <MudTextField @bind-Value="_search"
                      Placeholder="Search..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Style="max-width:250px" />
    </div>

    <CompanyTable Items="@_filtered"
                  SelectedId="@_selectedId"
                  OnRowSelected="@HandleRowSelectedAsync"
                  OnEditClicked="@OnEditClicked"
                  OnDeleteClicked="@OnDeleteClicked"
                  OnActivateClicked="@OnActivateClicked"
                  OnDeactivateClicked="@OnDeactivateClicked"
                  OnManageAttachedFilesClicked="@OnManageAttachedFilesClicked" />

    <MudDrawer Open="@_isDrawerOpen" OpenChanged="@OnDrawerOpenChanged"
               Anchor="Anchor.Right"
               Variant="DrawerVariant.Temporary"
               Elevation="0"
               Width="560px"
               Style="border-left:1px solid var(--mud-palette-lines-default);">

        @if (_selectedDetail is not null)
        {
            <CompanyDetails Company="@_selectedDetail"
                            IsLoading="@_isLoadingDetail"
                            OnClose="@CloseDetail"
                            OnEditClicked="@OnEditClicked"
                            OnDeleteClicked="@OnDeleteClicked"
                            OnActivateClicked="@OnActivateClicked"
                            OnDeactivateClicked="@OnDeactivateClicked"
                            OnSetOwnClicked="@OnSetOwnClicked"
                            OnManageAttachedFilesClicked="@OnManageAttachedFilesClicked"
                            OnVesselClick="@OnVesselClick"
                            OnAddEmailClicked="@OnAddEmailClicked"
                            OnEditEmailClicked="@OnEditEmailClicked"
                            OnDeleteEmailClicked="@OnDeleteEmailClicked"
                            OnAddPhoneClicked="@OnAddPhoneClicked"
                            OnEditPhoneClicked="@OnEditPhoneClicked"
                            OnDeletePhoneClicked="@OnDeletePhoneClicked"
                            OnAddBankAccountClicked="@OnAddBankAccountClicked"
                            OnEditBankAccountClicked="@OnEditBankAccountClicked"
                            OnDeleteBankAccountClicked="@OnDeleteBankAccountClicked" />
        }

    </MudDrawer>
</MudPaper>

@code {
    [Parameter] public IReadOnlyList<CompanyResponse> Companies { get; set; } = [];
    [Parameter] public Func<int, Task<CompanyResponse?>>? GetCompanyWithVessels { get; set; }

    [Parameter] public EventCallback OnAddClicked { get; set; }
    [Parameter] public EventCallback OnRefreshClicked { get; set; }
    [Parameter] public EventCallback<CompanyResponse> OnEditClicked { get; set; }
    [Parameter] public EventCallback<CompanyResponse> OnDeleteClicked { get; set; }
    [Parameter] public EventCallback<CompanyResponse> OnActivateClicked { get; set; }
    [Parameter] public EventCallback<CompanyResponse> OnDeactivateClicked { get; set; }
    [Parameter] public EventCallback<CompanyResponse> OnSetOwnClicked { get; set; }
    [Parameter] public EventCallback<int> OnVesselClick { get; set; }
    [Parameter] public EventCallback<(int entityId, EntityType entityType)> OnManageAttachedFilesClicked { get; set; }

    [Parameter] public EventCallback<CompanyResponse> OnAddEmailClicked { get; set; }
    [Parameter] public EventCallback<(CompanyResponse, EmailsResponse)> OnEditEmailClicked { get; set; }
    [Parameter] public EventCallback<(CompanyResponse, EmailsResponse)> OnDeleteEmailClicked { get; set; }

    [Parameter] public EventCallback<CompanyResponse> OnAddPhoneClicked { get; set; }
    [Parameter] public EventCallback<(CompanyResponse, PhonesResponse)> OnEditPhoneClicked { get; set; }
    [Parameter] public EventCallback<(CompanyResponse, PhonesResponse)> OnDeletePhoneClicked { get; set; }

    [Parameter] public EventCallback<CompanyResponse> OnAddBankAccountClicked { get; set; }
    [Parameter] public EventCallback<(CompanyResponse, BankAccountResponse)> OnEditBankAccountClicked { get; set; }
    [Parameter] public EventCallback<(CompanyResponse, BankAccountResponse)> OnDeleteBankAccountClicked { get; set; }

    private string _search = string.Empty;
    private int? _selectedId;
    private CompanyResponse? _selectedDetail;
    private bool _isLoadingDetail;
    private bool _isDrawerOpen;

    private IEnumerable<CompanyResponse> _filtered =>
        string.IsNullOrWhiteSpace(_search)
            ? Companies
            : Companies.Where(c =>
                c.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                (c.ContactName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (c.RegistrationNumber?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override void OnParametersSet()
    {
        // The selected company was deleted — close the drawer.
        if (_selectedId is int id && Companies.All(c => c.Id != id))
            CloseDetail();
    }

    private async Task HandleRowSelectedAsync(CompanyResponse item)
    {
        if (item.Id == 0)
            return;

        // Clicking the already-open row closes it.
        if (_isDrawerOpen && _selectedId == item.Id)
        {
            CloseDetail();
            return;
        }

        _selectedId = item.Id;
        _selectedDetail = item;          // show list data immediately while full detail loads
        _isLoadingDetail = true;
        _isDrawerOpen = true;
        StateHasChanged();

        var detail = GetCompanyWithVessels is null ? item : await GetCompanyWithVessels(item.Id);

        // Ignore a stale result if the user picked another row meanwhile.
        if (_selectedId == item.Id)
            _selectedDetail = detail ?? item;

        _isLoadingDetail = false;
    }

    /// <summary>Lets the host refresh the open drawer after a list reload.</summary>
    public async Task RefreshSelectedIfOpenAsync()
    {
        if (!_isDrawerOpen || _selectedId is not int id || GetCompanyWithVessels is null)
            return;

        _isLoadingDetail = true;
        StateHasChanged();

        _selectedDetail = await GetCompanyWithVessels(id) ?? _selectedDetail;
        _isLoadingDetail = false;
        StateHasChanged();
    }

    /// <summary>Kept for the host's existing RefreshSelected (emails, phones, bank accounts).</summary>
    public void UpdateSelected(CompanyResponse company)
    {
        if (company.Id == 0)
            return;

        _selectedId = company.Id;
        _selectedDetail = company;
        StateHasChanged();
    }

    private void OnDrawerOpenChanged(bool open)
    {
        if (!open)
            CloseDetail();
    }

    private void CloseDetail()
    {
        _selectedId = null;
        _isDrawerOpen = false;
        // _selectedDetail is kept so the content doesn't vanish mid-animation.
    }
}