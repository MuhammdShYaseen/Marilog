@* SharedAssetsPage.razor *@
@using Marilog.Contracts.DTOs.Reports.DocumentReports
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using Marilog.Shared.UI.Pages.Documents
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.Assets

<MudPaper Class="pa-4" Elevation="0">
    <MudText Typo="Typo.h5" Class="mb-2">Assets</MudText>

    <div class="d-flex align-center gap-1 mb-3 pb-1"
         style="border-bottom:1px solid var(--mud-palette-lines-default);">
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OnAddClicked">
            New asset
        </MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="OnRefreshClicked">
            Refresh
        </MudButton>
        <MudSpacer />
        <MudTextField T="string"
                      Value="_search"
                      ValueChanged="OnSearchChanged"
                      Placeholder="Search by number or reference..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      DebounceInterval="400"
                      Immediate="true"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Style="max-width:250px" />
    </div>

    <div class="d-flex align-center gap-3 mb-3 flex-wrap">
        <MudSelect T="FinancialSide?"
                   Value="_side"
                   ValueChanged="OnSideChanged"
                   Label="Type"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Dense="true"
                   Style="max-width:200px">
            <MudSelectItem T="FinancialSide?" Value="@((FinancialSide?)null)">All</MudSelectItem>
            <MudSelectItem T="FinancialSide?" Value="@((FinancialSide?)FinancialSide.AssetPurchase)">Purchase</MudSelectItem>
            <MudSelectItem T="FinancialSide?" Value="@((FinancialSide?)FinancialSide.AssetSale)">Sale</MudSelectItem>
        </MudSelect>

        <MudSelect T="int" MultiSelection="true"
                   @bind-SelectedValues="_vesselIds"
                   @bind-SelectedValues:after="RaiseFilterAsync"
                   ToStringFunc="VesselName"
                   Label="Vessels"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Dense="true"
                   Clearable="true"
                   Style="max-width:250px">
            @foreach (var v in Vessels)
            {
                <MudSelectItem T="int" Value="v.Id">@v.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="DocumentPaymentStatus?"
                   Value="_paymentStatus"
                   ValueChanged="OnPaymentStatusChanged"
                   Label="Payment Status"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Dense="true"
                   Style="max-width:200px">
            <MudSelectItem T="DocumentPaymentStatus?" Value="null">All</MudSelectItem>
            <MudSelectItem T="DocumentPaymentStatus?" Value="DocumentPaymentStatus.Paid">Paid</MudSelectItem>
            <MudSelectItem T="DocumentPaymentStatus?" Value="DocumentPaymentStatus.Unpaid">Unpaid</MudSelectItem>
            <MudSelectItem T="DocumentPaymentStatus?" Value="DocumentPaymentStatus.PartiallyPaid">Partially Paid</MudSelectItem>
        </MudSelect>
    </div>

    <DocumentTable Items="Items"
                   GridStorageKey="wa-asset-grid-widths"
                   OnRowClick="OnAssetSelected"
                   OnEditClicked="OnAssetSelected"
                   OnDeleteClicked="OnDeleteClicked"
                   OnManageAttachedFilesClicked="OnManageAttachedFilesClicked"
                   CurrentPage="CurrentPage"
                   TotalPages="TotalPages"
                   OnPageChanged="OnPageChanged" />
</MudPaper>

@code {
    [Parameter] public IReadOnlyList<DocumentResponse> Items { get; set; } = [];
    [Parameter] public IReadOnlyList<VesselLookupResponse> Vessels { get; set; } = [];
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; }

    [Parameter] public EventCallback OnAddClicked { get; set; }
    [Parameter] public EventCallback OnRefreshClicked { get; set; }
    [Parameter] public EventCallback<DocumentResponse> OnAssetSelected { get; set; }
    [Parameter] public EventCallback<DocumentResponse> OnDeleteClicked { get; set; }
    [Parameter] public EventCallback<(int entityId, EntityType entityType)> OnManageAttachedFilesClicked { get; set; }
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    /// <summary>Raised when any filter or the search text changes; the host reloads from page 1.</summary>
    [Parameter] public EventCallback<(DocumentFilterOptions Options, string? Search)> OnFilterChanged { get; set; }

    private FinancialSide? _side;
    private IReadOnlyCollection<int> _vesselIds = [];
    private DocumentPaymentStatus? _paymentStatus;
    private string? _search;

    private Task OnSideChanged(FinancialSide? value) { _side = value; return RaiseFilterAsync(); }
    private Task OnPaymentStatusChanged(DocumentPaymentStatus? value) { _paymentStatus = value; return RaiseFilterAsync(); }
    private Task OnSearchChanged(string? value) { _search = value; return RaiseFilterAsync(); }

    private Task RaiseFilterAsync() =>
        OnFilterChanged.InvokeAsync((new DocumentFilterOptions
        {
            Side = _side,
            VesselIds = _vesselIds.ToList(),
            PaymentStatus = _paymentStatus
        }, _search));

    private string VesselName(int id) =>
        Vessels.FirstOrDefault(v => v.Id == id)?.Name ?? $"#{id}";
}