@using System.Text.Json
@using Marilog.Contracts.DTOs.Requests.EmailDTOs
@using Marilog.Kernel.Enums
@using MudBlazor

@namespace Marilog.Shared.UI.Pages.EmailAccounts

<MudDialog>

    <TitleContent>
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Spacing="2">

            <MudIcon Icon="@Icons.Material.Filled.AlternateEmail"
                     Color="Color.Primary" />

            <MudText Typo="Typo.h6">
                Add Email Account
            </MudText>

        </MudStack>
    </TitleContent>


    <DialogContent>

        <MudStack Spacing="4">


            <MudSelect T="EmailProviderType"
                       @bind-Value="_providerType"
                       Label="Provider">

                <MudSelectItem Value="EmailProviderType.Imap">
                    IMAP / SMTP
                </MudSelectItem>


                <MudSelectItem Value="EmailProviderType.Gmail">
                    Gmail (OAuth)
                </MudSelectItem>


                <MudSelectItem Value="EmailProviderType.MicrosoftGraph"
                               Disabled="true">
                    Microsoft 365 (OAuth)
                </MudSelectItem>

            </MudSelect>



            @if (_providerType == EmailProviderType.Imap)
            {

                <MudDivider />


                <MudText Typo="Typo.subtitle2"
                         Color="Color.Secondary">
                    IMAP Configuration
                </MudText>


                <MudTextField @bind-Value="_imapHost"
                              Label="Host" />


                <MudTextField T="int"
                              @bind-Value="_imapPort"
                              Label="Port" />


                <MudTextField @bind-Value="_username"
                              Label="Username" />


                <MudTextField @bind-Value="_password"
                              Label="Password"
                              InputType="InputType.Password" />


                <MudCheckBox @bind-Value="_useSsl"
                             Label="Use SSL" />


                <MudDivider />


                <MudTextField @bind-Value="_smtpHost"
                              Label="SMTP Host" />


                <MudTextField T="int"
                              @bind-Value="_smtpPort"
                              Label="SMTP Port" />

            }
            else if (_providerType == EmailProviderType.Gmail)
            {

                <MudAlert Severity="Severity.Info">

                    Gmail account will be connected securely using
                    Google OAuth.

                    No password or token is stored in the browser.

                </MudAlert>


                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Custom.Brands.Google"
                           Disabled="_isConnecting"
                           OnClick="ConnectGoogle">

                    @(_isConnecting
                        ? "Connecting..."
                        : "Connect Gmail")

                </MudButton>


                @if (_isConnecting)
                {
                    <MudProgressLinear Indeterminate="true" />
                }

            }


        </MudStack>


    </DialogContent>



    <DialogActions>

        <MudButton OnClick="Cancel">
            Cancel
        </MudButton>


        @if (_providerType == EmailProviderType.Imap)
        {

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(!IsValid)"
                       OnClick="Submit">

                Add Account

            </MudButton>

        }


    </DialogActions>


</MudDialog>



@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;



    [Inject]
    private NavigationManager Navigation { get; set; } = default!;



    private EmailProviderType _providerType =
        EmailProviderType.Imap;



    private bool _isConnecting;



    private string _imapHost = string.Empty;

    private int _imapPort = 993;


    private string _username = string.Empty;

    private string _password = string.Empty;


    private bool _useSsl = true;


    private string _smtpHost = string.Empty;

    private int _smtpPort = 587;



    private bool IsValid =>
        _providerType != EmailProviderType.Imap
        ||
        (
            !string.IsNullOrWhiteSpace(_imapHost)
            &&
            !string.IsNullOrWhiteSpace(_username)
            &&
            !string.IsNullOrWhiteSpace(_password)
            &&
            !string.IsNullOrWhiteSpace(_smtpHost)
        );




    private void Cancel()
        => MudDialog.Cancel();




    private void ConnectGoogle()
    {
        _isConnecting = true;


        Navigation.NavigateTo(
            "api/emailaccounts/google/connect",
            forceLoad: true);
    }




    private void Submit()
    {

        if (!IsValid)
            return;



        var config =
            new Dictionary<string, string>
            {

                ["Host"] = _imapHost,

                ["Port"] = _imapPort.ToString(),

                ["Username"] = _username,

                ["Password"] = _password,

                ["UseSsl"] = _useSsl.ToString(),

                ["SmtpHost"] = _smtpHost,

                ["SmtpPort"] = _smtpPort.ToString()

            };



        var request =
            new CreateEmailAccountRequest
            {
                ProviderType = EmailProviderType.Imap,

                Config = JsonSerializer.Serialize(config)
            };



        MudDialog.Close(
            DialogResult.Ok(request));
    }

}