@using Marilog.Contracts.DTOs.Reports.PaymentReports
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.Payments

<MudPaper Class="pa-4" Elevation="2">

    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.h6">Payments</MudText>
    </MudStack>

    @* ── Filter Bar ──────────────────────────────────────── *@
    <MudPaper Class="pa-4 mb-4 wa-rpt-panel" Elevation="0">
        <div class="wa-rpt-section-title">Filters</div>
        <MudGrid Spacing="2">

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="int?"
                           @bind-Value="_paymentFilter.SupplierId"
                           Label="Supplier"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true">
                    @foreach (var s in Companies)
                    {
                        <MudSelectItem T="int?" Value="@((int?)s.Id)">@s.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="int?"
                           @bind-Value="_paymentFilter.BuyerId"
                           Label="Buyer"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true">
                    @foreach (var b in Companies)
                    {
                        <MudSelectItem T="int?" Value="@((int?)b.Id)">@b.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="int?"
                           Value="_paymentFilter.VesselId"
                           ValueChanged="OnVesselChanged"
                           Label="Vessel"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true">
                    @foreach (var v in Vessels)
                    {
                        <MudSelectItem T="int?" Value="@((int?)v.Id)">@v.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="int?"
                           @bind-Value="_paymentFilter.VoyageId"
                           Label="Voyage"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true">
                    @foreach (var vo in FilteredVoyages)
                    {
                        <MudSelectItem T="int?" Value="@((int?)vo.Id)">@vo.DisplayText</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="FinancialSide?"
                           @bind-Value="_paymentFilter.Side"
                           Label="Financial Side"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true">
                    @foreach (var item in Enum.GetValues<FinancialSide>())
                    {
                        <MudSelectItem T="FinancialSide?" Value="@item">@item.ToString()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="PaymentMethod?"
                           @bind-Value="_paymentFilter.PaymentMethod"
                           Label="Payment Method"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true">
                    @foreach (var item in Enum.GetValues<PaymentMethod>())
                    {
                        <MudSelectItem T="PaymentMethod?" Value="@item">@item.ToString()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Date="_paymentFromDateTime"
                               DateChanged="v => { _paymentFilter.FromDate = v.HasValue ? DateOnly.FromDateTime(v.Value) : null; _paymentFromDateTime = v; }"
                               Label="From Date"
                               Editable="true"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Date="_paymentToDateTime"
                               DateChanged="v => { _paymentFilter.ToDate = v.HasValue ? DateOnly.FromDateTime(v.Value) : null; _paymentToDateTime = v; }"
                               Label="To Date"
                               Editable="true"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6" md="2">
                <MudNumericField T="int?"
                                 @bind-Value="_paymentFilter.LastDays"
                                 Label="Last N Days"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6" md="2">
                <MudNumericField T="decimal?"
                                 @bind-Value="_paymentFilter.MinAmount"
                                 Label="Min Amount"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6" md="2">
                <MudNumericField T="decimal?"
                                 @bind-Value="_paymentFilter.MaxAmount"
                                 Label="Max Amount"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6" md="2" Class="d-flex align-center">
                <MudCheckBox T="bool"
                             Value="@(_paymentFilter.SwiftOnly ?? false)"
                             ValueChanged="@((bool v) => { _paymentFilter.SwiftOnly = v ? true : null; StateHasChanged(); })"
                             Label="SWIFT Only"
                             Color="Color.Primary" />
            </MudItem>

            <MudItem xs="12" Class="d-flex gap-2 flex-wrap">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           DisableElevation="true"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="RunPaymentReportAsync">
                    Run Report
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           DisableElevation="true"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="ClearPaymentFilter">
                    Clear
                </MudButton>
                @if (_paymentReport is not null)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               DisableElevation="true"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PictureAsPdf"
                               OnClick="@(() => OnDownloadPaymentPdf.InvokeAsync((_paymentReport!, "Payment Report", "PaymentReport")))">
                        Save as PDF
                    </MudButton>
                }
            </MudItem>

        </MudGrid>
    </MudPaper>

    @* ── Loading ──────────────────────────────────────────── *@
    @if (_loadingPaymentReport)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }

    @* ── Report Results ───────────────────────────────────── *@
    else if (_paymentReport is not null)
    {
        @* 1. KPI Cards ──────────────────────────────────────── *@
        <MudGrid Spacing="2" Class="mb-4">
            <MudItem xs="6" sm="3">
                <div class="wa-rpt-card">
                    <div class="wa-rpt-card-label">Total Payments</div>
                    <div class="wa-rpt-card-value">@_paymentReport.Count</div>
                </div>
            </MudItem>
            <MudItem xs="6" sm="3">
                <div class="wa-rpt-card wa-rpt-accent-success">
                    <div class="wa-rpt-card-label">Cash In</div>
                    <div class="wa-rpt-card-value wa-rpt-pos">
                        @($"{_paymentReport.CashIn:N2}")
                        <span class="wa-rpt-card-unit">@_paymentReport.BaseCurrencyCode</span>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="6" sm="3">
                <div class="wa-rpt-card wa-rpt-accent-error">
                    <div class="wa-rpt-card-label">Cash Out</div>
                    <div class="wa-rpt-card-value wa-rpt-neg">
                        @($"{_paymentReport.CashOut:N2}")
                        <span class="wa-rpt-card-unit">@_paymentReport.BaseCurrencyCode</span>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="6" sm="3">
                <div class="wa-rpt-card @(_paymentReport.NetCashFlow >= 0 ? "wa-rpt-accent-success" : "wa-rpt-accent-error")">
                    <div class="wa-rpt-card-label">Net Cash Flow</div>
                    <div class="wa-rpt-card-value @(_paymentReport.NetCashFlow >= 0 ? "wa-rpt-pos" : "wa-rpt-neg")">
                        @($"{_paymentReport.NetCashFlow:N2}")
                        <span class="wa-rpt-card-unit">@_paymentReport.BaseCurrencyCode</span>
                    </div>
                    <div class="wa-rpt-card-sub">Cash In &minus; Cash Out</div>
                </div>
            </MudItem>
        </MudGrid>

        @* 2. By Payment Method ──────────────────────────────── *@
        @if (_paymentReport.MethodSummary?.Any() == true)
        {
            <div class="wa-rpt-section-title">By Payment Method</div>
            <MudTable Items="_paymentReport.MethodSummary"
                      Dense="true" Hover="true" Striped="false"
                      Elevation="0" Class="mb-4 wa-rpt-table">
                <HeaderContent>
                    <MudTh>Method</MudTh>
                    <MudTh Style="text-align:right">Count</MudTh>
                    <MudTh Style="text-align:right">Cash In</MudTh>
                    <MudTh Style="text-align:right">Cash Out</MudTh>
                    <MudTh Style="text-align:right">Total</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Method</MudTd>
                    <MudTd Style="text-align:right">@context.Count</MudTd>
                    <MudTd Style="text-align:right" Class="wa-num wa-rpt-pos">@($"{context.CashIn:N2}")</MudTd>
                    <MudTd Style="text-align:right" Class="wa-num wa-rpt-neg">@($"{context.CashOut:N2}")</MudTd>
                    <MudTd Style="text-align:right" Class="wa-num">@($"{context.TotalBase:N2}")</MudTd>
                </RowTemplate>
            </MudTable>
        }

        @* 3. Monthly Breakdown ──────────────────────────────── *@
        @if (_paymentReport.MonthlySummary?.Any() == true)
        {
            <div class="wa-rpt-section-title">Monthly Breakdown</div>
            <MudTable Items="_paymentReport.MonthlySummary"
                      Dense="true" Hover="true" Striped="false"
                      Elevation="0" Class="mb-4 wa-rpt-table">
                <HeaderContent>
                    <MudTh>Year</MudTh>
                    <MudTh>Month</MudTh>
                    <MudTh Style="text-align:right">Count</MudTh>
                    <MudTh Style="text-align:right">Cash In</MudTh>
                    <MudTh Style="text-align:right">Cash Out</MudTh>
                    <MudTh Style="text-align:right">Net</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Year</MudTd>
                    <MudTd>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(context.Month)</MudTd>
                    <MudTd Style="text-align:right">@context.Count</MudTd>
                    <MudTd Style="text-align:right" Class="wa-num wa-rpt-pos">@($"{context.CashIn:N2}")</MudTd>
                    <MudTd Style="text-align:right" Class="wa-num wa-rpt-neg">@($"{context.CashOut:N2}")</MudTd>
                    <MudTd Style="text-align:right"
                           Class="@($"wa-num {(context.NetCashFlow >= 0 ? "wa-rpt-pos" : "wa-rpt-neg")}")">
                        @($"{context.NetCashFlow:N2}")
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        @* 4. By Supplier ────────────────────────────────────── *@
        @if (_paymentReport.SupplierSummary?.Any() == true)
        {
            <div class="wa-rpt-section-title">By Supplier</div>
            <MudTable Items="_paymentReport.SupplierSummary"
                      Dense="true" Hover="true" Striped="false"
                      Elevation="0" Class="mb-4 wa-rpt-table">
                <HeaderContent>
                    <MudTh>Supplier</MudTh>
                    <MudTh Style="text-align:right">Count</MudTh>
                    <MudTh Style="text-align:right">Total Paid</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.SupplierName</MudTd>
                    <MudTd Style="text-align:right">@context.Count</MudTd>
                    <MudTd Style="text-align:right" Class="wa-num wa-rpt-neg">@($"{context.TotalPaidBase:N2}")</MudTd>
                </RowTemplate>
            </MudTable>
        }

        @* 5. By Buyer ───────────────────────────────────────── *@
        @if (_paymentReport.BuyerSummary?.Any() == true)
        {
            <div class="wa-rpt-section-title">By Buyer</div>
            <MudTable Items="_paymentReport.BuyerSummary"
                      Dense="true" Hover="true" Striped="false"
                      Elevation="0" Class="mb-4 wa-rpt-table">
                <HeaderContent>
                    <MudTh>Buyer</MudTh>
                    <MudTh Style="text-align:right">Count</MudTh>
                    <MudTh Style="text-align:right">Total Received</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.BuyerName</MudTd>
                    <MudTd Style="text-align:right">@context.Count</MudTd>
                    <MudTd Style="text-align:right" Class="wa-num wa-rpt-pos">@($"{context.TotalReceivedBase:N2}")</MudTd>
                </RowTemplate>
            </MudTable>
        }

        @* 6. By Vessel ──────────────────────────────────────── *@
        @if (_paymentReport.VesselSummary?.Any() == true)
        {
            <div class="wa-rpt-section-title">By Vessel</div>
            <MudTable Items="_paymentReport.VesselSummary"
                      Dense="true" Hover="true" Striped="false"
                      Elevation="0" Class="mb-4 wa-rpt-table">
                <HeaderContent>
                    <MudTh>Vessel</MudTh>
                    <MudTh Style="text-align:right">Count</MudTh>
                    <MudTh Style="text-align:right">Cash In</MudTh>
                    <MudTh Style="text-align:right">Cash Out</MudTh>
                    <MudTh Style="text-align:right">Net</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.VesselName</MudTd>
                    <MudTd Style="text-align:right">@context.Count</MudTd>
                    <MudTd Style="text-align:right" Class="wa-num wa-rpt-pos">@($"{context.CashIn:N2}")</MudTd>
                    <MudTd Style="text-align:right" Class="wa-num wa-rpt-neg">@($"{context.CashOut:N2}")</MudTd>
                    <MudTd Style="text-align:right"
                           Class="@($"wa-num {(context.NetCashFlow >= 0 ? "wa-rpt-pos" : "wa-rpt-neg")}")">
                        @($"{context.NetCashFlow:N2}")
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        @* 7. By Voyage ──────────────────────────────────────── *@
        @if (_paymentReport.VoyageSummary?.Any() == true)
        {
            <div class="wa-rpt-section-title">By Voyage</div>
            <MudTable Items="_paymentReport.VoyageSummary"
                      Dense="true" Hover="true" Striped="false"
                      Elevation="0" Class="mb-4 wa-rpt-table">
                <HeaderContent>
                    <MudTh>Voyage</MudTh>
                    <MudTh Style="text-align:right">Count</MudTh>
                    <MudTh Style="text-align:right">Cash In</MudTh>
                    <MudTh Style="text-align:right">Cash Out</MudTh>
                    <MudTh Style="text-align:right">Net</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.VoyageNumber</MudTd>
                    <MudTd Style="text-align:right">@context.Count</MudTd>
                    <MudTd Style="text-align:right" Class="wa-num wa-rpt-pos">@($"{context.CashIn:N2}")</MudTd>
                    <MudTd Style="text-align:right" Class="wa-num wa-rpt-neg">@($"{context.CashOut:N2}")</MudTd>
                    <MudTd Style="text-align:right"
                           Class="@($"wa-num {(context.NetCashFlow >= 0 ? "wa-rpt-pos" : "wa-rpt-neg")}")">
                        @($"{context.NetCashFlow:N2}")
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        @* 8. Payments ───────────────────────────────────────── *@
        <div class="wa-rpt-section-title">Payments (@_paymentReport.Count)</div>
        <MudTable Items="_paymentReport.Payments"
                  Dense="true" Hover="true" Striped="false"
                  Elevation="0" Class="mb-4 wa-rpt-table">
            <HeaderContent>
                <MudTh>Payment Date</MudTh>
                <MudTh>Document</MudTh>
                <MudTh>Supplier / Buyer</MudTh>
                <MudTh>Vessel</MudTh>
                <MudTh>Method</MudTh>
                <MudTh>Side</MudTh>
                <MudTh Style="text-align:right">Amount</MudTh>
                <MudTh Style="text-align:right">Amount (@_paymentReport.BaseCurrencyCode)</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.PaymentDate.ToString("dd MMM yyyy")</MudTd>
                <MudTd>
                    <MudText Typo="Typo.body2">@context.DocNumber</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @context.DocDate.ToString("dd MMM yyyy")
                    </MudText>
                </MudTd>
                <MudTd>
                    @if (!string.IsNullOrEmpty(context.SupplierName))
                    {
                        <MudText Typo="Typo.body2">@context.SupplierName</MudText>
                    }
                    else if (!string.IsNullOrEmpty(context.BuyerName))
                    {
                        <MudText Typo="Typo.body2">@context.BuyerName</MudText>
                    }
                </MudTd>
                <MudTd>@(context.VesselName ?? "—")</MudTd>
                <MudTd>
                    <MudChip T="string"
                             Variant="Variant.Text"
                             Size="Size.Small"
                             Color="@(context.SwiftTransferId.HasValue ? Color.Info : Color.Default)">
                        @context.PaymentMethod.ToString()
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudChip T="string"
                             Variant="Variant.Text"
                             Size="Size.Small"
                             Color="@(context.Side == FinancialSide.Revenue ? Color.Success : Color.Error)">
                        @context.Side.ToString()
                    </MudChip>
                </MudTd>
                <MudTd Style="text-align:right" Class="wa-num">
                    @($"{context.PaidAmount:N2} {context.CurrencyCode}")
                </MudTd>
                <MudTd Style="text-align:right"
                       Class="@($"wa-num {(context.Side == FinancialSide.Revenue ? "wa-rpt-pos" : "wa-rpt-neg")}")">
                    @($"{context.PaidAmountBase:N2}")
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

</MudPaper>

@code {
    [Parameter] public IReadOnlyList<VesselLookupResponse> Vessels { get; set; } = [];
    [Parameter] public IReadOnlyList<VoyageLookupResponse> Voyages { get; set; } = [];
    [Parameter] public IReadOnlyList<CompanyResponse> Companies { get; set; } = [];
    [Parameter] public EventCallback<FilterPaymentOptionsRequest> OnPaymentReportRequested { get; set; }
    [Parameter] public EventCallback<(PaymentsReport report, string title, string fileName)> OnDownloadPaymentPdf { get; set; }

    private FilterPaymentOptionsRequest _paymentFilter = new();
    private PaymentsReport? _paymentReport;
    private bool _loadingPaymentReport;
    private DateTime? _paymentFromDateTime;
    private DateTime? _paymentToDateTime;

    private void OnVesselChanged(int? vesselId)
    {
        _paymentFilter.VesselId = vesselId;
        _paymentFilter.VoyageId = null;
    }

    private IEnumerable<VoyageLookupResponse> FilteredVoyages =>
        _paymentFilter.VesselId is null
            ? Voyages
            : Voyages.Where(v => v.VesselId == _paymentFilter.VesselId);

    private async Task RunPaymentReportAsync()
    {
        _loadingPaymentReport = true;
        StateHasChanged();
        await OnPaymentReportRequested.InvokeAsync(_paymentFilter);
        _loadingPaymentReport = false;
    }

    public void SetPaymentReport(PaymentsReport report)
    {
        _paymentReport = report;
        _loadingPaymentReport = false;
        StateHasChanged();
    }

    private void ClearPaymentFilter()
    {
        _paymentFilter = new();
        _paymentFromDateTime = null;
        _paymentToDateTime = null;
        _paymentReport = null;
    }
}

<style>
    .wa-rpt-panel {
        border: 1px solid var(--mud-palette-lines-default);
        background-color: var(--mud-palette-surface);
        border-radius: 4px;
    }

    .wa-rpt-section-title {
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--mud-palette-text-secondary);
        margin-bottom: 8px;
        margin-top: 4px;
    }

    .wa-rpt-card {
        border: 1px solid var(--mud-palette-lines-default);
        border-left: 3px solid var(--mud-palette-lines-default);
        background-color: var(--mud-palette-surface);
        border-radius: 4px;
        padding: 12px 14px;
        height: 100%;
    }

    .wa-rpt-accent-success {
        border-left-color: var(--mud-palette-success);
    }

    .wa-rpt-accent-error {
        border-left-color: var(--mud-palette-error);
    }

    .wa-rpt-card-label {
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--mud-palette-text-secondary);
        margin-bottom: 4px;
    }

    .wa-rpt-card-value {
        font-size: 1.35rem;
        font-weight: 600;
        line-height: 1.2;
        color: var(--mud-palette-text-primary);
        font-variant-numeric: tabular-nums;
    }

    .wa-rpt-card-unit {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--mud-palette-text-secondary);
        margin-left: 3px;
    }

    .wa-rpt-card-sub {
        font-size: 0.7rem;
        color: var(--mud-palette-text-secondary);
        margin-top: 4px;
    }

    .wa-rpt-pos {
        color: var(--mud-palette-success) !important;
    }

    .wa-rpt-neg {
        color: var(--mud-palette-error) !important;
    }

    .wa-rpt-table {
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 4px;
    }

        .wa-rpt-table th {
            font-size: 0.6875rem !important;
            font-weight: 600 !important;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: var(--mud-palette-text-secondary) !important;
            background-color: var(--mud-palette-background-grey);
            border-bottom: 1px solid var(--mud-palette-lines-default) !important;
        }

        .wa-rpt-table td {
            font-size: 0.8125rem;
            border-bottom: 1px solid var(--mud-palette-lines-default) !important;
        }

    .wa-num {
        font-variant-numeric: tabular-nums;
    }
</style>