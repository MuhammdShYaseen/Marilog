@using System.Text.Json
@using Marilog.Contracts.DTOs.Reports.DocumentReports
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using Microsoft.JSInterop
@using MudBlazor
@inject IJSRuntime JS
@namespace Marilog.Shared.UI.Pages.Dashboard
<div class="az-filter mb-4">
    <MudExpansionPanels Elevation="0" Class="az-filter-panels">
        <MudExpansionPanel>

            <TitleContent>
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Outlined.FilterAlt" Size="Size.Small" Color="Color.Primary" />
                    <span class="az-filter-title">Filter Options</span>
                </div>
            </TitleContent>

            <ChildContent>

                <MudGrid Spacing="2" Class="az-filter-grid">

                    <MudItem xs="12" sm="6" md="3">
                        <MudDatePicker Label="From" @bind-Date="_fromDate" DateFormat="dd MMM yyyy"
                                       Editable="true" PickerVariant="PickerVariant.Dialog"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudDatePicker Label="To" @bind-Date="_toDate" DateFormat="dd MMM yyyy"
                                       Editable="true" PickerVariant="PickerVariant.Dialog"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="int" MultiSelection="true" Label="Vessels" @bind-SelectedValues="_vesselIds"
                                   ToStringFunc="VesselName" Clearable="true"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var x in Vessels ?? [])
                            {
                                <MudSelectItem T="int" Value="x.Id">@x.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="int" MultiSelection="true" Label="Document Types" @bind-SelectedValues="_docTypeIds"
                                   ToStringFunc="DocTypeName" Clearable="true"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var x in DocTypes ?? [])
                            {
                                <MudSelectItem T="int" Value="x.Id">@x.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="int" MultiSelection="true" Label="Suppliers" @bind-SelectedValues="_supplierIds"
                                   ToStringFunc="CompanyName" Clearable="true"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var x in Companies ?? [])
                            {
                                <MudSelectItem T="int" Value="x.Id">@x.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="int" MultiSelection="true" Label="Buyers" @bind-SelectedValues="_buyerIds"
                                   ToStringFunc="CompanyName" Clearable="true"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var x in Companies ?? [])
                            {
                                <MudSelectItem T="int" Value="x.Id">@x.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="FinancialSide?" Label="Type" @bind-Value="_side" Clearable="true"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="FinancialSide?" Value="FinancialSide.Revenue">Revenue</MudSelectItem>
                            <MudSelectItem T="FinancialSide?" Value="FinancialSide.Expense">Expense</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="DocumentPaymentStatus?" Label="Payment Status" @bind-Value="_paymentStatus"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="DocumentPaymentStatus?" Value="null">All</MudSelectItem>
                            <MudSelectItem T="DocumentPaymentStatus?" Value="DocumentPaymentStatus.Paid">Paid</MudSelectItem>
                            <MudSelectItem T="DocumentPaymentStatus?" Value="DocumentPaymentStatus.Unpaid">Unpaid</MudSelectItem>
                            <MudSelectItem T="DocumentPaymentStatus?" Value="DocumentPaymentStatus.PartiallyPaid">Partially Paid</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-3" />

                @* ── Command bar ───────────────────────────────── *@
                <div class="az-filter-actions">

                    <div class="d-flex align-center gap-2 flex-wrap">
                        <span class="az-filter-label">Quick range</span>
                        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" Class="az-btn-group">
                            <MudButton OnClick="@(() => SetPreset(3))">3 Months</MudButton>
                            <MudButton OnClick="@(() => SetPreset(6))">6 Months</MudButton>
                            <MudButton OnClick="@(() => SetPreset(12))">1 Year</MudButton>
                        </MudButtonGroup>
                    </div>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               DisableElevation="true"
                               StartIcon="@Icons.Material.Filled.Check"
                               OnClick="Apply"
                               Class="az-apply">
                        Apply
                    </MudButton>

                </div>

            </ChildContent>

        </MudExpansionPanel>
    </MudExpansionPanels>
</div>

@code {
    [Parameter] public DocumentFilterOptions Value { get; set; } = new();
    [Parameter] public IReadOnlyList<VesselLookupResponse>? Vessels { get; set; }
    [Parameter] public IReadOnlyList<DocumentTypeResponse>? DocTypes { get; set; }
    [Parameter] public IReadOnlyList<CompanyResponse>? Companies { get; set; }
    [Parameter] public EventCallback<DocumentFilterOptions> OnFilterChanged { get; set; }

    private const string StorageKey = "marilog.dashboard.filters";

    private DateTime? _fromDate;
    private DateTime? _toDate;
    private IReadOnlyCollection<int> _vesselIds = [];
    private IReadOnlyCollection<int> _docTypeIds = [];
    private IReadOnlyCollection<int> _supplierIds = [];
    private IReadOnlyCollection<int> _buyerIds = [];
    private FinancialSide? _side;
    private DocumentPaymentStatus? _paymentStatus;
    private bool _initialized;

    protected override void OnParametersSet()
    {
        if (_initialized) return;
        Load(Value);
        _initialized = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var saved = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
        if (string.IsNullOrWhiteSpace(saved)) return;

        try
        {
            var state = JsonSerializer.Deserialize<DocumentFilterOptions>(saved);
            if (state is null) return;

            Load(state);
            StateHasChanged();

            await OnFilterChanged.InvokeAsync(state);
        }
        catch
        {
            // Ignore any stale or corrupted localStorage data
        }
    }

    private void Load(DocumentFilterOptions o)
    {
        _fromDate = o.FromDate?.ToDateTime(TimeOnly.MinValue);
        _toDate = o.ToDate?.ToDateTime(TimeOnly.MinValue);
        _vesselIds = o.VesselIds;
        _docTypeIds = o.DocTypeIds;
        _supplierIds = o.SupplierIds;
        _buyerIds = o.BuyerIds;
        _side = o.Side;
        _paymentStatus = o.PaymentStatus;
    }

    private void SetPreset(int months)
    {
        _toDate = DateTime.Today;
        _fromDate = DateTime.Today.AddMonths(-months);
        _ = Apply();
    }

    private async Task Apply()
    {
        var options = new DocumentFilterOptions
        {
            FromDate = _fromDate.HasValue ? DateOnly.FromDateTime(_fromDate.Value) : null,
            ToDate = _toDate.HasValue ? DateOnly.FromDateTime(_toDate.Value) : null,
            VesselIds = _vesselIds.ToList(),
            DocTypeIds = _docTypeIds.ToList(),
            SupplierIds = _supplierIds.ToList(),
            BuyerIds = _buyerIds.ToList(),
            Side = _side,
            PaymentStatus = _paymentStatus
        };

        await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, JsonSerializer.Serialize(options));
        await OnFilterChanged.InvokeAsync(options);
    }

    private string VesselName(int id) =>
        Vessels?.FirstOrDefault(v => v.Id == id)?.Name ?? $"#{id}";

    private string DocTypeName(int id) =>
        DocTypes?.FirstOrDefault(t => t.Id == id)?.Name ?? $"#{id}";

    private string CompanyName(int id) =>
        Companies?.FirstOrDefault(c => c.Id == id)?.Name ?? $"#{id}";
}
<style>
