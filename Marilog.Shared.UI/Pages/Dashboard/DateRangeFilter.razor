    }

        .az-btn-group .mud-button-root:hover {
            background-color: var(--mud-palette-action-default-hover);
            border-color: var(--mud-palette-primary);
        }

    .az-apply {
        border-radius: 2px;
        text-transform: none;
        font-weight: 600;
        min-width: 110px;
    }
</style>