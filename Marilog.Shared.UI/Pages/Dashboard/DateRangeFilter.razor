        background-color: transparent;
        border-radius: 0;
    }

    .az-filter-panels .mud-expand-panel-header {
        background-color: var(--mud-palette-background-grey);
        border-bottom: 1px solid var(--mud-palette-lines-default);
        min-height: 44px;
        padding-top: 6px;
        padding-bottom: 6px;
    }

    .az-filter-panels .mud-expand-panel.mud-panel-expanded {
        margin: 0;
    }

    .az-filter-title {
        font-size: .8125rem;
        font-weight: 600;
        color: var(--mud-palette-text-primary);
    }

    .az-filter-grid {
        padding-top: 4px;
    }

    /* Inputs: square, compact, Azure-like */
    .az-filter .mud-input-outlined-border {
        border-radius: 2px;
        border-color: var(--mud-palette-lines-inputs);
    }

    .az-filter .mud-input-label {
        font-size: .8125rem;
    }

    .az-filter .mud-input-root {
        font-size: .8125rem;
    }

    .az-filter-check .mud-typography {
        font-size: .8125rem;
    }

    /* ── Actions row ───────────────────────────────────────── */
    .az-filter-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .az-filter-label {
        font-size: .6875rem;
        font-weight: 600;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: var(--mud-palette-text-secondary);
    }

    .az-btn-group .mud-button-root {
        border-radius: 2px;
        font-size: .75rem;
        font-weight: 400;
        text-transform: none;
        border-color: var(--mud-palette-lines-default);
        color: var(--mud-palette-text-primary);
    }

        .az-btn-group .mud-button-root:hover {
            background-color: var(--mud-palette-action-default-hover);
            border-color: var(--mud-palette-primary);
        }

    .az-apply {
        border-radius: 2px;
        text-transform: none;
        font-weight: 600;
        min-width: 110px;
    }
</style>