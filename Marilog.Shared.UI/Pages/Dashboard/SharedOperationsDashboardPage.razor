@using Marilog.Contracts.DTOs.Reports.DocumentReports
@using Marilog.Contracts.DTOs.Responses
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.Dashboard

@* ── Page header ───────────────────────────────────────────── *@
<div class="az-page-header mb-4">
    <div>
        <MudText Typo="Typo.h6" Class="az-page-title">Operations Dashboard</MudText>
        <MudText Typo="Typo.body2" Class="az-page-sub">Fleet, voyages, crew and financial overview</MudText>
    </div>
</div>

@* ── Alerts ────────────────────────────────────────────────── *@
@if (Data?.Alerts.Any() == true)
{
    <div class="az-card mb-4">
        <div class="az-card-header">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Size="Size.Small" Color="Color.Warning" />
                <span class="az-card-title">Alerts</span>
            </div>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">
                @Data.Alerts.Count
            </MudChip>
        </div>
        <div class="az-card-body pt-3">
            @foreach (var alert in Data.Alerts)
            {
                <MudAlert Severity="Severity.Warning"
                          Variant="Variant.Outlined"
                          Dense="true"
                          Class="az-alert mb-2">
                    @alert
                </MudAlert>
            }
        </div>
    </div>
}

@* ── KPI tiles ─────────────────────────────────────────────── *@
<div class="az-kpi-grid mb-4">

    <div class="az-kpi az-kpi--primary">
        <div>
            <div class="az-kpi-label">Active Voyages</div>
            <div class="az-kpi-value">@Data?.ActiveVoyages.Count</div>
        </div>
        <MudIcon Icon="@Icons.Material.Filled.Map" Color="Color.Primary" Size="Size.Large" Class="az-kpi-icon" />
    </div>

    <div class="az-kpi az-kpi--info">
        <div>
            <div class="az-kpi-label">Upcoming Arrivals</div>
            <div class="az-kpi-value">@Data?.UpcomingArrivals.Count</div>
        </div>
        <MudIcon Icon="@Icons.Material.Filled.Anchor" Color="Color.Info" Size="Size.Large" Class="az-kpi-icon" />
    </div>

    <div class="az-kpi az-kpi--success">
        <div>
            <div class="az-kpi-label">Cash on Board</div>
            <div class="az-kpi-value">@Data?.TotalCashOnBoard.ToString("N2")</div>
        </div>
        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Color="Color.Success" Size="Size.Large" Class="az-kpi-icon" />
    </div>

    <div class="az-kpi az-kpi--secondary">
        <div>
            <div class="az-kpi-label">Total Cargo</div>
            <div class="az-kpi-value">
                @Data?.TotalCargoMT.ToString("N2") <span class="az-kpi-unit">MT</span>
            </div>
        </div>
        <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Color="Color.Secondary" Size="Size.Large" Class="az-kpi-icon" />
    </div>

    <div class="az-kpi az-kpi--primary">
        <div>
            <div class="az-kpi-label">Vessels</div>
            <div class="az-kpi-value">@Vessels?.Count</div>
        </div>
        <MudIcon Icon="@Icons.Material.Filled.DirectionsBoat" Color="Color.Primary" Size="Size.Large" Class="az-kpi-icon" />
    </div>

</div>

@* ── Filter ────────────────────────────────────────────────── *@
<div class="az-section mb-4">
    <DateRangeFilter Value="Filter"
                     Vessels="VesselLookups"
                     DocTypes="DocTypes"
                     Companies="Companies"
                     OnFilterChanged="OnFilterChanged" />
</div>

@* ── Charts ────────────────────────────────────────────────── *@
<div class="az-section mb-4">
    <FinancialSummaryChart Data="FinancialData" FilterSummary="@GetFilterSummary()" />
</div>

<div class="az-section mb-4">
    <VoyageSummaryChart Data="VoyageData" />
</div>

@* ── Vessels ───────────────────────────────────────────────── *@
<div class="az-card mb-4">
    <div class="az-card-header">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Outlined.DirectionsBoat" Size="Size.Small" Color="Color.Primary" />
            <span class="az-card-title">Vessels</span>
        </div>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Vessels?.Count</MudChip>
    </div>

    <MudTable Items="Vessels" Dense="true" Hover="true" Striped="false"
              Bordered="false" Elevation="0" Class="az-table">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>IMO</MudTh>
            <MudTh>Flag</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudLink @onclick="() => OnVesselClick.InvokeAsync(context.Id)" Class="az-link">
                    @context.Name
                </MudLink>
            </MudTd>
            <MudTd>@context.IMONumber</MudTd>
            <MudTd>@context.FlagCountryName</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <div class="az-empty">
                <MudIcon Icon="@Icons.Material.Outlined.DirectionsBoat" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">No vessels found.</MudText>
            </div>
        </NoRecordsContent>
    </MudTable>
</div>

@* ── Active Voyages ────────────────────────────────────────── *@
<div class="az-card mb-4">
    <div class="az-card-header">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Outlined.Map" Size="Size.Small" Color="Color.Primary" />
            <span class="az-card-title">Active Voyages</span>
        </div>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Data?.ActiveVoyages.Count</MudChip>
    </div>

    <MudTable Items="Data?.ActiveVoyages" Dense="true" Hover="true" Striped="false"
              Bordered="false" Elevation="0" Class="az-table">
        <HeaderContent>
            <MudTh>Voyage No.</MudTh>
            <MudTh>Vessel</MudTh>
            <MudTh>Departure</MudTh>
            <MudTh>Arrival</MudTh>
            <MudTh Class="text-right">Cargo (MT)</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudLink @onclick="() => OnVoyageClick.InvokeAsync(context.VoyageId)" Class="az-link">
                    @context.VoyageNumber
                </MudLink>
            </MudTd>
            <MudTd>@context.VesselName</MudTd>
            <MudTd Class="az-muted">@context.DepartureDate?.ToString("dd MMM yyyy")</MudTd>
            <MudTd Class="az-muted">@context.ArrivalDate?.ToString("dd MMM yyyy")</MudTd>
            <MudTd Class="text-right az-num">@context.CargoQuantityMT?.ToString("N2")</MudTd>
            <MudTd>
                <MudChip T="string" Color="Color.Success" Size="Size.Small"
                         Variant="Variant.Outlined" Class="az-status">
                    @context.Status
                </MudChip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <div class="az-empty">
                <MudIcon Icon="@Icons.Material.Outlined.Map" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">No active voyages.</MudText>
            </div>
        </NoRecordsContent>
    </MudTable>
</div>

@* ── Upcoming Arrivals ─────────────────────────────────────── *@
<div class="az-card mb-4">
    <div class="az-card-header">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Outlined.Anchor" Size="Size.Small" Color="Color.Info" />
            <span class="az-card-title">Upcoming Arrivals</span>
        </div>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Data?.UpcomingArrivals.Count</MudChip>
    </div>

    <MudTable Items="Data?.UpcomingArrivals" Dense="true" Hover="true" Striped="false"
              Bordered="false" Elevation="0" Class="az-table">
        <HeaderContent>
            <MudTh>Voyage No.</MudTh>
            <MudTh>Vessel</MudTh>
            <MudTh>Arrival Port</MudTh>
            <MudTh>ETA</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudLink @onclick="() => OnVoyageClick.InvokeAsync(context.VoyageId)" Class="az-link">
                    @context.VoyageNumber
                </MudLink>
            </MudTd>
            <MudTd>@context.VesselName</MudTd>
            <MudTd>@context.ArrivalPortName</MudTd>
            <MudTd Class="az-muted">@context.ArrivalDate?.ToString("dd MMM yyyy HH:mm")</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <div class="az-empty">
                <MudIcon Icon="@Icons.Material.Outlined.Anchor" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">No upcoming arrivals.</MudText>
            </div>
        </NoRecordsContent>
    </MudTable>
</div>

@* ── Crew Contracts ────────────────────────────────────────── *@
<MudGrid Class="mb-4" Spacing="3">

    <MudItem xs="12" md="6">
        <div class="az-card az-card--warning">
            <div class="az-card-header">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Outlined.HourglassBottom" Size="Size.Small" Color="Color.Warning" />
                    <span class="az-card-title">Expiring Contracts</span>
                </div>
                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">
                    @Data?.ExpiringCrewContracts.Count
                </MudChip>
            </div>

            <MudTable Items="Data?.ExpiringCrewContracts" Dense="true" Hover="true"
                      Striped="false" Bordered="false" Elevation="0" Class="az-table">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Rank</MudTh>
                    <MudTh>Vessel</MudTh>
                    <MudTh>Sign On</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Class="font-weight-medium">@context.PersonFullName</MudTd>
                    <MudTd>@context.RankName</MudTd>
                    <MudTd>@context.VesselName</MudTd>
                    <MudTd Class="az-muted">@context.SignOnDate.ToString("dd MMM yyyy")</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="az-empty">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No expiring contracts.</MudText>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </div>
    </MudItem>

    <MudItem xs="12" md="6">
        <div class="az-card az-card--error">
            <div class="az-card-header">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Outlined.EventBusy" Size="Size.Small" Color="Color.Error" />
                    <span class="az-card-title">Expired Contracts</span>
                </div>
                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined">
                    @Data?.ExpiredCrewContracts.Count
                </MudChip>
            </div>

            <MudTable Items="Data?.ExpiredCrewContracts" Dense="true" Hover="true"
                      Striped="false" Bordered="false" Elevation="0" Class="az-table">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Rank</MudTh>
                    <MudTh>Vessel</MudTh>
                    <MudTh>Sign On</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Class="font-weight-medium">@context.PersonFullName</MudTd>
                    <MudTd>@context.RankName</MudTd>
                    <MudTd>@context.VesselName</MudTd>
                    <MudTd Class="az-muted">@context.SignOnDate.ToString("dd MMM yyyy")</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="az-empty">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No expired contracts.</MudText>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </div>
    </MudItem>

</MudGrid>

@* ── Documents ─────────────────────────────────────────────── *@
<div class="az-card">
    <div class="az-card-header">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Outlined.Description" Size="Size.Small" Color="Color.Primary" />
            <span class="az-card-title">Documents</span>
        </div>

        @if (Data?.Documents?.Any() == true)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                @Data.Documents.Count documents
            </MudChip>
        }
    </div>

    <MudTable Items="GroupedDocuments"
              Dense="true"
              Hover="true"
              Striped="false"
              Bordered="false"
              Elevation="0"
              Class="az-table az-table--grouped documents-table">

        <HeaderContent>
            <MudTh>Doc No.</MudTh>
            <MudTh>Supplier</MudTh>
            <MudTh>Vessel</MudTh>
            <MudTh Class="text-right">Amount</MudTh>
            <MudTh>Date</MudTh>
        </HeaderContent>

        <RowTemplate>

            @if (context.IsGroupHeader)
            {
                <MudTd ColSpan="5" Class="pa-0">
                    <div class="az-group">

                        <div class="d-flex justify-space-between align-center flex-wrap gap-3">

                            <div class="d-flex align-center gap-2">

                                <MudIconButton Icon="@(IsSupplierExpanded(context.SupplierName!)
                                                                                        ? Icons.Material.Filled.KeyboardArrowDown
                                                                                        : Icons.Material.Filled.ChevronRight)"
                                               Size="Size.Small"
                                               OnClick="@(() => ToggleSupplier(context.SupplierName!))" />

                                <MudIcon Icon="@Icons.Material.Outlined.Business"
                                         Size="Size.Small"
                                         Color="Color.Primary" />

                                <div>
                                    <div class="az-group-title">@context.SupplierName</div>
                                    <div class="az-group-sub">@context.DocumentCount documents</div>
                                </div>

                            </div>

                            <div class="d-flex align-center flex-wrap gap-2">

                                <span class="az-group-label">Outstanding</span>

                                @foreach (var total in context.SupplierTotals!)
                                {
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Variant="Variant.Outlined"
                                             Color="Color.Primary"
                                             Class="az-total-chip">
                                        @total.CurrencyCode&nbsp;@total.Amount.ToString("N2")
                                    </MudChip>
                                }

                            </div>

                        </div>

                    </div>
                </MudTd>
            }
            else if (context.Document is not null)
            {
                <MudTd>
                    <MudLink @onclick="() => OnDocumentClick.InvokeAsync(context.Document.Id)"
                             Class="az-link font-weight-medium">
                        @context.Document.DocNumber
                    </MudLink>
                </MudTd>

                <MudTd>
                    <MudText Typo="Typo.body2">@context.Document.SupplierName</MudText>
                </MudTd>

                <MudTd>
                    <MudText Typo="Typo.body2">@context.Document.VesselName</MudText>
                </MudTd>

                <MudTd Class="text-right">
                    <span class="az-num">@context.Document.TotalAmount.ToString("N2")</span>
                    <span class="az-currency">@context.Document.CurrencyCode</span>
                </MudTd>

                <MudTd Class="az-muted">
                    @context.Document.DocDate.ToString("dd MMM yyyy")
                </MudTd>
            }

        </RowTemplate>

        <NoRecordsContent>
            <div class="az-empty">
                <MudIcon Icon="@Icons.Material.Outlined.Description" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">No documents.</MudText>
            </div>
        </NoRecordsContent>

    </MudTable>
</div>
@code {
    [Parameter] public OperationsDashboardResponse? Data { get; set; }
    [Parameter] public EventCallback<int> OnVoyageClick { get; set; }
    [Parameter] public EventCallback<int> OnDocumentClick { get; set; }

    [Parameter] public IReadOnlyList<VesselResponse>? Vessels { get; set; }
    [Parameter] public IReadOnlyList<FinancialChartPointResponse>? FinancialData { get; set; }
    [Parameter] public IReadOnlyList<VoyageChartPointResponse>? VoyageData { get; set; }
    [Parameter] public EventCallback<int> OnVesselClick { get; set; }

    [Parameter] public DocumentFilterOptions Filter { get; set; } = new();
    [Parameter] public IReadOnlyList<VesselLookupResponse>? VesselLookups { get; set; }
    [Parameter] public IReadOnlyList<DocumentTypeResponse>? DocTypes { get; set; }
    [Parameter] public IReadOnlyList<CompanyResponse>? Companies { get; set; }
    [Parameter] public EventCallback<DocumentFilterOptions> OnFilterChanged { get; set; }

    private string GetFilterSummary()
    {
        var parts = new List<string>();

        if (Filter.FromDate.HasValue || Filter.ToDate.HasValue)
        {
            var from = Filter.FromDate?.ToString("dd MMM yyyy") ?? "…";
            var to = Filter.ToDate?.ToString("dd MMM yyyy") ?? "…";
            parts.Add($"{from} – {to}");
        }

        if (Filter.VesselId.HasValue)
        {
            var name = VesselLookups?.FirstOrDefault(v => v.Id == Filter.VesselId)?.Name;
            if (name is not null) parts.Add($"Vessel: {name}");
        }

        if (Filter.DocTypeId.HasValue)
        {
            var name = DocTypes?.FirstOrDefault(t => t.Id == Filter.DocTypeId)?.Name;
            if (name is not null) parts.Add($"Doc Type: {name}");
        }

        if (Filter.SupplierId.HasValue)
        {
            var name = Companies?.FirstOrDefault(c => c.Id == Filter.SupplierId)?.Name;
            if (name is not null) parts.Add($"Supplier: {name}");
        }

        if (Filter.BuyerId.HasValue)
        {
            var name = Companies?.FirstOrDefault(c => c.Id == Filter.BuyerId)?.Name;
            if (name is not null) parts.Add($"Buyer: {name}");
        }

        if (Filter.Side.HasValue)
            parts.Add($"Type: {Filter.Side}");

        if (Filter.UnpaidOnly)
            parts.Add("Unpaid Only");

        return parts.Count == 0 ? "No filters applied" : string.Join("  •  ", parts);
    }

    private IReadOnlyList<GroupedDocumentRow> GroupedDocuments =>
        Data?.Documents?
            .GroupBy(x => x.SupplierName)
            .SelectMany(group =>
            {
                var rows = new List<GroupedDocumentRow>
                {
                new()
                {
                    IsGroupHeader = true,
                    SupplierName = group.Key,
                    DocumentCount = group.Count(),
                    SupplierTotals = group
                        .GroupBy(x => x.CurrencyCode)
                        .Select(currencyGroup => new CurrencyTotal
                        {
                            CurrencyCode = currencyGroup.Key,
                            Amount = currencyGroup.Sum(x => x.TotalAmount)
                        })
                        .OrderBy(x => x.CurrencyCode)
                        .ToList()
                }
                };

                if (IsSupplierExpanded(group.Key))
                {
                    rows.AddRange(
                        group.Select(document => new GroupedDocumentRow
                        {
                            Document = document
                        }));
                }

                return rows;
            })
            .ToList()
        ?? [];

    private sealed class GroupedDocumentRow
    {
        public bool IsGroupHeader { get; init; }

        public string? SupplierName { get; init; }

        public int DocumentCount { get; init; }

        public IReadOnlyList<CurrencyTotal>? SupplierTotals { get; init; }

        public DocumentResponse? Document { get; init; }
    }

    private sealed class CurrencyTotal
    {
        public string CurrencyCode { get; init; } = string.Empty;

        public decimal Amount { get; init; }
    }

    private readonly HashSet<string> _collapsedSuppliers = [];

    private bool IsSupplierExpanded(string supplierName)
        => !_collapsedSuppliers.Contains(supplierName);

    private void ToggleSupplier(string supplierName)
    {
        if (!_collapsedSuppliers.Add(supplierName))
            _collapsedSuppliers.Remove(supplierName);
    }
}


<style>
    /* ── Page header ───────────────────────────────────────── */
    .az-page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }

    .az-page-title {
        font-weight: 600;
        line-height: 1.3;
    }

    .az-page-sub {
        color: var(--mud-palette-text-secondary);
        font-size: .8125rem;
    }

    /* ── Card (Azure blade panel) ──────────────────────────── */
    .az-card {
        background-color: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 2px;
        overflow: hidden;
        height: 100%;
    }

    .az-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 16px;
        background-color: var(--mud-palette-background-grey);
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }

    .az-card-title {
        font-size: .875rem;
        font-weight: 600;
        color: var(--mud-palette-text-primary);
    }

    .az-card-body {
        padding: 0 16px 16px;
    }

    .az-card--warning .az-card-header {
        border-bottom-color: var(--mud-palette-warning);
    }

    .az-card--error .az-card-header {
        border-bottom-color: var(--mud-palette-error);
    }

    /* ── Section wrapper (charts / filter) ─────────────────── */
    .az-section > * {
        border-radius: 2px !important;
    }

    /* ── KPI tiles ─────────────────────────────────────────── */
    .az-kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 12px;
    }

    .az-kpi {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 16px 14px 20px;
        background-color: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 2px;
        transition: border-color .15s ease, background-color .15s ease;
    }

        .az-kpi::before {
            content: "";
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            width: 3px;
            background-color: var(--mud-palette-primary);
        }

        .az-kpi:hover {
            border-color: var(--mud-palette-primary);
            background-color: var(--mud-palette-background-grey);
        }

    .az-kpi--info::before {
        background-color: var(--mud-palette-info);
    }

    .az-kpi--success::before {
        background-color: var(--mud-palette-success);
    }

    .az-kpi--secondary::before {
        background-color: var(--mud-palette-secondary);
    }

    .az-kpi-label {
        font-size: .6875rem;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--mud-palette-text-secondary);
        margin-bottom: 4px;
    }

    .az-kpi-value {
        font-size: 1.75rem;
        font-weight: 600;
        line-height: 1.15;
        color: var(--mud-palette-text-primary);
        font-variant-numeric: tabular-nums;
    }

    .az-kpi-unit {
        font-size: .75rem;
        font-weight: 400;
        color: var(--mud-palette-text-secondary);
    }

    .az-kpi-icon {
        opacity: .45;
    }

    /* ── Tables ────────────────────────────────────────────── */
    .az-table .mud-table-head th {
        background-color: var(--mud-palette-background-grey);
        color: var(--mud-palette-text-secondary);
        font-size: .6875rem;
