@using Marilog.Contracts.DTOs.Responses
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.Dashboard

<div class="az-card az-chart-card mb-4">

    @* ── Header ────────────────────────────────────────────── *@
    <div class="az-card-header">
        <div class="d-flex align-center gap-2 flex-wrap">
            <MudIcon Icon="@Icons.Material.Outlined.BarChart" Size="Size.Small" Color="Color.Primary" />
            <span class="az-card-title">Revenues and Expenses</span>

            @if (Data is { Count: > 0 } && !string.IsNullOrEmpty(Data[0].CurrencyCode))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="az-currency-chip">
                    @Data[0].CurrencyCode
                </MudChip>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(FilterSummary))
        {
            <div class="az-chart-filter" title="@FilterSummary">
                <MudIcon Icon="@Icons.Material.Outlined.FilterAlt" Size="Size.Small" />
                <span>@FilterSummary</span>
            </div>
        }
    </div>

    @if (Data is null || Data.Count == 0)
    {
        <div class="az-empty">
            <MudIcon Icon="@Icons.Material.Outlined.QueryStats" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">There is no data for this period.</MudText>
        </div>
    }
    else
    {
        @* ── Totals strip ──────────────────────────────────── *@
        <div class="az-metrics">

            <div class="az-metric az-metric--revenue">
                <div class="az-metric-label">Total Revenues</div>
                <div class="az-metric-value">@Data.Sum(d => d.Revenue).ToString("N2")</div>
            </div>

            <div class="az-metric az-metric--expense">
                <div class="az-metric-label">Total Expenses</div>
                <div class="az-metric-value">@Data.Sum(d => d.Expense).ToString("N2")</div>
            </div>

            <div class="az-metric @(Data.Sum(d => d.Revenue - d.Expense) >= 0 ? "az-metric--net-up" : "az-metric--net-down")">
                <div class="az-metric-label">Net Result</div>
                <div class="az-metric-value d-flex align-center gap-1">
                    <MudIcon Size="Size.Small"
                             Icon="@(Data.Sum(d => d.Revenue - d.Expense) >= 0
                                                           ? Icons.Material.Filled.TrendingUp
                                                           : Icons.Material.Filled.TrendingDown)" />
                    @Data.Sum(d => d.Revenue - d.Expense).ToString("N2")
                </div>
            </div>

            <div class="az-metric">
                <div class="az-metric-label">Periods</div>
                <div class="az-metric-value">@Data.Count</div>
            </div>

        </div>

        @* ── Chart ─────────────────────────────────────────── *@
        <div class="az-chart">
            <MudChart ChartType="ChartType.Bar"
                      ChartSeries="@_series"
                      ChartLabels="@_labels"
                      ChartOptions="@_options"
                      Width="100%" Height="340px" />
        </div>
    }

</div>
@code {
    [Parameter] public IReadOnlyList<FinancialChartPointResponse>? Data { get; set; }
    [Parameter] public string? FilterSummary { get; set; }

    private List<ChartSeries<decimal>> _series = new();
    private string[] _labels = Array.Empty<string>();

    // أخضر = إيرادات، أحمر = مصاريف
    private BarChartOptions _options = new()
    {
        YAxisTicks = 5,
        YAxisFormat = "#,##0",
        BarWidthRatio = 0.55,
        ChartPalette = new[] { "#2E7D32", "#C62828" }
    };

    protected override void OnParametersSet()
    {
        if (Data is null || Data.Count == 0) return;

        _labels = Data.Select(d => d.PeriodLabel ?? string.Empty).ToArray();

        _series = new List<ChartSeries<decimal>>
        {
            new() { Name = "Revenues", Data = Data.Select(d => d.Revenue).ToArray() },
            new() { Name = "Expenses", Data = Data.Select(d => d.Expense).ToArray() }
        };
    }
}
<style>
    /* ── Card ──────────────────────────────────────────────── */
    .az-card {
        background-color: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 2px;
        overflow: hidden;
    }

    .az-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        padding: 10px 16px;
        background-color: var(--mud-palette-background-grey);
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }

    .az-card-title {
        font-size: .875rem;
        font-weight: 600;
        color: var(--mud-palette-text-primary);
    }

    .az-currency-chip {
        border-radius: 2px;
        height: 20px;
        font-size: .6875rem;
        font-weight: 600;
    }

    .az-chart-filter {
        display: flex;
        align-items: center;
        gap: 6px;
        max-width: 55%;
        font-size: .6875rem;
        color: var(--mud-palette-text-secondary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        .az-chart-filter span {
            overflow: hidden;
            text-overflow: ellipsis;
        }

    /* ── Totals strip ──────────────────────────────────────── */
    .az-metrics {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }

    .az-metric {
        position: relative;
        padding: 12px 16px;
        border-right: 1px solid var(--mud-palette-lines-default);
    }

        .az-metric:last-child {
            border-right: none;
        }

        .az-metric::before {
            content: "";
            position: absolute;
            top: 12px;
            bottom: 12px;
            left: 0;
            width: 3px;
            background-color: transparent;
        }

    .az-metric--revenue::before,
    .az-metric--net-up::before {
        background-color: var(--mud-palette-success);
    }

    .az-metric--expense::before,
    .az-metric--net-down::before {
        background-color: var(--mud-palette-error);
    }

    .az-metric-label {
        font-size: .6875rem;
        font-weight: 600;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: var(--mud-palette-text-secondary);
        margin-bottom: 4px;
    }

    .az-metric-value {
        font-size: 1.125rem;
        font-weight: 600;
        line-height: 1.2;
        font-variant-numeric: tabular-nums;
        color: var(--mud-palette-text-primary);
    }

    .az-metric--revenue .az-metric-value,
    .az-metric--net-up .az-metric-value {
        color: var(--mud-palette-success);
    }

    .az-metric--expense .az-metric-value,
    .az-metric--net-down .az-metric-value {
        color: var(--mud-palette-error);
    }

    /* ── Chart canvas ──────────────────────────────────────── */
    .az-chart {
        padding: 16px 8px 8px;
    }

        /* axis + labels */
        .az-chart svg text {
            fill: var(--mud-palette-text-secondary);
            font-size: 11px;
            font-weight: 500;
        }

        /* grid lines — defensive: no-op if the class is absent */
        .az-chart svg [class*="grid"] line,
        .az-chart svg [class*="grid"] path {
            stroke: var(--mud-palette-lines-default);
            stroke-width: 1;
            opacity: .7;
        }

        .az-chart .mud-chart-legend {
            justify-content: flex-start;
            padding-left: 8px;
        }

            .az-chart .mud-chart-legend .mud-typography {
                font-size: .75rem;
                font-weight: 500;
                color: var(--mud-palette-text-secondary);
            }

        /* bar hover emphasis */
        .az-chart svg path {
            transition: opacity .15s ease;
        }

        .az-chart svg:hover path {
            opacity: .85;
        }

        .az-chart svg path:hover {
            opacity: 1;
        }

    /* ── Empty state ───────────────────────────────────────── */
    .az-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 48px 0;
    }
</style>