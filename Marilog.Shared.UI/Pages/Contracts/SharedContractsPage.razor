@using Marilog.Contracts.Common
@using Marilog.Contracts.DTOs.Reports.Contract
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.Contracts

<div class="az-contracts">
<MudPaper Class="pa-4" Elevation="0">
    <MudText Typo="Typo.h5" Class="mb-2">Contracts</MudText>

    @* ── Command bar ── *@
    <div class="az-commandbar">
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => OnAddClicked.InvokeAsync())">
            New contract
        </MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="@(() => OnRefreshClicked.InvokeAsync())">
            Refresh
        </MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Settings"
                   OnClick="@(() => OnSettingsClicked.InvokeAsync())">
            Types &amp; roles
        </MudButton>
        <MudSpacer />
        <MudSelect T="int" Value="@(ContractTypeId ?? 0)" ValueChanged="@((int v) => OnTypeChanged.InvokeAsync(v == 0 ? null : v))"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                   Style="max-width:200px" Class="mr-2">
            <MudSelectItem Value="0">All types</MudSelectItem>
            @foreach (var t in ContractTypes)
            {
                <MudSelectItem Value="@t.Id">@t.Name@(t.IsActive ? "" : " (inactive)")</MudSelectItem>
            }
        </MudSelect>
        <MudTextField T="string" @bind-Value="_search"
                      Placeholder="Search no., type, notes..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      DebounceInterval="400"
                      OnDebounceIntervalElapsed="@((string v) => OnSearchChanged.InvokeAsync(v))"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Style="max-width:250px" />
    </div>

    @* ── Status pivot (counts from the report) ── *@
    <div class="az-pivot mb-2">
        @Pivot("", "All", Report?.TotalContracts)
        @foreach (var status in ContractUi.Statuses)
        {
            @Pivot(status, status, Count(status))
        }
        @Pivot(ExpiringFilter, "Expiring ≤ 30d", Report?.ExpiringWithin30Days.Count, Color.Warning)
    </div>

    @if (IsLoading)
    {
        <MudProgressLinear Indeterminate="true" Size="Size.Small" />
    }

    <ContractTable Items="@(Paged?.Items ?? [])"
                   SelectedId="@_selectedId"
                   OnRowSelected="@HandleRowSelectedAsync"
                   OnEditClicked="@OnEditClicked"
                   OnManageAttachedFilesClicked="@OnManageAttachedFilesClicked" />

    @if (Paged is not null && Paged.TotalPages > 1)
    {
        <div class="d-flex align-center justify-end gap-2 mt-2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Page @Paged.Page of @Paged.TotalPages · @Paged.TotalCount contracts
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                           Disabled="!Paged.HasPrev" OnClick="@(() => OnPrevPage.InvokeAsync())" />
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                           Disabled="!Paged.HasNext" OnClick="@(() => OnNextPage.InvokeAsync())" />
        </div>
    }

    <MudDrawer Open="@_isDrawerOpen" OpenChanged="@OnDrawerOpenChanged"
               Anchor="Anchor.Right"
               Variant="DrawerVariant.Temporary"
               Elevation="0"
               Width="600px"
               Style="border-left:1px solid var(--mud-palette-lines-default);">
        @if (_selectedDetail is not null)
        {
            <ContractDetails Contract="@_selectedDetail"
                             IsLoading="@_isLoadingDetail"
                             OnClose="@CloseDetail"
                             OnEditClicked="@OnEditClicked"
                             OnDeleteClicked="@OnDeleteClicked"
                             OnActivateClicked="@OnActivateClicked"
                             OnSuspendClicked="@OnSuspendClicked"
                             OnTerminateClicked="@OnTerminateClicked"
                             OnMarkExpiredClicked="@OnMarkExpiredClicked"
                             OnCharterTermsClicked="@OnCharterTermsClicked"
                             OnManageAttachedFilesClicked="@OnManageAttachedFilesClicked"
                             OnCommentsClicked="@OnCommentsClicked"
                             OnAddPartyClicked="@OnAddPartyClicked"
                             OnRemovePartyClicked="@OnRemovePartyClicked"
                             OnRecordAmendmentClicked="@OnRecordAmendmentClicked"
                             OnChangeExpiryClicked="@OnChangeExpiryClicked" />
        }
    </MudDrawer>
</MudPaper>
</div>

<ContractsStyles/>

@code {
    public const string ExpiringFilter = "Expiring";

    [Parameter] public PagedResponse<ContractSummary>? Paged { get; set; }
    [Parameter] public ContractReport? Report { get; set; }
    [Parameter] public IReadOnlyList<ContractLookupResponse> ContractTypes { get; set; } = [];
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public Func<int, Task<ContractDetailResponse?>>? GetContractDetail { get; set; }

    // Current filter (owned by the host)
    [Parameter] public int? ContractTypeId { get; set; }
    [Parameter] public string StatusFilter { get; set; } = string.Empty;

    [Parameter] public EventCallback OnAddClicked { get; set; }
    [Parameter] public EventCallback OnRefreshClicked { get; set; }
    [Parameter] public EventCallback OnSettingsClicked { get; set; }
    [Parameter] public EventCallback<string> OnSearchChanged { get; set; }
    [Parameter] public EventCallback<int?> OnTypeChanged { get; set; }
    [Parameter] public EventCallback<string> OnStatusChanged { get; set; }
    [Parameter] public EventCallback OnPrevPage { get; set; }
    [Parameter] public EventCallback OnNextPage { get; set; }

    [Parameter] public EventCallback<int> OnEditClicked { get; set; }
    [Parameter] public EventCallback<int> OnDeleteClicked { get; set; }
    [Parameter] public EventCallback<int> OnActivateClicked { get; set; }
    [Parameter] public EventCallback<int> OnSuspendClicked { get; set; }
    [Parameter] public EventCallback<int> OnTerminateClicked { get; set; }
    [Parameter] public EventCallback<int> OnMarkExpiredClicked { get; set; }
    [Parameter] public EventCallback<int> OnCharterTermsClicked { get; set; }
    [Parameter] public EventCallback<(int entityId, EntityType entityType)> OnManageAttachedFilesClicked { get; set; }
    [Parameter] public EventCallback<(int entityId, EntityType entityType)> OnCommentsClicked { get; set; }
    [Parameter] public EventCallback<int> OnAddPartyClicked { get; set; }
    [Parameter] public EventCallback<(int ContractId, ContractPartyResponse Party)> OnRemovePartyClicked { get; set; }
    [Parameter] public EventCallback<int> OnRecordAmendmentClicked { get; set; }
    [Parameter] public EventCallback<ContractDetailResponse> OnChangeExpiryClicked { get; set; }

    private string _search = string.Empty;
    private int? _selectedId;
    private ContractDetailResponse? _selectedDetail;
    private bool _isLoadingDetail;
    private bool _isDrawerOpen;

    private int? Count(string status) => Report is null ? null : status switch
    {
        "Draft" => Report.DraftContracts,
        "Active" => Report.ActiveContracts,
        "Suspended" => Report.SuspendedContracts,
        "Expired" => Report.ExpiredContracts,
        "Terminated" => Report.TerminatedContracts,
        _ => null
    };

    private RenderFragment Pivot(string value, string label, int? count, Color color = Color.Default) => __builder =>
    {
        var active = StatusFilter == value;
        <MudButton Variant="Variant.Text" Size="Size.Small"
                   Color="@(active ? Color.Primary : color)"
                   Class="@(active ? "az-pivot-active" : "")"
                   OnClick="@(() => OnStatusChanged.InvokeAsync(value))">
            @label@(count is null ? "" : $" ({count})")
        </MudButton>
    };

    private async Task HandleRowSelectedAsync(ContractSummary item)
    {
        if (_isDrawerOpen && _selectedId == item.Id)
        {
            CloseDetail();
            return;
        }

        _selectedId = item.Id;
        _isLoadingDetail = true;
        _isDrawerOpen = true;
        StateHasChanged();

        var detail = GetContractDetail is null ? null : await GetContractDetail(item.Id);

        // Ignore a stale result if the user picked another row meanwhile.
        if (_selectedId == item.Id)
            _selectedDetail = detail;

        _isLoadingDetail = false;
        if (detail is null)
            CloseDetail();
    }

    /// <summary>Lets the host refresh the open drawer after an action.</summary>
    public async Task RefreshSelectedIfOpenAsync()
    {
        if (!_isDrawerOpen || _selectedId is not int id || GetContractDetail is null)
            return;

        _isLoadingDetail = true;
        StateHasChanged();

        var detail = await GetContractDetail(id);
        _isLoadingDetail = false;

        if (detail is null)
            CloseDetail();
        else
            _selectedDetail = detail;

        StateHasChanged();
    }

    private void OnDrawerOpenChanged(bool open)
    {
        if (!open)
            CloseDetail();
    }

    public void CloseDetail()
    {
        _selectedId = null;
        _isDrawerOpen = false;
        StateHasChanged();
    }
}
