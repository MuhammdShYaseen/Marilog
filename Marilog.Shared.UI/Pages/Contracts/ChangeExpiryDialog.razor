@using Marilog.Contracts.DTOs.Requests.ContractDTOs
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.Contracts

@* Recorded as an amendment on the server ("Extended / Reduced / Set expiry date"). *@
<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Current expiry: <b>@(CurrentExpiry?.ToString("dd MMM yyyy") ?? "none")</b>
        </MudText>
        <MudDatePicker @bind-Date="_newExpiry"
                       Label="New expiry date"
                       Required="true"
                       DateFormat="dd MMM yyyy"
                       Error="@_invalid"
                       ErrorText="Must be after the effective date"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_newExpiry is null || _invalid)"
                   OnClick="Submit">
            Change
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public DateOnly? CurrentExpiry { get; set; }
    [Parameter] public DateOnly EffectiveDate { get; set; }

    private DateTime? _newExpiry;

    private bool _invalid =>
        _newExpiry.HasValue && DateOnly.FromDateTime(_newExpiry.Value) <= EffectiveDate;

    protected override void OnInitialized() =>
        _newExpiry = CurrentExpiry?.ToDateTime(TimeOnly.MinValue);

    private void Cancel() => MudDialog.Cancel();

    private void Submit() => MudDialog.Close(DialogResult.Ok(
        new ChangeExpiryRequest(DateOnly.FromDateTime(_newExpiry!.Value))));
}
