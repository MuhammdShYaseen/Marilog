@using Marilog.Contracts.DTOs.Requests.ContractDTOs
@using Marilog.Contracts.DTOs.Responses
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.Contracts

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudAutocomplete T="CompanyResponse" @bind-Value="_company"
                                 Label="Company"
                                 Required="true"
                                 SearchFunc="SearchCompanies"
                                 ToStringFunc="@(c => c?.Name)"
                                 ResetValueOnEmptyText="true"
                                 MaxItems="50"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="int" @bind-Value="_roleId"
                           Label="Role"
                           Required="true"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           HelperText="@(Roles.Any() ? null : "No roles yet — add them under Types & roles")">
                    @foreach (var role in Roles.Where(r => r.IsActive))
                    {
                        <MudSelectItem Value="@role.Id">@role.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_company is null || _roleId <= 0)"
                   OnClick="Submit">
            Add
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public IReadOnlyList<CompanyResponse> Companies { get; set; } = [];
    [Parameter] public IReadOnlyList<ContractLookupResponse> Roles { get; set; } = [];

    private CompanyResponse? _company;
    private int _roleId;

    private Task<IEnumerable<CompanyResponse>> SearchCompanies(string? text, CancellationToken token)
    {
        IEnumerable<CompanyResponse> result = string.IsNullOrWhiteSpace(text)
            ? Companies
            : Companies.Where(c => c.Name.Contains(text, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(result);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit() => MudDialog.Close(DialogResult.Ok(new PartyRequest(_company!.Id, _roleId)));
}
