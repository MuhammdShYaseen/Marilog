@using Marilog.Contracts.DTOs.EmailNotificationDTOs
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.EmailNotification
<MudStack Spacing="4">

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h5">Notification Settings</MudText>
    </MudStack>

    @if (IsLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-8">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </MudStack>
    }
    else
    {
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">

            <MudTabPanel Text="Alerts" Icon="@Icons.Material.Filled.NotificationsActive">
                <SharedNotificationAlertsPanel Settings="Settings"
                                                IsDirty="IsSettingsDirty"
                                                IsSaving="IsSavingSettings"
                                                OnChanged="OnSettingsChanged"
                                                OnSave="OnSaveSettings" />
            </MudTabPanel>

            <MudTabPanel Text="Sender Email" Icon="@Icons.Material.Filled.Email">
                <SharedNotificationSenderEmailPanel Settings="SenderSettings"
                                                     IsDirty="IsSenderDirty"
                                                     IsSaving="IsSavingSender"
                                                     OnChanged="OnSenderChanged"
                                                     OnSave="OnSaveSender" />
            </MudTabPanel>

            <MudTabPanel Text="Recipients" Icon="@Icons.Material.Filled.People">
                <SharedNotificationRecipientsPanel Recipients="Recipients"
                                                    OnAdd="OnAddRecipient"
                                                    OnRename="OnRenameRecipient"
                                                    OnRemove="OnRemoveRecipient" />
            </MudTabPanel>

        </MudTabs>
    }

</MudStack>

@code {
    [Parameter, EditorRequired]
    public bool IsLoading { get; set; }

    [Parameter, EditorRequired]
    public NotificationSettingsOptions Settings { get; set; } = default!;

    [Parameter, EditorRequired]
    public bool IsSettingsDirty { get; set; }

    [Parameter, EditorRequired]
    public bool IsSavingSettings { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnSettingsChanged { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<NotificationSettingsOptions> OnSaveSettings { get; set; }

    [Parameter, EditorRequired]
    public NotificationSenderEmailSettingsOptions SenderSettings { get; set; } = default!;

    [Parameter, EditorRequired]
    public bool IsSenderDirty { get; set; }

    [Parameter, EditorRequired]
    public bool IsSavingSender { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnSenderChanged { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<NotificationSenderEmailSettingsOptions> OnSaveSender { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<string> Recipients { get; set; } = Array.Empty<string>();

    [Parameter, EditorRequired]
    public EventCallback<string> OnAddRecipient { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<(string CurrentEmail, string NewEmail)> OnRenameRecipient { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<string> OnRemoveRecipient { get; set; }
}
