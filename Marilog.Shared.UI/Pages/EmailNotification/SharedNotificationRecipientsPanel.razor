@using MudBlazor
@namespace Marilog.Shared.UI.Pages.EmailNotification

<MudStack Spacing="4">

    <MudText Typo="Typo.body2" Color="Color.Secondary">
        Everyone in this list receives the notification emails enabled in the Alerts tab.
    </MudText>

    <MudPaper Outlined="true" Class="pa-4">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
            <MudTextField T="string" @bind-Value="_newEmail"
                          Label="Add recipient"
                          Placeholder="name@company.com"
                          Immediate="true"
                          Error="@(_error is not null)"
                          ErrorText="@_error"
                          FullWidth="true" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@_isBusy"
                       OnClick="AddAsync"
                       Class="mt-1">
                Add
            </MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-0">
        <MudList T="string" Dense="true">

            @if (Recipients.Count == 0)
            {
                <MudListItem T="string">
                    <MudText Color="Color.Secondary">No recipients added yet.</MudText>
                </MudListItem>
            }

            @foreach (var email in Recipients)
            {
                <MudListItem T="string">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">

                        @if (_editingEmail == email)
                        {
                            <MudTextField T="string" @bind-Value="_editValue" Immediate="true" FullWidth="true" />
                            <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                                           Disabled="@_isBusy" OnClick="@(() => ConfirmRenameAsync(email))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                           OnClick="@(() => _editingEmail = null)" />
                        }
                        else
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Primary" />
                                <MudText>@email</MudText>
                            </MudStack>

                            <MudStack Row="true" Spacing="1">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                               Disabled="@_isBusy" OnClick="@(() => StartRename(email))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               Disabled="@_isBusy" OnClick="@(() => RemoveAsync(email))" />
                            </MudStack>
                        }

                    </MudStack>
                </MudListItem>
            }

        </MudList>
    </MudPaper>

</MudStack>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Recipients { get; set; } = Array.Empty<string>();

    [Parameter, EditorRequired]
    public EventCallback<string> OnAdd { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<(string CurrentEmail, string NewEmail)> OnRename { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<string> OnRemove { get; set; }

    private string _newEmail = string.Empty;
    private string? _error;
    private bool _isBusy;

    private string? _editingEmail;
    private string _editValue = string.Empty;

    private static bool IsValidEmail(string value) =>
        !string.IsNullOrWhiteSpace(value) && value.Contains('@') && value.Contains('.');

    private async Task AddAsync()
    {
        if (!IsValidEmail(_newEmail))
        {
            _error = "Enter a valid email address.";
            return;
        }

        if (Recipients.Contains(_newEmail, StringComparer.OrdinalIgnoreCase))
        {
            _error = "This email is already in the list.";
            return;
        }

        _error = null;
        _isBusy = true;

        await OnAdd.InvokeAsync(_newEmail.Trim());

        _newEmail = string.Empty;
        _isBusy = false;
    }

    private void StartRename(string email)
    {
        _editingEmail = email;
        _editValue = email;
    }

    private async Task ConfirmRenameAsync(string currentEmail)
    {
        if (!IsValidEmail(_editValue))
            return;

        _isBusy = true;
        await OnRename.InvokeAsync((currentEmail, _editValue.Trim()));
        _isBusy = false;
        _editingEmail = null;
    }

    private async Task RemoveAsync(string email)
    {
        _isBusy = true;
        await OnRemove.InvokeAsync(email);
        _isBusy = false;
    }
}
