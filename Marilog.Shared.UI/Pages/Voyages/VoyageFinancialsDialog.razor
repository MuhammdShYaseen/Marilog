
@using MudBlazor
@using global::Marilog.Contracts.DTOs.Requests.VoyageDTOs
@using global::Marilog.Contracts.DTOs.Responses
@namespace Marilog.Shared.UI.Pages.Voyages

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Outlined.AccountBalanceWallet" Color="Color.Primary" Size="Size.Small" />
            <MudText Typo="Typo.h6">Master account — @Voyage.VoyageNumber</MudText>
        </div>
    </TitleContent>

    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudNumericField T="decimal"
                                 @bind-Value="_previousMasterBalance"
                                 Label="Previous master balance"
                                 HelperText="Can be negative."
                                 Min="-MaxAmount"
                                 Max="MaxAmount"
                                 Format="N2"
                                 HideSpinButtons="true"
                                 Adornment="Adornment.End"
                                 AdornmentText="USD"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal"
                                 @bind-Value="_cashOnBoard"
                                 Label="Cash on board"
                                 Min="0"
                                 Max="MaxAmount"
                                 Format="N2"
                                 HideSpinButtons="true"
                                 Adornment="Adornment.End"
                                 AdornmentText="USD"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal"
                                 @bind-Value="_cigarettesOnBoard"
                                 Label="Cigarettes on board"
                                 Min="0"
                                 Max="MaxAmount"
                                 Format="N2"
                                 HideSpinButtons="true"
                                 Adornment="Adornment.End"
                                 AdornmentText="USD"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="_saving" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!IsValid || _saving)"
                   OnClick="SubmitAsync">
            @(_saving ? "Saving…" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public VoyageResponse Voyage { get; set; } = default!;

    /// <summary>Host performs the update; returns true on success. Dialog stays open on failure.</summary>
    [Parameter] public Func<UpdateVoyageFinancialsRequest, Task<bool>>? OnSave { get; set; }

    // Matches decimal(12,2) in VoyageConfiguration.
    private const decimal MaxAmount = 9_999_999_999.99m;

    private decimal _previousMasterBalance;
    private decimal _cashOnBoard;
    private decimal _cigarettesOnBoard;
    private bool _saving;

    private bool HasChanges =>
        _previousMasterBalance != Voyage.PreviousMasterBalance ||
        _cashOnBoard != Voyage.CashOnBoard ||
        _cigarettesOnBoard != Voyage.CigarettesOnBoard;

    private bool IsValid => HasChanges && _cashOnBoard >= 0 && _cigarettesOnBoard >= 0;

    protected override void OnInitialized()
    {
        _previousMasterBalance = Voyage.PreviousMasterBalance;
        _cashOnBoard = Voyage.CashOnBoard;
        _cigarettesOnBoard = Voyage.CigarettesOnBoard;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        if (!IsValid || _saving || OnSave is null) return;

        _saving = true;
        var ok = await OnSave(new UpdateVoyageFinancialsRequest(
            CashOnBoard: _cashOnBoard,
            CigarettesOnBoard: _cigarettesOnBoard,
            PreviousMasterBalance: _previousMasterBalance));
        _saving = false;

        if (ok) MudDialog.Close(DialogResult.Ok(true));
    }
}