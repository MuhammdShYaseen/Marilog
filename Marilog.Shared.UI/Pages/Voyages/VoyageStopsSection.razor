@using MudBlazor
@using global::Marilog.Contracts.DTOs.Responses
@using global::Marilog.Kernel.Enums
@namespace Marilog.Shared.UI.Pages.Voyages

<VoyagePanel Title="Port stops">
    <Actions>
        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.AddLocationAlt"
                   Disabled="@(IsReadOnly || IsBusy)"
                   OnClick="OnAddClicked">
            Add stop
        </MudButton>
    </Actions>

    <ChildContent>
        @if (IsReadOnly)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2" Style="display:block">
                Cancelled voyages are read-only.
            </MudText>
        }

        <div style="overflow-x:auto">
            <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                <thead>
                    <tr>
                        <th style="@ThStyle;width:48px">#</th>
                        <th style="@ThStyle">Port</th>
                        <th style="@ThStyle">Arrival</th>
                        <th style="@ThStyle">Departure</th>
                        <th style="@ThStyle">Time in port</th>
                        <th style="@ThStyle">Purpose</th>
                        <th style="@ThStyle">Notes</th>
                        <th style="@ThStyle;width:104px"></th>
                    </tr>
                </thead>
                <tbody>


                    @* ── Intermediate stops ── *@
                    @if (Voyage.Stops.Count == 0)
                    {
                        <tr>
                            <td colspan="8" style="@MutedStyle">No stops yet.</td>
                        </tr>
                    }
                    else
                    {
                        VoyageStopResponse? previous = null;
                        @foreach (var stop in OrderedStops)
                        {
                            var current = stop;
                            var warnings = Warnings(current, previous);
                            <tr>
                                <td><span style="@BadgeStyle">@current.StopOrder</span></td>
                                <td>
                                    <div class="d-flex align-center gap-1">
                                        <span>@current.PortName</span>
                                        <CommentBadge EntityType="EntityType.VoyageStop" EntityId="@current.StopId" />
                                        @if (warnings.Count > 0)
                                        {
                                            <MudTooltip Text="@string.Join(" ", warnings)">
                                                <MudIcon Icon="@Icons.Material.Outlined.WarningAmber"
                                                         Color="Color.Warning"
                                                         Size="Size.Small" />
                                            </MudTooltip>
                                        }
                                    </div>
                                </td>
                                <td>@Fmt(current.ArrivalDate)</td>
                                <td>@Fmt(current.DepartureDate)</td>
                                <td>@(Duration(current.ArrivalDate, current.DepartureDate) ?? "—")</td>
                                <td>@(current.PurposeOfCall ?? "—")</td>
                                <td style="@NotesStyle" title="@current.Notes">@(current.Notes ?? "—")</td>
                                <td>
                                    <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center">
                                        @* Files and comments stay available on read-only (cancelled) voyages. *@
                                        <MudIconButton Icon="@Icons.Material.Filled.Receipt"
                                                       Size="Size.Small"
                                                       title="Files"
                                                       OnClick="@(() => OnFilesClicked.InvokeAsync(current))" />
                                        <MudIconButton Icon="@Icons.Material.Outlined.Comment"
                                                       Size="Size.Small"
                                                       title="Comments"
                                                       OnClick="@(() => OnCommentsClicked.InvokeAsync(current))" />

                                        <MudMenu Icon="@Icons.Material.Filled.MoreHoriz"
                                                 Size="Size.Small"
                                                 Disabled="@(IsReadOnly || IsBusy)"
                                                 AnchorOrigin="Origin.BottomRight"
                                                 TransformOrigin="Origin.TopRight">

                                            <MudMenuItem Icon="@Icons.Material.Outlined.Inventory2"
                                                         OnClick="@(() => OnAddCargoClicked.InvokeAsync(current))">
                                                Add cargo
                                            </MudMenuItem>

                                            <MudMenuItem Icon="@Icons.Material.Outlined.Edit"
                                                         OnClick="@(() => OnEditClicked.InvokeAsync(current))">
                                                Edit
                                            </MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Outlined.Delete"
                                                         OnClick="@(() => OnRemoveClicked.InvokeAsync(current))">
                                                Remove
                                            </MudMenuItem>
                                        </MudMenu>
                                    </MudStack>
                                </td>
                            </tr>
                            if (current.Cargo.Count > 0)
                            {
                                <tr>
                                    <td></td>
                                    <td colspan="7" style="padding-top:0">
                                        @foreach (var line in current.Cargo)
                                        {
                                            var cargo = line;
                                            <div class="d-flex align-center gap-2" style="@CargoLineStyle" title="@cargo.Notes">
                                                <MudIcon Icon="@(cargo.Operation == CargoOperation.Load ? Icons.Material.Outlined.Upload : Icons.Material.Outlined.Download)"
                                                         Color="@(cargo.Operation == CargoOperation.Load ? Color.Success : Color.Info)"
                                                         Size="Size.Small" />
                                                <span style="min-width:72px">@cargo.Operation</span>
                                                <strong>@cargo.CargoTypeName</strong>
                                                <span>@Qty(cargo)</span>
                                                @if (cargo.ContractNumber is not null)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@cargo.ContractNumber</MudChip>
                                                }
                                                @if (Extras(cargo) is { } extras)
                                                {
                                                    <span style="@MutedStyle">@extras</span>
                                                }
                                                <MudSpacer />
                                                <MudMenu Icon="@Icons.Material.Filled.MoreHoriz"
                                                         Size="Size.Small"
                                                         Disabled="@(IsReadOnly || IsBusy)"
                                                         AnchorOrigin="Origin.BottomRight"
                                                         TransformOrigin="Origin.TopRight">
                                                    <MudMenuItem Icon="@Icons.Material.Outlined.Edit"
                                                                 OnClick="@(() => OnEditCargoClicked.InvokeAsync(cargo))">
                                                        Edit
                                                    </MudMenuItem>
                                                    <MudMenuItem Icon="@Icons.Material.Outlined.Delete"
                                                                 OnClick="@(() => OnRemoveCargoClicked.InvokeAsync(cargo))">
                                                        Remove
                                                    </MudMenuItem>
                                                </MudMenu>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                            previous = current;
                        }
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    </ChildContent>
</VoyagePanel>

@code {
    [Parameter, EditorRequired] public VoyageResponse Voyage { get; set; } = default!;
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public EventCallback OnAddClicked { get; set; }
    [Parameter] public EventCallback<VoyageStopResponse> OnEditClicked { get; set; }
    [Parameter] public EventCallback<VoyageStopResponse> OnRemoveClicked { get; set; }
    [Parameter] public EventCallback<VoyageStopResponse> OnAddCargoClicked { get; set; }
    [Parameter] public EventCallback<VoyageCargoResponse> OnEditCargoClicked { get; set; }
    [Parameter] public EventCallback<VoyageCargoResponse> OnRemoveCargoClicked { get; set; }
    [Parameter] public EventCallback<VoyageStopResponse> OnFilesClicked { get; set; }
    [Parameter] public EventCallback<VoyageStopResponse> OnCommentsClicked { get; set; }


    private const string ThStyle =
        "font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;" +
        "color:var(--mud-palette-text-secondary)";

    private const string MutedStyle = "color:var(--mud-palette-text-secondary);";

    private const string NotesStyle =
        "max-width:220px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;";


    private const string CargoLineStyle =
        "padding:4px 8px;border-left:2px solid var(--mud-palette-lines-default);font-size:13px;";


    private const string BadgeStyle =
        "display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;" +
        "border:1px solid var(--mud-palette-primary);border-radius:50%;font-size:12px;" +
        "color:var(--mud-palette-primary);";

    private bool IsReadOnly => Voyage.Status == VoyageStatus.CANCELLED;

    private IReadOnlyList<VoyageStopResponse> OrderedStops =>
        Voyage.Stops.OrderBy(s => s.StopOrder).ToList();

    private static string Fmt(DateTime? value) => value?.ToString("dd MMM yyyy HH:mm") ?? "—";

    private static string? Duration(DateTime? from, DateTime? to)
    {
        if (from is null || to is null || to < from) return null;
        var span = to.Value - from.Value;
        return span.TotalDays >= 1
            ? $"{(int)span.TotalDays} d {span.Hours} h"
            : $"{span.Hours} h {span.Minutes} min";
    }

    private List<string> Warnings(VoyageStopResponse stop, VoyageStopResponse? previous)
    {
        var warnings = new List<string>();

        if (stop.ArrivalDate is DateTime arr && stop.DepartureDate is DateTime dep && dep < arr)
            warnings.Add("Departure is before arrival.");

        var previousLeft = previous?.DepartureDate ?? previous?.ArrivalDate;
        if (stop.ArrivalDate is DateTime arrivalHere && previousLeft is DateTime left && arrivalHere < left)
            warnings.Add($"Arrives before leaving stop {previous!.StopOrder}.");

        return warnings;
    }

    private static string Qty(VoyageCargoResponse c)
    {
        var qty = c.Unit is CargoUnit.MT or CargoUnit.CBM
            ? $"{c.Quantity:N3} {c.Unit}"
            : $"{c.Quantity:N0} {c.Unit}";

        return c.Unit != CargoUnit.MT && c.WeightMt.HasValue
            ? $"{qty} ({c.WeightMt:N3} MT)"
            : qty;
    }

    private static string? Extras(VoyageCargoResponse c)
    {
        var parts = new List<string>();

        if (c.DraftSurveyMt.HasValue) parts.Add($"Draft survey {c.DraftSurveyMt:N3} MT");
        if (c.ShoreFigureMt.HasValue) parts.Add($"Shore {c.ShoreFigureMt:N3} MT");

        if (c.PackageCount.HasValue) parts.Add($"{c.PackageCount:N0} {c.PackageType ?? "pkgs"}");
        else if (c.PackageType is not null) parts.Add(c.PackageType);

        if (c.VolumeCbm.HasValue) parts.Add($"{c.VolumeCbm:N3} CBM");

        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }
}