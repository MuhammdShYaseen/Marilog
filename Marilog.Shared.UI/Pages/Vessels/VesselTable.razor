@* VesselTable.razor *@
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.Vessels

<MudDataGrid T="VesselResponse"
             Items="Items"
             Hover="true"
             Dense="true"
             Striped="true"
             RowClick="OnRowClick"
             RowStyle="cursor:pointer"
             Breakpoint="Breakpoint.Sm">

    <Columns>
        <PropertyColumn Property="x => x.Name" Title="Vessel Name" />
        <PropertyColumn Property="x => x.IMONumber" Title="IMO Number" />
        <PropertyColumn Property="x => x.GrossTonnage" Title="GRT" Format="N0" />
        <PropertyColumn Property="x => x.CompanyName" Title="Company" />
        <PropertyColumn Property="x => x.FlagCountryName" Title="Flag" />
        <TemplateColumn Title="Certificates" Sortable="false">
            <CellTemplate>
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    @if (context.Item.ExpiredCertificates > 0)
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">
                            @context.Item.ExpiredCertificates expired
                        </MudChip>
                    }
                    @if (context.Item.ExpiringCertificates > 0)
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">
                            @context.Item.ExpiringCertificates soon
                        </MudChip>
                    }
                    @if (context.Item.CertificatesCount == 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                    }
                    else if (context.Item.ExpiredCertificates == 0 && context.Item.ExpiringCertificates == 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Success">OK (@context.Item.CertificatesCount)</MudText>
                    }
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Status" Sortable="false">
            <CellTemplate>
                <MudChip T="string"
                         Color="@(context.Item.IsActive ? Color.Success : Color.Default)"
                         Size="Size.Small"
                         Variant="Variant.Filled">
                    @(context.Item.IsActive ? "Active" : "Inactive")
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="" Sortable="false" CellStyle="width:120px">
            <CellTemplate>
               <div @onclick:stopPropagation="true">
                <MudStack Row="true" Spacing="1">

                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="() => OnEditClicked.InvokeAsync(context.Item)" />

                    <MudIconButton Icon="@Icons.Material.Filled.Receipt"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="() => OnManageAttachedFilesClicked.InvokeAsync((context.Item.Id, EntityType.Vessel))" />

                    <MudIconButton Icon="@(context.Item.IsActive ? Icons.Material.Filled.ToggleOff : Icons.Material.Filled.ToggleOn)"
                                   Size="Size.Small"
                                   Color="@(context.Item.IsActive ? Color.Warning : Color.Success)"
                                   OnClick="() => OnToggleActiveClicked.InvokeAsync(context.Item)" />

                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="() => OnDeleteClicked.InvokeAsync(context.Item)" />
                </MudStack>
               </div>
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <NoRecordsContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
            No vessels found.
        </MudText>
    </NoRecordsContent>

</MudDataGrid>

@code {
    [Parameter] public IEnumerable<VesselResponse> Items { get; set; } = [];
    [Parameter] public EventCallback<VesselResponse> OnRowClicked { get; set; }
    [Parameter] public EventCallback<VesselResponse> OnEditClicked { get; set; }
    [Parameter] public EventCallback<VesselResponse> OnDeleteClicked { get; set; }
    [Parameter] public EventCallback<VesselResponse> OnToggleActiveClicked { get; set; }
    [Parameter] public EventCallback<(int entityId, EntityType entityType)> OnManageAttachedFilesClicked { get; set; }

    private Task OnRowClick(DataGridRowClickEventArgs<VesselResponse> args)
        => OnRowClicked.InvokeAsync(args.Item);
}