@* SharedVesselPage.razor *@
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.Vessels

<MudPaper Class="pa-4" Elevation="2">

    @* ── Toolbar ── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.h6">Vessels</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_search"
                      Placeholder="Search..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mr-2"
                      Style="max-width:220px" />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OnAddClicked">
            New
        </MudButton>
    </MudStack>

    @* ── Summary Chips ── *@
    <MudStack Row="true" Spacing="2" Class="mb-3" Wrap="Wrap.Wrap">
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
            Total: @Vessels.Count
        </MudChip>
        <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small">
            Active: @Vessels.Count(v => v.IsActive)
        </MudChip>
        <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">
            Inactive: @Vessels.Count(v => !v.IsActive)
        </MudChip>
        @if (_vesselsWithIssues > 0)
        {
            <MudChip T="string" Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small">
                Certificate issues: @_vesselsWithIssues vessel(s)
            </MudChip>
        }
    </MudStack>

    @* ── Tabs ── *@
    <MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0" Rounded="true" Class="mb-3">

        <MudTabPanel Text="All">
            <VesselTable Items="_filtered"
                         OnRowClicked="OpenDrawer"
                         OnEditClicked="OnEditClicked"
                         OnDeleteClicked="OnDeleteClicked"
                         OnToggleActiveClicked="OnToggleActiveClicked"
                         OnManageAttachedFilesClicked="OnManageAttachedFilesClicked" />
        </MudTabPanel>

        <MudTabPanel Text="Active">
            <VesselTable Items="_filteredActive"
                         OnRowClicked="OpenDrawer"
                         OnEditClicked="OnEditClicked"
                         OnDeleteClicked="OnDeleteClicked"
                         OnToggleActiveClicked="OnToggleActiveClicked"
                         OnManageAttachedFilesClicked="OnManageAttachedFilesClicked" />
        </MudTabPanel>

        <MudTabPanel Text="Inactive">
            <VesselTable Items="_filteredInactive"
                         OnRowClicked="OpenDrawer"
                         OnEditClicked="OnEditClicked"
                         OnDeleteClicked="OnDeleteClicked"
                         OnToggleActiveClicked="OnToggleActiveClicked"
                         OnManageAttachedFilesClicked="OnManageAttachedFilesClicked" />
        </MudTabPanel>

    </MudTabs>

</MudPaper>

@if (_selected is not null)
{
    <VesselDetailsDrawer Vessel="_selected"
                         @bind-Open="_drawerOpen"
                         OnEditClicked="OnEditClicked"
                         OnDeleteClicked="OnDeleteClicked"
                         OnToggleActiveClicked="OnToggleActiveClicked"
                         OnManageAttachedFilesClicked="OnManageAttachedFilesClicked"
                         CertificatesContent="CertificatesContent"
                         PositionContent="PositionContent"
                         WeatherContent="WeatherContent" />
}

@code {
    [Parameter] public IReadOnlyList<VesselResponse> Vessels { get; set; } = [];
    [Parameter] public int? OpenVesselId { get; set; }

    [Parameter] public EventCallback OnAddClicked { get; set; }
    [Parameter] public EventCallback<VesselResponse> OnEditClicked { get; set; }
    [Parameter] public EventCallback<VesselResponse> OnDeleteClicked { get; set; }
    [Parameter] public EventCallback<VesselResponse> OnToggleActiveClicked { get; set; }
    [Parameter] public EventCallback<(int entityId, EntityType entityType)> OnManageAttachedFilesClicked { get; set; }

    [Parameter] public RenderFragment<VesselResponse>? CertificatesContent { get; set; }
    [Parameter] public RenderFragment<VesselResponse>? PositionContent { get; set; }
    [Parameter] public RenderFragment<VesselResponse>? WeatherContent { get; set; }

    private VesselResponse? _selected;
    private bool _drawerOpen;
    private int? _openedFromQueryId;
    private string _search = string.Empty;
    private int _activeTab;
    private int _vesselsWithIssues;

    private IEnumerable<VesselResponse> _filtered => Filter(Vessels);
    private IEnumerable<VesselResponse> _filteredActive => Filter(Vessels.Where(v => v.IsActive));
    private IEnumerable<VesselResponse> _filteredInactive => Filter(Vessels.Where(v => !v.IsActive));

    protected override void OnParametersSet()
    {
        _vesselsWithIssues = Vessels.Count(v => v.ExpiredCertificates + v.ExpiringCertificates > 0);

        if (_selected is not null)
        {
            _selected = Vessels.FirstOrDefault(v => v.Id == _selected.Id);
            if (_selected is null) _drawerOpen = false;
        }

        if (OpenVesselId is not null && _openedFromQueryId != OpenVesselId)
        {
            var vessel = Vessels.FirstOrDefault(v => v.Id == OpenVesselId);
            if (vessel is not null)
            {
                _openedFromQueryId = OpenVesselId;
                OpenDrawer(vessel);
            }
        }
    }

    private void OpenDrawer(VesselResponse vessel)
    {
        _selected = vessel;
        _drawerOpen = true;
    }

    private IEnumerable<VesselResponse> Filter(IEnumerable<VesselResponse> source) =>
        string.IsNullOrWhiteSpace(_search)
            ? source
            : source.Where(v =>
                v.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                (v.IMONumber ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                (v.CompanyName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                (v.FlagCountryName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));
}