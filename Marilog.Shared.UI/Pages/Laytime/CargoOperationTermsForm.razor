@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.Laytime

<MudGrid Spacing="2">
    <MudItem xs="6">
        <MudNumericField T="decimal" Value="Values.RateMtPerDay" ValueChanged="@(v => Update(x => x.RateMtPerDay = v))" Label="@($"{OperationType} Rate (MT/day)")" Min="0.01m" />
    </MudItem>
    <MudItem xs="6">
        <MudNumericField T="int" Value="Values.NoticeHours" ValueChanged="@(v => Update(x => x.NoticeHours = v))" Label="Notice Hours" Min="0" />
    </MudItem>
    <MudItem xs="6">
        <MudSelect T="LaytimeCalendarType" Value="Values.CalendarType" ValueChanged="@(v => Update(x => x.CalendarType = v))" Label="Calendar Type">
            @foreach (var value in Enum.GetValues<LaytimeCalendarType>())
            {
                <MudSelectItem Value="value">@LaytimeEnumLabels.Label(value)</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="6" Class="d-flex align-center">
        <MudCheckBox T="bool" Value="Values.IsReversible" ValueChanged="@(v => Update(x => x.IsReversible = v))" Label="Reversible Laytime" Color="Color.Primary" />
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired]
    public OperationType OperationType { get; set; }

    [Parameter, EditorRequired]
    public CargoOperationFormValues Values { get; set; } = default!;

    [Parameter]
    public EventCallback<CargoOperationFormValues> ValuesChanged { get; set; }

    private void Update(Action<CargoOperationFormValues> apply)
    {
        apply(Values);
        ValuesChanged.InvokeAsync(Values);
    }
}
