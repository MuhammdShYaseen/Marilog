@using Marilog.Contracts.DTOs.Responses
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.Laytime

<MudStack Spacing="3">

    <MudText Typo="Typo.body2" Color="Color.Secondary">
        Computed time segments between SOF events — read-only audit trail generated by the engine.
    </MudText>

    <MudTable T="LaytimeSegmentResponse" Items="Items.OrderBy(s => s.From)" Hover="true" Dense="true">

        <HeaderContent>
            <MudTh>From</MudTh>
            <MudTh>To</MudTh>
            <MudTh>Duration</MudTh>
            <MudTh>Counted</MudTh>
            <MudTh>Impact</MudTh>
            <MudTh>Reason</MudTh>
        </HeaderContent>

        <RowTemplate Context="seg">
            <MudTd DataLabel="From">@seg.From.ToString("yyyy-MM-dd HH:mm")</MudTd>
            <MudTd DataLabel="To">@seg.To.ToString("yyyy-MM-dd HH:mm")</MudTd>
            <MudTd DataLabel="Duration">@seg.DurationDisplay</MudTd>
            <MudTd DataLabel="Counted">
                <MudText Color="@(seg.CountedDurationDisplay.StartsWith("0h") ? Color.Secondary : Color.Primary)">
                    @seg.CountedDurationDisplay
                </MudText>
            </MudTd>
            <MudTd DataLabel="Impact">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@LaytimeEnumLabels.Label(seg.ImpactType)</MudChip>
            </MudTd>
            <MudTd DataLabel="Reason">@seg.Reason</MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">No segments yet — compute the calculation first.</MudText>
        </NoRecordsContent>

    </MudTable>

</MudStack>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<LaytimeSegmentResponse> Items { get; set; } = Array.Empty<LaytimeSegmentResponse>();
}
