@using Marilog.Contracts.DTOs.Responses
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.Laytime

@if (Result is null)
{
    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="py-8">
        <MudIcon Icon="@Icons.Material.Filled.PendingActions" Size="Size.Large" Color="Color.Secondary" />
        <MudText Color="Color.Secondary">Not computed yet. Add at least 2 SOF events, then click Compute.</MudText>
    </MudStack>
}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="6" md="3">
            <MudPaper Outlined="true" Class="pa-4 text-center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Allowed</MudText>
                <MudText Typo="Typo.h5">@Result.AllowedDays.ToString("N2")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">days</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Outlined="true" Class="pa-4 text-center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Used</MudText>
                <MudText Typo="Typo.h5">@Result.UsedDays.ToString("N2")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">days</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Outlined="true" Class="@($"pa-4 text-center {(Result.IsDemurrage ? "result-card-demurrage" : "result-card-despatch")}")">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Balance</MudText>
                <MudText Typo="Typo.h5" Color="@(Result.IsDemurrage ? Color.Error : Color.Success)">
                    @Result.BalanceDays.ToString("N2")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">days</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Outlined="true" Class="pa-4 text-center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@(Result.IsDemurrage ? "Demurrage" : "Despatch")</MudText>
                <MudText Typo="Typo.h5" Color="@(Result.IsDemurrage ? Color.Error : Color.Success)">
                    $@((Result.IsDemurrage ? Result.DemurrageAmount : Result.DespatchAmount).ToString("N2"))
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">USD</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudAlert Severity="@(Result.IsDemurrage ? Severity.Error : Severity.Success)" Class="mt-4" Dense="true">
        @if (Result.IsDemurrage)
        {
            <span>Vessel is <b>on Demurrage</b> — @Result.DemurrageAmount.ToString("N2") USD owed by charterer.</span>
        }
        else
        {
            <span>Vessel finished <b>within allowed laytime</b> — @Result.DespatchAmount.ToString("N2") USD despatch owed to charterer.</span>
        }
    </MudAlert>
}

<style>
    .result-card-demurrage { border-color: var(--mud-palette-error) !important; }
    .result-card-despatch { border-color: var(--mud-palette-success) !important; }
</style>

@code {
    [Parameter, EditorRequired]
    public LaytimeResultResponse? Result { get; set; }
}
