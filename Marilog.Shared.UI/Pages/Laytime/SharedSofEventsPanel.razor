@using Marilog.Contracts.DTOs.Responses
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.Laytime

<MudStack Spacing="3">

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @Items.Count event(s) — at least 2 are required to compute Laytime.
        </MudText>

        @if (!IsReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="@(() => OnAdd.InvokeAsync())">
                Add Event
            </MudButton>
        }
    </MudStack>

    <MudTable T="SofEventResponse" Items="Items.OrderBy(e => e.EventTime)" Hover="true" Dense="true">

        <HeaderContent>
            <MudTh>Time</MudTh>
            <MudTh>Event</MudTh>
            <MudTh>Impact</MudTh>
            <MudTh>Description</MudTh>
            @if (!IsReadOnly)
            {
                <MudTh></MudTh>
            }
        </HeaderContent>

        <RowTemplate Context="ev">
            <MudTd DataLabel="Time">@ev.EventTime.ToString("yyyy-MM-dd HH:mm")</MudTd>
            <MudTd DataLabel="Event">@LaytimeEnumLabels.Label(ev.EventType)</MudTd>
            <MudTd DataLabel="Impact">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                    @LaytimeEnumLabels.Label(ev.ImpactType)@(ev.Factor < 1 ? $" ({ev.Factor:P0})" : "")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Description">@ev.Description</MudTd>
            @if (!IsReadOnly)
            {
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => OnDelete.InvokeAsync(ev))" />
                </MudTd>
            }
        </RowTemplate>

        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">No SOF events recorded yet.</MudText>
        </NoRecordsContent>

    </MudTable>

</MudStack>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SofEventResponse> Items { get; set; } = Array.Empty<SofEventResponse>();

    [Parameter]
    public bool IsReadOnly { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnAdd { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<SofEventResponse> OnDelete { get; set; }
}
