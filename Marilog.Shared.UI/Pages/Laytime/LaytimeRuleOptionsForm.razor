@using MudBlazor
@namespace Marilog.Shared.UI.Pages.Laytime

<MudGrid Spacing="2">
    <MudItem xs="6">
        <MudCheckBox T="bool" Value="Values.WeekendIncluded" ValueChanged="@(v => Update(x => x.WeekendIncluded = v))" Label="Weekend Included (counts toward Laytime)" Color="Color.Primary" />
    </MudItem>
    <MudItem xs="6">
        <MudCheckBox T="bool" Value="Values.HolidaysIncluded" ValueChanged="@(v => Update(x => x.HolidaysIncluded = v))" Label="Holidays Included" Color="Color.Primary" />
        <MudText Typo="Typo.caption" Color="Color.Secondary">Add each holiday as a "Holiday" exception on the calculation</MudText>
    </MudItem>
    <MudItem xs="6">
        <MudCheckBox T="bool" Value="Values.DraftSurveyCounts" ValueChanged="@(v => Update(x => x.DraftSurveyCounts = v))" Label="Draft Survey Counts" Color="Color.Primary" Disabled="true" />
        <MudText Typo="Typo.caption" Color="Color.Warning">Not yet applied — set the impact on the SOF event</MudText>
    </MudItem>
    <MudItem xs="6">
        <MudCheckBox T="bool" Value="Values.TimeReversible" ValueChanged="@(v => Update(x => x.TimeReversible = v))" Label="Time Reversible" Color="Color.Primary" Disabled="true" />
        <MudText Typo="Typo.caption" Color="Color.Warning">Not yet applied in calculation</MudText>
    </MudItem>
    <MudItem xs="6">
        <MudCheckBox T="bool" Value="Values.AllowShiftingTime" ValueChanged="@(v => Update(x => x.AllowShiftingTime = v))" Label="Allow Shifting Time" Color="Color.Primary" Disabled="true" />
        <MudText Typo="Typo.caption" Color="Color.Warning">Not yet applied — set the impact on the SOF event</MudText>
    </MudItem>

    @if (!Values.WeekendIncluded)
    {
        <MudItem xs="6">
            <MudSelect T="DayOfWeek" Value="Values.WeekendDay1" ValueChanged="@(v => Update(x => x.WeekendDay1 = v))" Label="Weekend Day 1">
                @foreach (var day in Enum.GetValues<DayOfWeek>())
                {
                    <MudSelectItem Value="day">@day</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6">
            <MudSelect T="DayOfWeek" Value="Values.WeekendDay2" ValueChanged="@(v => Update(x => x.WeekendDay2 = v))" Label="Weekend Day 2">
                @foreach (var day in Enum.GetValues<DayOfWeek>())
                {
                    <MudSelectItem Value="day">@day</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="6">
            <MudTimePicker Time="Values.WeekendStartTime" TimeChanged="@(v => Update(x => x.WeekendStartTime = v))"
                           Label="Weekend Starts At" HelperText="On Weekend Day 1 — empty = 00:00" />
        </MudItem>
        <MudItem xs="6">
            <MudTimePicker Time="Values.WeekendEndTime" TimeChanged="@(v => Update(x => x.WeekendEndTime = v))"
                           Label="Weekend Ends At" HelperText="On the day after the last weekend day — empty = 00:00" />
        </MudItem>
    }
</MudGrid>

@code {
    [Parameter, EditorRequired]
    public LaytimeRuleOptionsFormValues Values { get; set; } = default!;

    [Parameter]
    public EventCallback<LaytimeRuleOptionsFormValues> ValuesChanged { get; set; }

    private void Update(Action<LaytimeRuleOptionsFormValues> apply)
    {
        apply(Values);
        ValuesChanged.InvokeAsync(Values);
    }
}
