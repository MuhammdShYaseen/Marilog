@using Marilog.Contracts.DTOs.Requests.LayTimeDTOs
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Contracts.DTOs.Reports.Contract
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.Laytime

<MudDialog>

    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Calculate" Color="Color.Primary" />
            <MudText Typo="Typo.h6">New Laytime Calculation</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3">
            <MudAutocomplete T="ContractSummary" Value="_contract" ValueChanged="OnContractChanged"
                             Label="Contract" Required="true" SearchFunc="SearchContracts"
                             MaxItems="50" ResetValueOnEmptyText="true"
                             ToStringFunc="@(c => c is null ? null : $"{c.ContractNumber} — {c.Type}")" />

            @if (_hasCharterTerms == false)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    This contract has no charter terms yet — set them up before creating a laytime calculation.
                </MudAlert>
            }

            <MudAutocomplete T="PortResponse" @bind-Value="_port" Label="Port" Required="true"
                             SearchFunc="SearchPorts" MaxItems="50" ResetValueOnEmptyText="true"
                             ToStringFunc="@(p => p is null ? null : $"{p.Name} ({p.Code})")" />

            <MudSelect T="OperationType?" @bind-Value="_operationType" Label="Operation Type" Required="true">
                @foreach (var value in Enum.GetValues<OperationType>())
                {
                    <MudSelectItem T="OperationType?" Value="@((OperationType?)value)">@LaytimeEnumLabels.Label(value)</MudSelectItem>
                }
            </MudSelect>

            <MudNumericField T="decimal" @bind-Value="_cargoQuantityMt" Label="Cargo Quantity (MT)" Min="0.01m"
                             HelperText="Filled from the contract's charter terms — adjust if this port handles part of the cargo" />
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!IsValid)" OnClick="Submit">
            Create
        </MudButton>
    </DialogActions>

</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public int VoyageId { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<ContractSummary> Contracts { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<PortResponse> Ports { get; set; } = [];

    /// <summary>Supplied by the host; used to prefill quantity and warn when terms are missing.</summary>
    [Parameter]
    public Func<int, Task<CharterTermsResponse?>>? LoadCharterTerms { get; set; }

    private ContractSummary? _contract;
    private PortResponse? _port;
    private OperationType? _operationType;
    private decimal _cargoQuantityMt;
    private bool? _hasCharterTerms;

    private bool IsValid =>
        _contract is not null &&
        _hasCharterTerms != false &&
        _port is not null &&
        _operationType is not null &&
        _cargoQuantityMt > 0;

    private async Task OnContractChanged(ContractSummary? contract)
    {
        _contract = contract;
        _hasCharterTerms = null;

        if (contract is null || LoadCharterTerms is null)
            return;

        var terms = await LoadCharterTerms(contract.Id);
        _hasCharterTerms = terms is not null;

        if (terms is { CargoQuantityMt: > 0 })
            _cargoQuantityMt = terms.CargoQuantityMt;
    }

    private Task<IEnumerable<ContractSummary>> SearchContracts(string? text, CancellationToken token)
    {
        var result = string.IsNullOrWhiteSpace(text)
            ? Contracts
            : Contracts.Where(c => c.ContractNumber.Contains(text, StringComparison.OrdinalIgnoreCase)
                                || c.Type.Contains(text, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result);
    }

    private Task<IEnumerable<PortResponse>> SearchPorts(string? text, CancellationToken token)
    {
        var result = string.IsNullOrWhiteSpace(text)
            ? Ports
            : Ports.Where(p => p.Name.Contains(text, StringComparison.OrdinalIgnoreCase)
                            || p.Code.Contains(text, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (!IsValid) return;

        var request = new CreateLaytimeCalculationRequest(
            VoyageId, _contract!.Id, _port!.Id, _operationType!.Value, _cargoQuantityMt);

        MudDialog.Close(DialogResult.Ok(request));
    }
}
