@using Marilog.Contracts.DTOs.Requests.BillOfLadingDTOs
@using Marilog.Contracts.DTOs.Responses
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.BillOfLading

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Outlined.Tag" Color="Color.Primary" Size="Size.Small" />
            <MudText Typo="Typo.h6">Change B/L number</MudText>
        </div>
    </TitleContent>

    <DialogContent>
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            The B/L number identifies this shipment on every related document. Change it only to correct an error.
        </MudAlert>

        <MudTextField T="string" Value="@Bl.BlNumber" Label="Current number"
                      ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />

        <MudTextField @bind-Value="_newNumber"
                      Label="New number"
                      Required="true"
                      MaxLength="50"
                      Immediate="true"
                      Error="IsDuplicate"
                      ErrorText="This number is already used on this voyage."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="_saving" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!IsValid || _saving)"
                   OnClick="SubmitAsync">
            @(_saving ? "Saving…" : "Change number")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public BillOfLadingResponse Bl { get; set; } = default!;

    /// <summary>Numbers of the other B/Ls on this voyage, for an instant duplicate check.</summary>
    [Parameter] public IReadOnlyCollection<string> TakenNumbers { get; set; } = [];

    [Parameter] public Func<ChangeBlNumberRequest, Task<bool>>? OnSave { get; set; }

    private string _newNumber = string.Empty;
    private bool _saving;

    private string Trimmed => _newNumber.Trim();

    private bool IsDuplicate =>
        TakenNumbers.Any(n => string.Equals(n, Trimmed, StringComparison.OrdinalIgnoreCase));

    private bool IsValid =>
        Trimmed.Length > 0 &&
        !string.Equals(Trimmed, Bl.BlNumber, StringComparison.Ordinal) &&
        !IsDuplicate;

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        if (!IsValid || _saving || OnSave is null) return;

        _saving = true;
        var ok = await OnSave(new ChangeBlNumberRequest(NewBlNumber: Trimmed));
        _saving = false;

        if (ok) MudDialog.Close(DialogResult.Ok(true));
    }
}