@using Marilog.Contracts.DTOs.Requests.BillOfLadingDTOs
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.BillOfLading

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@(IsEdit ? Icons.Material.Outlined.Edit : Icons.Material.Outlined.Add)"
                     Color="Color.Primary" Size="Size.Small" />
            <MudText Typo="Typo.h6">@(IsEdit ? $"Edit B/L {ExistingBl!.BlNumber}" : "New bill of lading")</MudText>
        </div>
    </TitleContent>

    <DialogContent>
        <MudGrid Spacing="2">

            @* ── Identity ── *@
            <MudItem xs="12"><MudText Typo="Typo.caption" Style="@SectionStyle">Identity</MudText></MudItem>

            @if (IsEdit)
            {
                <MudItem xs="12" sm="4">
                    <MudTextField T="string" Value="@ExistingBl!.BlNumber" Label="B/L number"
                                  ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField T="string" Value="@IssuanceText" Label="Issuance"
                                  ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
            }
            else
            {
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_blNumber"
                                  Label="B/L number"
                                  Required="true"
                                  MaxLength="50"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="BlIssuanceType"
                               Value="_issuanceType"
                               ValueChanged="OnIssuanceTypeChanged"
                               Label="Issuance"
                               Required="true"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        @foreach (var t in Enum.GetValues<BlIssuanceType>())
                        {
                            <MudSelectItem T="BlIssuanceType" Value="t">@BlDisplay.Issuance(t)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }

            <MudItem xs="12" sm="4">
                <MudSelect T="BlType"
                           @bind-Value="_blType"
                           Label="B/L type"
                           Required="true"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">
                    @foreach (var t in Enum.GetValues<BlType>())
                    {
                        <MudSelectItem T="BlType" Value="t">@BlDisplay.Type(t)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            @if (!IsEdit && _issuanceType == BlIssuanceType.House)
            {
                <MudItem xs="12">
                    @if (AvailableMasterBls.Count == 0)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                            There is no master B/L on this voyage yet. Create the master B/L first.
                        </MudAlert>
                    }
                    else
                    {
                        <MudSelect T="int?"
                                   @bind-Value="_masterBlId"
                                   Label="Master B/L"
                                   Required="true"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            @foreach (var mbl in AvailableMasterBls)
                            {
                                <MudSelectItem T="int?" Value="@((int?)mbl.Id)">@mbl.BlNumber</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudItem>
            }

            @if (IsEdit)
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        B/L number and issuance type change the legal identity of the document — use the B/L actions menu for those.
                    </MudText>
                </MudItem>
            }

            @* ── Parties ── *@
            <MudItem xs="12"><MudText Typo="Typo.caption" Style="@SectionStyle">Parties</MudText></MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="int" @bind-Value="_shipperCompanyId" Label="Shipper" Required="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var c in Companies)
                    {
                        <MudSelectItem T="int" Value="c.Id">@c.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="int" @bind-Value="_carrierCompanyId" Label="Carrier" Required="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var c in Companies)
                    {
                        <MudSelectItem T="int" Value="c.Id">@c.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            @if (_blType == BlType.BearerBl)
            {
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pt-2">
                        Bearer B/L — no named consignee.
                    </MudText>
                </MudItem>
            }
            else
            {
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?"
                               Value="_consigneeCompanyId"
                               ValueChanged="OnConsigneeCompanyChanged"
                               Label="Consignee"
                               Required="@(_blType == BlType.Straight)"
                               Clearable="true"
                               HelperText="@ConsigneeHelper"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        @foreach (var c in Companies)
                        {
                            <MudSelectItem T="int?" Value="@((int?)c.Id)">@c.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @if (_blType == BlType.OrderBl && _consigneeCompanyId is null)
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_consigneeToOrder"
                                      Label="To order of"
                                      MaxLength="200"
                                      HelperText="E.g. the shipper or the issuing bank."
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudItem>
                }
            }

            <MudItem xs="12" sm="6">
                <MudSelect T="int?" @bind-Value="_notifyPartyCompanyId" Label="Notify party" Clearable="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var c in Companies)
                    {
                        <MudSelectItem T="int?" Value="@((int?)c.Id)">@c.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            @* ── Routing ── *@
            <MudItem xs="12"><MudText Typo="Typo.caption" Style="@SectionStyle">Routing</MudText></MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="int" @bind-Value="_portOfLoadingId" Label="Port of loading" Required="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var p in Ports)
                    {
                        <MudSelectItem T="int" Value="p.Id">@p.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="int" @bind-Value="_portOfDischargeId" Label="Port of discharge" Required="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var p in Ports)
                    {
                        <MudSelectItem T="int" Value="p.Id">@p.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="int?" @bind-Value="_placeOfReceiptPortId" Label="Place of receipt" Clearable="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var p in Ports)
                    {
                        <MudSelectItem T="int?" Value="@((int?)p.Id)">@p.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="int?" @bind-Value="_placeOfDeliveryPortId" Label="Place of delivery" Clearable="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var p in Ports)
                    {
                        <MudSelectItem T="int?" Value="@((int?)p.Id)">@p.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            @* ── Cargo ── *@
            <MudItem xs="12"><MudText Typo="Typo.caption" Style="@SectionStyle">Cargo</MudText></MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="_cargoDescription" Label="Description of goods" Required="true"
                              Lines="3" MaxLength="1000" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_hsCode" Label="HS code" MaxLength="20"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudNumericField T="decimal" @bind-Value="_grossWeightMt" Label="Gross weight" Required="true"
                                 Min="0" Format="N3" HideSpinButtons="true"
                                 Adornment="Adornment.End" AdornmentText="MT"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudNumericField T="decimal?" @bind-Value="_volumeM3" Label="Volume"
                                 Min="0" Format="N3" HideSpinButtons="true"
                                 Adornment="Adornment.End" AdornmentText="M³"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudNumericField T="int?" @bind-Value="_packageCount" Label="Packages"
                                 Min="0" HideSpinButtons="true"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_packageType" Label="Package type" MaxLength="50"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="_marksAndNumbers" Label="Marks & numbers" MaxLength="500"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            @* ── Freight ── *@
            <MudItem xs="12"><MudText Typo="Typo.caption" Style="@SectionStyle">Freight</MudText></MudItem>

            <MudItem xs="12" sm="4">
                <MudSelect T="FreightTerms" @bind-Value="_freightTerms" Label="Freight terms" Required="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var t in Enum.GetValues<FreightTerms>())
                    {
                        <MudSelectItem T="FreightTerms" Value="t">@BlDisplay.Freight(t)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_freightAmount" Label="Freight amount" MaxLength="100"
                              HelperText="Free text, e.g. AS ARRANGED."
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_incoterms" Label="Incoterms" MaxLength="10"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            @* ── Issuance ── *@
            <MudItem xs="12"><MudText Typo="Typo.caption" Style="@SectionStyle">Issuance</MudText></MudItem>

            <MudItem xs="12" sm="3">
                <MudDatePicker @bind-Date="_issueDate" Label="Issue date" Required="true"
                               DateFormat="dd MMM yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker @bind-Date="_onBoardDate" Label="On board date" Clearable="true"
                               DateFormat="dd MMM yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_placeOfIssue" Label="Place of issue" MaxLength="100"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudNumericField T="int" @bind-Value="_originalCopiesCount" Label="Original copies"
                                 Min="1" Max="10" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="_notes" Label="Notes" Lines="2" MaxLength="2000"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

        </MudGrid>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="_saving" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!IsValid || _saving)"
                   OnClick="SubmitAsync">
            @(_saving ? "Saving…" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public BillOfLadingResponse? ExistingBl { get; set; }
    [Parameter] public int VoyageId { get; set; }
    [Parameter] public IReadOnlyList<CompanyResponse> Companies { get; set; } = [];
    [Parameter] public IReadOnlyList<PortResponse> Ports { get; set; } = [];
    [Parameter] public IReadOnlyList<BillOfLadingResponse> AvailableMasterBls { get; set; } = [];
    [Parameter] public int? DefaultPortOfLoadingId { get; set; }
    [Parameter] public int? DefaultPortOfDischargeId { get; set; }

    /// <summary>Host performs the create; returns true on success. Dialog stays open on failure.</summary>
    [Parameter] public Func<CreateBillOfLadingRequest, Task<bool>>? OnCreate { get; set; }

    /// <summary>Host performs the update; returns true on success. Dialog stays open on failure.</summary>
    [Parameter] public Func<UpdateBillOfLadingRequest, Task<bool>>? OnUpdate { get; set; }

    private const string SectionStyle =
        "font-weight:600;text-transform:uppercase;letter-spacing:.04em;" +
        "color:var(--mud-palette-text-secondary);";

    private string _blNumber = string.Empty;
    private BlType _blType = BlType.Straight;
    private BlIssuanceType _issuanceType = BlIssuanceType.Master;
    private int? _masterBlId;
    private int _shipperCompanyId;
    private int _carrierCompanyId;
    private int? _consigneeCompanyId;
    private string? _consigneeToOrder;
    private int? _notifyPartyCompanyId;
    private int _portOfLoadingId;
    private int _portOfDischargeId;
    private int? _placeOfReceiptPortId;
    private int? _placeOfDeliveryPortId;
    private string _cargoDescription = string.Empty;
    private string? _hsCode;
    private decimal _grossWeightMt;
    private decimal? _volumeM3;
    private int? _packageCount;
    private string? _packageType;
    private string? _marksAndNumbers;
    private FreightTerms _freightTerms = FreightTerms.Prepaid;
    private string? _freightAmount;
    private string? _incoterms;
    private DateTime? _issueDate;
    private DateTime? _onBoardDate;
    private string? _placeOfIssue;
    private int _originalCopiesCount = 3;
    private string? _notes;
    private bool _saving;

    private bool IsEdit => ExistingBl is not null;

    private string IssuanceText => ExistingBl!.IssuanceType == BlIssuanceType.House
        ? $"House of {ExistingBl.MasterBlNumber ?? "—"}"
        : "Master";

    private string? ConsigneeHelper => _blType switch
    {
        BlType.Straight => "Required for a straight B/L.",
        BlType.OrderBl => "Leave empty to issue to order.",
        _ => null
    };

    private bool ConsigneeValid => _blType switch
    {
        BlType.Straight => _consigneeCompanyId.HasValue,
        BlType.OrderBl => _consigneeCompanyId.HasValue || !string.IsNullOrWhiteSpace(_consigneeToOrder),
        _ => true
    };

    private bool IsValid =>
        (IsEdit || (!string.IsNullOrWhiteSpace(_blNumber) &&
                    (_issuanceType != BlIssuanceType.House || _masterBlId.HasValue))) &&
        _shipperCompanyId > 0 &&
        _carrierCompanyId > 0 &&
        _portOfLoadingId > 0 &&
        _portOfDischargeId > 0 &&
        !string.IsNullOrWhiteSpace(_cargoDescription) &&
        _grossWeightMt > 0 &&
        _issueDate is not null &&
        _originalCopiesCount >= 1 &&
        ConsigneeValid;

    // Values actually sent — hidden fields never leak into the request.
    private int? ConsigneeCompanyOut => _blType == BlType.BearerBl ? null : _consigneeCompanyId;

    private string? ConsigneeToOrderOut =>
        _blType == BlType.OrderBl && _consigneeCompanyId is null ? NullIfEmpty(_consigneeToOrder) : null;

    protected override void OnInitialized()
    {
        if (ExistingBl is null)
        {
            _issueDate = DateTime.Today;
            if (DefaultPortOfLoadingId is int pol && Ports.Any(p => p.Id == pol)) _portOfLoadingId = pol;
            if (DefaultPortOfDischargeId is int pod && Ports.Any(p => p.Id == pod)) _portOfDischargeId = pod;
            return;
        }

        _blType = ExistingBl.BlType;
        _issuanceType = ExistingBl.IssuanceType;
        _shipperCompanyId = ExistingBl.ShipperCompany?.Id ?? 0;
        _carrierCompanyId = ExistingBl.CarrierCompany?.Id ?? 0;
        _consigneeCompanyId = ExistingBl.ConsigneeCompany?.Id;
        _consigneeToOrder = ExistingBl.ConsigneeToOrder;
        _notifyPartyCompanyId = ExistingBl.NotifyPartyCompany?.Id;
        _portOfLoadingId = ExistingBl.PortOfLoading?.Id ?? 0;
        _portOfDischargeId = ExistingBl.PortOfDischarge?.Id ?? 0;
        _placeOfReceiptPortId = ExistingBl.PlaceOfReceipt?.Id;
        _placeOfDeliveryPortId = ExistingBl.PlaceOfDelivery?.Id;
        _cargoDescription = ExistingBl.CargoDescription ?? string.Empty;
        _hsCode = ExistingBl.HsCode;
        _grossWeightMt = ExistingBl.GrossWeightMT ?? 0;
        _volumeM3 = ExistingBl.VolumeM3;
        _packageCount = ExistingBl.PackageCount;
        _packageType = ExistingBl.PackageType;
        _marksAndNumbers = ExistingBl.MarksAndNumbers;
        _freightTerms = ExistingBl.FreightTerms;
        _freightAmount = ExistingBl.FreightAmount;
        _incoterms = ExistingBl.Incoterms;
        _issueDate = ExistingBl.IssueDate?.ToDateTime(TimeOnly.MinValue);
        _onBoardDate = ExistingBl.OnBoardDate?.ToDateTime(TimeOnly.MinValue);
        _placeOfIssue = ExistingBl.PlaceOfIssue;
        _originalCopiesCount = ExistingBl.OriginalCopiesCount ?? 3;
        _notes = ExistingBl.Notes;
    }

    private void OnIssuanceTypeChanged(BlIssuanceType value)
    {
        _issuanceType = value;
        if (value != BlIssuanceType.House) _masterBlId = null;
    }

    private void OnConsigneeCompanyChanged(int? value)
    {
        _consigneeCompanyId = value;
        if (value.HasValue) _consigneeToOrder = null;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        if (!IsValid || _saving) return;

        _saving = true;
        var task = IsEdit ? OnUpdate?.Invoke(BuildUpdate()) : OnCreate?.Invoke(BuildCreate());
        var ok = task is not null && await task;
        _saving = false;

        if (ok) MudDialog.Close(DialogResult.Ok(true));
    }

    private CreateBillOfLadingRequest BuildCreate() => new(
        VoyageId: VoyageId,
        BlNumber: _blNumber.Trim(),
        BlType: _blType,
        IssuanceType: _issuanceType,
        ShipperCompanyId: _shipperCompanyId,
        CarrierCompanyId: _carrierCompanyId,
        PortOfLoadingId: _portOfLoadingId,
        PortOfDischargeId: _portOfDischargeId,
        CargoDescription: _cargoDescription.Trim(),
        GrossWeightMT: _grossWeightMt,
        FreightTerms: _freightTerms,
        IssueDate: DateOnly.FromDateTime(_issueDate!.Value),
        ConsigneeCompanyId: ConsigneeCompanyOut,
        ConsigneeToOrder: ConsigneeToOrderOut,
        NotifyPartyCompanyId: _notifyPartyCompanyId,
        HsCode: NullIfEmpty(_hsCode),
        VolumeM3: _volumeM3,
        PackageCount: _packageCount,
        PackageType: NullIfEmpty(_packageType),
        MarksAndNumbers: NullIfEmpty(_marksAndNumbers),
        FreightAmount: NullIfEmpty(_freightAmount),
        Incoterms: NullIfEmpty(_incoterms),
        PlaceOfIssue: NullIfEmpty(_placeOfIssue),
        OnBoardDate: _onBoardDate.HasValue ? DateOnly.FromDateTime(_onBoardDate.Value) : null,
        OriginalCopiesCount: _originalCopiesCount,
        MasterBlId: _issuanceType == BlIssuanceType.House ? _masterBlId : null,
        PlaceOfReceiptPortId: _placeOfReceiptPortId,
        PlaceOfDeliveryPortId: _placeOfDeliveryPortId,
        Notes: NullIfEmpty(_notes));

    private UpdateBillOfLadingRequest BuildUpdate() => new(
        BlType: _blType,
        ShipperCompanyId: _shipperCompanyId,
        CarrierCompanyId: _carrierCompanyId,
        PortOfLoadingId: _portOfLoadingId,
        PortOfDischargeId: _portOfDischargeId,
        CargoDescription: _cargoDescription.Trim(),
        GrossWeightMT: _grossWeightMt,
        FreightTerms: _freightTerms,
        IssueDate: DateOnly.FromDateTime(_issueDate!.Value),
        ConsigneeCompanyId: ConsigneeCompanyOut,
        ConsigneeToOrder: ConsigneeToOrderOut,
        NotifyPartyCompanyId: _notifyPartyCompanyId,
        HsCode: NullIfEmpty(_hsCode),
        VolumeM3: _volumeM3,
        PackageCount: _packageCount,
        PackageType: NullIfEmpty(_packageType),
        MarksAndNumbers: NullIfEmpty(_marksAndNumbers),
        FreightAmount: NullIfEmpty(_freightAmount),
        Incoterms: NullIfEmpty(_incoterms),
        PlaceOfIssue: NullIfEmpty(_placeOfIssue),
        OnBoardDate: _onBoardDate.HasValue ? DateOnly.FromDateTime(_onBoardDate.Value) : null,
        OriginalCopiesCount: _originalCopiesCount,
        PlaceOfReceiptPortId: _placeOfReceiptPortId,
        PlaceOfDeliveryPortId: _placeOfDeliveryPortId,
        Notes: NullIfEmpty(_notes));

    private static string? NullIfEmpty(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
}