@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.DocumentTemplates

@* ────────────────────────────────────────────────────────────────────────────
   SharedDocumentTemplatesPage
   Header + New button + table of saved templates. Editing opens the designer
   page; every action bubbles up via EventCallback.
   ──────────────────────────────────────────────────────────────────────── *@
<MudPaper Class="pa-4" Elevation="0">
    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h5">Document Templates</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Page designs for exporting documents as PDF. Pick one from "Export PDF" on any document.
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => OnAddClicked.InvokeAsync())">
            New Template
        </MudButton>
    </div>

    <MudTable Items="@Items" Hover="true" Dense="true" Loading="@IsLoading" T="DocumentTemplateSummaryResponse">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Page</MudTh>
            <MudTh>Last changed</MudTh>
            <MudTh Style="text-align:right">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Page">@PageLabel(context)</MudTd>
            <MudTd DataLabel="Last changed">@(context.UpdatedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "—")</MudTd>
            <MudTd Style="text-align:right">
                <MudTooltip Text="Edit">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   onclick="@(EventCallback.Factory.Create(this, () => OnEditClicked.InvokeAsync(context)))" />
                </MudTooltip>
                <MudTooltip Text="Make a copy">
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                   onclick="@(EventCallback.Factory.Create(this, () => OnDuplicateClicked.InvokeAsync(context)))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No templates yet. Click "New Template" to design one.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText>Loading templates...</MudText>
        </LoadingContent>
    </MudTable>
</MudPaper>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<DocumentTemplateSummaryResponse> Items { get; set; } = [];
    [Parameter] public bool IsLoading { get; set; }

    [Parameter, EditorRequired] public EventCallback OnAddClicked { get; set; }
    [Parameter, EditorRequired] public EventCallback<DocumentTemplateSummaryResponse> OnEditClicked { get; set; }
    [Parameter, EditorRequired] public EventCallback<DocumentTemplateSummaryResponse> OnDuplicateClicked { get; set; }
    [Parameter, EditorRequired] public EventCallback<DocumentTemplateSummaryResponse> OnDeleteClicked { get; set; }

    private static string PageLabel(DocumentTemplateSummaryResponse t)
        => $"{(t.PageSize == TemplatePageSize.Letter ? "Letter" : "A4")} · {(t.IsLandscape ? "Landscape" : "Portrait")}";
}