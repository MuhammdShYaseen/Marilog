@using Marilog.Contracts.DTOs.Reports.PersonReports
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.Persons

<div class="az-persons">

    <div class="az-page-title">
        <MudText Typo="Typo.h6">Persons</MudText>
    </div>

    <MudTabs Elevation="0" Rounded="false" PanelClass="pt-2">

        @* ── All Persons ── *@
        <MudTabPanel Text="All persons">

            <div class="az-commandbar">
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OnAddClicked">
                    New
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           Color="@(_showExpiringOnly ? Color.Warning : Color.Default)"
                           StartIcon="@Icons.Material.Filled.Warning"
                           OnClick="() => _showExpiringOnly = !_showExpiringOnly">
                    Expiring passports
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.CardMembership"
                           OnClick="HandleExpiringCertificatesClick">
                    Expiring certificates
                </MudButton>

                <MudSpacer />

                <MudTextField @bind-Value="_search"
                              Placeholder="Search by name, passport, seaman book, phone, email"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Clearable="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Style="max-width:320px" />
            </div>

            <PersonsTable Items="_filtered"
                          OnEditClicked="OnEditClicked"
                          OnDeleteClicked="OnDeleteClicked"
                          OnActivateClicked="OnActivateClicked"
                          OnDeactivateClicked="OnDeactivateClicked"
                          OnEditBankClicked="OnEditBankClicked"
                          OnManageAttachedFilesClicked="OnManageAttachedFilesClicked"
                          OnAddCertificateClicked="OnAddCertificateClicked"
                          OnEditCertificateClicked="OnEditCertificateClicked"
                          OnRemoveCertificateClicked="OnRemoveCertificateClicked"
                          OnAddSeaServiceClicked="OnAddSeaServiceClicked"
                          OnEditSeaServiceClicked="OnEditSeaServiceClicked"
                          OnRemoveSeaServiceClicked="OnRemoveSeaServiceClicked" />
        </MudTabPanel>

        @* ── Filtered Persons ── *@
        <MudTabPanel Text="Filtered persons">
            <PersonsFilterTab Ranks="Ranks"
                              CertificateNames="_certificateNames"
                              Results="FilteredPersons"
                              IsLoading="IsFiltering"
                              OnSearch="OnFilterSearch"
                              OnEditClicked="OnEditClicked"
                              OnDeleteClicked="OnDeleteClicked"
                              OnActivateClicked="OnActivateClicked"
                              OnDeactivateClicked="OnDeactivateClicked"
                              OnEditBankClicked="OnEditBankClicked"
                              OnManageAttachedFilesClicked="OnManageAttachedFilesClicked"
                              OnAddCertificateClicked="OnAddCertificateClicked"
                              OnEditCertificateClicked="OnEditCertificateClicked"
                              OnRemoveCertificateClicked="OnRemoveCertificateClicked"
                              OnAddSeaServiceClicked="OnAddSeaServiceClicked"
                              OnEditSeaServiceClicked="OnEditSeaServiceClicked"
                              OnRemoveSeaServiceClicked="OnRemoveSeaServiceClicked" />
        </MudTabPanel>

    </MudTabs>

</div>

<style>
    .az-persons .az-page-title {
        padding-bottom: 8px;
    }

    .az-persons .az-commandbar {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 4px 0;
        margin-bottom: 8px;
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }

    .az-persons .mud-tab {
        text-transform: none;
        min-width: 0;
    }

    .az-persons .mud-table-head .mud-table-cell,
    .az-persons .mud-simple-table thead th {
        text-transform: uppercase;
        font-size: .7rem;
        font-weight: 600;
        letter-spacing: .04em;
        color: var(--mud-palette-text-secondary);
        background-color: var(--mud-palette-background-gray);
    }

    .az-persons .mud-table-cell,
    .az-persons .mud-simple-table td {
        font-size: .8125rem;
        padding-top: 4px;
        padding-bottom: 4px;
    }

    .az-persons .az-detail {
        padding: 8px 16px 16px 16px;
        border-left: 2px solid var(--mud-palette-primary);
        background-color: var(--mud-palette-background);
    }

    .az-persons .az-essentials {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 10px 24px;
    }

    .az-persons .az-label {
        font-size: .75rem;
        color: var(--mud-palette-text-secondary);
    }

    .az-persons .az-value {
        font-size: .8125rem;
        color: var(--mud-palette-text-primary);
    }

    .az-persons .az-section-label {
        text-transform: uppercase;
        font-size: .7rem;
        font-weight: 600;
        letter-spacing: .04em;
        color: var(--mud-palette-text-secondary);
        border-bottom: 1px solid var(--mud-palette-lines-default);
        padding-bottom: 2px;
    }

    .az-persons .az-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .az-persons .az-muted {
        color: var(--mud-palette-text-secondary);
    }

    .az-persons .az-small {
        font-size: .75rem;
    }

    .az-persons .az-actions {
        width: 1%;
        white-space: nowrap;
    }
</style>

@code {
    // ── Parameters ───────────────────────────────────────────────
    [Parameter] public IReadOnlyList<PersonResponse> Persons { get; set; } = [];
    [Parameter] public IReadOnlyList<RankResponse> Ranks { get; set; } = [];

    [Parameter] public IReadOnlyList<PersonResponse> FilteredPersons { get; set; } = [];
    [Parameter] public bool IsFiltering { get; set; }
    [Parameter] public EventCallback<PersonFilterOptions> OnFilterSearch { get; set; }

    [Parameter] public EventCallback<PersonResponse> OnEditClicked { get; set; }
    [Parameter] public EventCallback<PersonResponse> OnDeleteClicked { get; set; }
    [Parameter] public EventCallback<PersonResponse> OnActivateClicked { get; set; }
    [Parameter] public EventCallback<PersonResponse> OnDeactivateClicked { get; set; }
    [Parameter] public EventCallback<PersonResponse> OnEditBankClicked { get; set; }
    [Parameter] public EventCallback OnAddClicked { get; set; }

    [Parameter] public EventCallback<List<PersonResponse>> OnShowExpiringCertificatesClicked { get; set; }
    [Parameter] public EventCallback<(int entityId, EntityType entityType)> OnManageAttachedFilesClicked { get; set; }
    [Parameter] public EventCallback<PersonResponse> OnAddCertificateClicked { get; set; }
    [Parameter] public EventCallback<(PersonResponse, CertificateResponse)> OnEditCertificateClicked { get; set; }
    [Parameter] public EventCallback<(PersonResponse, CertificateResponse)> OnRemoveCertificateClicked { get; set; }

    [Parameter] public EventCallback<PersonResponse> OnAddSeaServiceClicked { get; set; }
    [Parameter] public EventCallback<(PersonResponse person, PersonSeaServiceResponse service)> OnEditSeaServiceClicked { get; set; }
    [Parameter] public EventCallback<(PersonResponse person, PersonSeaServiceResponse service)> OnRemoveSeaServiceClicked { get; set; }

    // ── State ─────────────────────────────────────────────────────
    private string _search = string.Empty;
    private bool _showExpiringOnly = false;

    // ── Filtered List (client-side, All tab) ──────────────────────
    private IEnumerable<PersonResponse> _filtered =>
        Persons
            .Where(p => !_showExpiringOnly ||
                        (p.PassportExpiry.HasValue &&
                         (p.PassportExpiry.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days <= 90))
            .Where(p => string.IsNullOrWhiteSpace(_search) ||
                        p.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                        (p.PassportNo?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (p.SeamanBookNo?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (p.Phone?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (p.Email?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

    // ── Certificate names for the filter tab ─────────────────────
    private IReadOnlyList<string> _certificateNames =>
        Persons
            .SelectMany(p => p.Certificates)
            .Select(c => c.CertificateName)
            .OfType<string>()
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Distinct()
            .Order()
            .ToList();

    // ── Expiring Certificates ─────────────────────────────────────
    private async Task HandleExpiringCertificatesClick()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);

        var expiring = Persons.Where(c => c.Certificates.Any(a => a.ExpiryDate <= today.AddDays(30))).ToList();

        await OnShowExpiringCertificatesClicked.InvokeAsync(expiring);
    }
}