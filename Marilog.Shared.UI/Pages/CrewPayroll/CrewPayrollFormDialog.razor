@using Marilog.Contracts.DTOs.Requests.CrewPayrollDTOs
@using Marilog.Contracts.DTOs.Responses
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.CrewPayroll

@* ────────────────────────────────────────────────────────────────────────────
   CrewPayrollFormDialog
   One dialog for Create and Edit (Edit = Draft only).
   WorkingDays / BasicWage are never user input — the server computes them
   from the contract: full calendar month = full MonthlyWage, otherwise
   service days × (MonthlyWage ÷ 30).
   Contract and month are fixed after creation.
   ──────────────────────────────────────────────────────────────────────── *@
<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@this">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" @bind-Value="_contractId"
                               Label="Contract"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Required="true"
                               RequiredError="Contract is required"
                               Disabled="@_isEdit"
                               HelperText="@(_isEdit ? "Not editable after creation" : null)"
                               ToStringFunc="@(id => Contracts.FirstOrDefault(c => c.ContractId == id)?.PersonFullName ?? id.ToString())">
                        @foreach (var contract in Contracts)
                        {
                            <MudSelectItem Value="@contract.ContractId">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2">@contract.PersonFullName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @contract.Rank · @contract.VesselName
                                    </MudText>
                                </MudStack>
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_payrollMonthDate"
                                   Label="Payroll Month"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Required="true"
                                   RequiredError="Payroll month is required"
                                   Disabled="@_isEdit"
                                   Editable="true"
                                   HelperText="@(_isEdit ? "Not editable after creation" : "Any day in the target month works")" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="_currencyCode"
                               Label="Currency"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Required="true"
                               RequiredError="Currency is required"
                               HelperText="All amounts of this payroll are in this currency">
                        @foreach (var currency in CurrencyOptions)
                        {
                            <MudSelectItem Value="@currency">@currency</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @if (_isEdit)
                {
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int" Value="_workingDays" Label="Service Days"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Disabled="true"
                                         HelperText="Recalculated from the contract on save" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal" Value="_basicWage" Label="Basic Wage"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Format="N2" Disabled="true"
                                         HelperText="Recalculated from the contract on save" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true">
                            Basic wage is calculated from the contract: a full calendar month pays the full monthly wage,
                            otherwise service days × (monthly wage ÷ 30).
                        </MudAlert>
                    </MudItem>
                }

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal" @bind-Value="_allowances" Label="Allowances"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Min="0" Format="N2" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal" @bind-Value="_deductions" Label="Deductions"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Min="0" Format="N2" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_notes" Label="Notes"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Lines="2" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;

    /// <summary>Null => Create mode. Non-null => Edit mode.</summary>
    [Parameter] public CrewPayrollResponse? Payroll { get; set; }
    [Parameter] public IReadOnlyList<CrewContractResponse> Contracts { get; set; } = [];

    // Edit this list to match the currencies you pay crew in
    static readonly string[] CommonCurrencies = ["USD", "AED", "EUR", "GBP", "SAR"];

    MudForm _form = default!;
    bool _isEdit;

    int _workingDays;
    decimal _basicWage;
    decimal _allowances;
    decimal _deductions;
    string? _notes;
    string _currencyCode = "USD";
    DateTime? _payrollMonthDate;
    int _contractId;

    // keeps an existing payroll's currency selectable even if it isn't in the common list
    IEnumerable<string> CurrencyOptions =>
        CommonCurrencies.Contains(_currencyCode)
            ? CommonCurrencies
            : CommonCurrencies.Append(_currencyCode);

    protected override void OnParametersSet()
    {
        if (Payroll is null)
            return;

        _isEdit = true;
        _workingDays = Payroll.WorkingDays;
        _basicWage = Payroll.BasicWage;
        _allowances = Payroll.Allowances;
        _deductions = Payroll.Deductions;
        _notes = Payroll.Notes;
        _currencyCode = Payroll.CurrencyCode;
        _payrollMonthDate = Payroll.PayrollMonth.ToDateTime(TimeOnly.MinValue);
        _contractId = Payroll.ContractId;
    }

    void Cancel() => MudDialog.Cancel();

    async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;

        if (!_isEdit && _payrollMonthDate is null)
        {
            Snackbar.Add("Payroll month is required.", Severity.Warning);
            return;
        }

        var allowances = Math.Round(_allowances, 2, MidpointRounding.AwayFromZero);
        var deductions = Math.Round(_deductions, 2, MidpointRounding.AwayFromZero);

        if (!_isEdit)
        {
            var monthDate = _payrollMonthDate!.Value;
            MudDialog.Close(DialogResult.Ok(new CreateCrewPayrollRequest
            {
                ContractId   = _contractId,
                PayrollMonth = new DateOnly(monthDate.Year, monthDate.Month, 1),
                CurrencyCode = _currencyCode,
                Allowances   = allowances,
                Deductions   = deductions,
                Notes        = _notes
            }));
        }
        else
        {
            MudDialog.Close(DialogResult.Ok(new UpdateCrewPayrollRequest
            {
                ContractId   = _contractId,
                CurrencyCode = _currencyCode,
                Allowances   = allowances,
                Deductions   = deductions,
                Notes        = _notes
            }));
        }
    }
}