@using Marilog.Contracts.DTOs.Requests.CrewPayrollDTOs
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.CrewPayroll

<MudDialog>
    <DialogContent>

        @* ── Step 1: Payment Method ─────────────────────────────── *@
        @if (_method is null)
        {
            <MudText Typo="Typo.subtitle2" Class="mb-4">Select Payment Method</MudText>
            <MudStack Spacing="2">

                <MudButton FullWidth="true"
                           Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Money"
                           OnClick="() => _method = PaymentMethod.CashOnBoard">
                    Cash On Board
                </MudButton>

                <MudButton FullWidth="true"
                           Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.AccountBalance"
                           OnClick="() => _method = PaymentMethod.CashAtOffice">
                    Office Payment
                </MudButton>

                <MudButton FullWidth="true"
                           Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.SwapHoriz"
                           OnClick="() => _method = PaymentMethod.BankTransfer">
                    Bank Transfer
                </MudButton>

            </MudStack>
        }

        @* ── Step 2: Form ───────────────────────────────────────── *@
        else
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="1">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                               Size="Size.Small"
                               OnClick="() => _method = null" />
                <MudText Typo="Typo.subtitle2">@MethodLabel</MudText>
                <MudSpacer />
                @if (RemainingBalance > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Remaining: @RemainingBalance.ToString("N2") @CurrencyCode
                    </MudText>
                }
            </MudStack>

            <MudGrid>

                @* ── Shared Fields ───────────────────────────────── *@
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_amount"
                                     Label="@($"Amount ({CurrencyCode})")"
                                     Required="true"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0.01m"
                                     Max="@(RemainingBalance > 0 ? RemainingBalance : decimal.MaxValue)"
                                     Format="N2" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_paidOnDate"
                                   Label="Paid On"
                                   Required="true"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense" />
                </MudItem>

                @* ── Office Fields ───────────────────────────────── *@
                @if (_method == PaymentMethod.CashAtOffice)
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_recipientName"
                                      Label="Recipient Name"
                                      Required="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_recipientIdNumber"
                                      Label="Recipient ID Number"
                                      Required="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudItem>
                }

                @* ── Reference ───────────────────────────────────── *@
                <MudItem xs="12">
                    <MudTextField @bind-Value="_reference"
                                  Label="@ReferenceLabel"
                                  Required="@(_method == PaymentMethod.BankTransfer)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                @* ── Notes ───────────────────────────────────────── *@
                <MudItem xs="12">
                    <MudTextField @bind-Value="_notes"
                                  Label="Notes"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="2" />
                </MudItem>

            </MudGrid>
        }

    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        @if (_method is not null)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(!IsValid)"
                       OnClick="Submit">
                Pay
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Optional — pre-fills the amount and caps it. 0 = no cap.</summary>
    [Parameter] public decimal RemainingBalance { get; set; }

    [Parameter] public string CurrencyCode { get; set; } = "USD";

    private PaymentMethod? _method;
    private decimal _amount;
    private DateTime? _paidOnDate = DateTime.Today;
    private string _recipientName = string.Empty;
    private string _recipientIdNumber = string.Empty;
    private string? _reference;
    private string? _notes;

    protected override void OnInitialized()
    {
        if (RemainingBalance > 0)
            _amount = RemainingBalance;
    }

    private string MethodLabel => _method switch
    {
        PaymentMethod.CashOnBoard => "Cash On Board",
        PaymentMethod.CashAtOffice => "Office Payment",
        PaymentMethod.BankTransfer => "Bank Transfer",
        _ => string.Empty
    };

    private string ReferenceLabel => _method switch
    {
        PaymentMethod.CashOnBoard => "Voucher No. (optional)",
        PaymentMethod.CashAtOffice => "Receipt No. (optional)",
        PaymentMethod.BankTransfer => "Bank Reference",
        _ => "Reference"
    };

    private bool AmountIsValid =>
        _amount > 0 && (RemainingBalance <= 0 || _amount <= RemainingBalance);

    private bool IsValid => _method switch
    {
        PaymentMethod.CashOnBoard => AmountIsValid && _paidOnDate is not null,
        PaymentMethod.CashAtOffice => AmountIsValid && _paidOnDate is not null
                                             && !string.IsNullOrWhiteSpace(_recipientName)
                                             && !string.IsNullOrWhiteSpace(_recipientIdNumber),
        PaymentMethod.BankTransfer => AmountIsValid && _paidOnDate is not null
                                             && !string.IsNullOrWhiteSpace(_reference),
        _ => false
    };

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        var isOffice = _method == PaymentMethod.CashAtOffice;

        var request = new PayCrewPayrollRequest
        {
            Method = _method!.Value,
            Amount = Math.Round(_amount, 2, MidpointRounding.AwayFromZero),
            PaidOn = DateOnly.FromDateTime(_paidOnDate!.Value),
            RecipientName = isOffice ? _recipientName : null,
            RecipientIdNumber = isOffice ? _recipientIdNumber : null,
            Reference = _reference,
            Notes = _notes
        };

        MudDialog.Close(DialogResult.Ok(request));
    }
}