@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.CrewPayroll

<MudGrid>

    @* ── List ─────────────────────────────────────────────────── *@
    <MudItem xs="12" md="@(Selected is null ? 12 : 7)">
        <MudPaper Class="pa-4" Elevation="2">

            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">Crew Payroll</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_search"
                              Placeholder="Search..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mr-2"
                              Style="max-width:220px" />
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlaylistAdd"
                           Class="mr-2"
                           OnClick="OnGenerateClicked">
                    Generate Month
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OnAddClicked">
                    New
                </MudButton>
            </MudStack>

            <MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0" Rounded="true" Class="mb-3">

                @* ── By Month ──────────────────────────────────── *@
                <MudTabPanel Text="By Month">
                    <MudDatePicker Date="_selectedMonth"
                                   Label="Month"
                                   OpenTo="OpenTo.Month"
                                   FixDay="1"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="mb-3"
                                   Style="max-width:200px"
                                   DateChanged="HandleMonthChanged" />
                    <PayrollTable Items="_filteredByMonth"
                                  Selected="Selected"
                                  OnRowSelected="SelectRow"
                                  OnEditClicked="OnEditClicked"
                                  OnDeleteClicked="OnDeleteClicked"
                                  OnCommentsClicked="OnCommentsClicked"
                                  OnManageAttachedFilesClicked="OnManageAttachedFilesClicked" />
                </MudTabPanel>

                @* ── By Status ─────────────────────────────────── *@
                <MudTabPanel Text="By Status">
                    <MudSelect T="PayrollStatus"
                               Value="_selectedStatus"
                               ValueChanged="HandleStatusChanged"
                               Label="Status"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="mb-3"
                               Style="max-width:200px">
                        @foreach (var s in Enum.GetValues<PayrollStatus>())
                        {
                            <MudSelectItem T="PayrollStatus" Value="s">@s</MudSelectItem>
                        }
                    </MudSelect>
                    <PayrollTable Items="_filteredByStatus"
                                  Selected="Selected"
                                  OnRowSelected="SelectRow"
                                  OnEditClicked="OnEditClicked"
                                  OnDeleteClicked="OnDeleteClicked"
                                  OnCommentsClicked="OnCommentsClicked"
                                  OnManageAttachedFilesClicked="OnManageAttachedFilesClicked" />
                </MudTabPanel>

                @* ── Outstanding ───────────────────────────────── *@
                <MudTabPanel Text="Outstanding">
                    <PayrollTable Items="_filteredOutstanding"
                                  Selected="Selected"
                                  OnRowSelected="SelectRow"
                                  OnEditClicked="OnEditClicked"
                                  OnDeleteClicked="OnDeleteClicked"
                                  OnCommentsClicked="OnCommentsClicked"
                                  OnManageAttachedFilesClicked="OnManageAttachedFilesClicked" />
                </MudTabPanel>

            </MudTabs>

        </MudPaper>
    </MudItem>

    @* ── Detail Panel ──────────────────────────────────────────── *@
    @if (Selected is { } p)
    {
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4" Elevation="2">
                <PayrollDetails Payroll="p"
                                OnClose="ClosePanel"
                                OnEditClicked="OnEditClicked"
                                OnDeleteClicked="OnDeleteClicked"
                                OnApproveClicked="OnApproveClicked"
                                OnCancelClicked="OnCancelClicked"
                                OnPayClicked="OnPayClicked"
                                OnConfirmDisbursementClicked="OnConfirmDisbursementClicked"
                                OnCancelDisbursementClicked="OnCancelDisbursementClicked"
                                OnManageAttachedFilesClicked="OnManageAttachedFilesClicked"
                                OnCommentsClicked="OnCommentsClicked" />

            </MudPaper>
        </MudItem>
    }

</MudGrid>

@code {
    [Parameter] public IReadOnlyList<CrewPayrollResponse> PayrollByMonth { get; set; } = [];
    [Parameter] public IReadOnlyList<CrewPayrollResponse> PayrollByStatus { get; set; } = [];
    [Parameter] public IReadOnlyList<CrewPayrollResponse> Outstanding { get; set; } = [];

    /// <summary>Full payroll (with disbursements), loaded by the host. Null = panel closed.</summary>
    [Parameter] public CrewPayrollResponse? Selected { get; set; }
    [Parameter] public EventCallback<CrewPayrollResponse?> OnSelectedChanged { get; set; }

    [Parameter] public EventCallback OnAddClicked { get; set; }
    [Parameter] public EventCallback<CrewPayrollResponse> OnEditClicked { get; set; }
    [Parameter] public EventCallback<CrewPayrollResponse> OnDeleteClicked { get; set; }
    [Parameter] public EventCallback<CrewPayrollResponse> OnApproveClicked { get; set; }
    [Parameter] public EventCallback<CrewPayrollResponse> OnCancelClicked { get; set; }
    [Parameter] public EventCallback<CrewPayrollResponse> OnPayClicked { get; set; }
    [Parameter] public EventCallback<(int payrollId, DisbursementResponse disbursement)> OnConfirmDisbursementClicked { get; set; }
    [Parameter] public EventCallback<(int payrollId, DisbursementResponse disbursement)> OnCancelDisbursementClicked { get; set; }
    [Parameter] public EventCallback<PayrollStatus?> OnStatusChanged { get; set; }
    [Parameter] public EventCallback<DateOnly> OnMonthSelected { get; set; }
    [Parameter] public EventCallback<(int entityId, EntityType entityType)> OnManageAttachedFilesClicked { get; set; }
    [Parameter] public EventCallback<(int entityId, EntityType entityType)> OnCommentsClicked { get; set; }

    [Parameter] public EventCallback OnGenerateClicked { get; set; }

    private string _search = string.Empty;
    private int _activeTab;
    private DateTime? _selectedMonth = DateTime.Today;
    private PayrollStatus _selectedStatus = PayrollStatus.Draft;

    private IEnumerable<CrewPayrollResponse> _filteredByMonth => Filter(PayrollByMonth);
    private IEnumerable<CrewPayrollResponse> _filteredByStatus => Filter(PayrollByStatus);
    private IEnumerable<CrewPayrollResponse> _filteredOutstanding => Filter(Outstanding);

    private IEnumerable<CrewPayrollResponse> Filter(IEnumerable<CrewPayrollResponse> source) =>
        string.IsNullOrWhiteSpace(_search)
            ? source
            : source.Where(p =>
                (p.PersonFullName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.VesselName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

    private Task SelectRow(CrewPayrollResponse payroll) => OnSelectedChanged.InvokeAsync(payroll);
    private Task ClosePanel() => OnSelectedChanged.InvokeAsync(null);

    private async Task HandleMonthChanged(DateTime? date)
    {
        _selectedMonth = date;
        if (date.HasValue)
            await OnMonthSelected.InvokeAsync(DateOnly.FromDateTime(date.Value));
    }

    private async Task HandleStatusChanged(PayrollStatus status)
    {
        _selectedStatus = status;
        await OnStatusChanged.InvokeAsync(status);
    }

   
}