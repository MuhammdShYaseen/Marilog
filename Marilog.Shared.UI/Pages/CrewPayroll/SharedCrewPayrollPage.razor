@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.CrewPayroll

<MudGrid>

    @* ── List ─────────────────────────────────────────────────── *@
    <MudItem xs="12" md="@(Selected is null ? 12 : 7)">
        <MudPaper Class="pa-4" Elevation="2">

            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">Crew Payroll</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_search"
                              Placeholder="Search..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mr-2"
                              Style="max-width:220px" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OnAddClicked">
                    New
                </MudButton>
            </MudStack>

            <MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0" Rounded="true" Class="mb-3">

                @* ── By Month ──────────────────────────────────── *@
                <MudTabPanel Text="By Month">
                    <MudDatePicker Date="_selectedMonth"
                                   Label="Month"
                                   OpenTo="OpenTo.Month"
                                   FixDay="1"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="mb-3"
                                   Style="max-width:200px"
                                   DateChanged="HandleMonthChanged" />
                    <PayrollTable Items="_filteredByMonth"
                                  Selected="Selected"
                                  OnRowSelected="SelectRow"
                                  OnEditClicked="OnEditClicked"
                                  OnDeleteClicked="OnDeleteClicked"
                                  OnManageAttachedFilesClicked="OnManageAttachedFilesClicked" />
                </MudTabPanel>

                @* ── By Status ─────────────────────────────────── *@
                <MudTabPanel Text="By Status">
                    <MudSelect T="PayrollStatus"
                               Value="_selectedStatus"
                               ValueChanged="HandleStatusChanged"
                               Label="Status"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="mb-3"
                               Style="max-width:200px">
                        @foreach (var s in Enum.GetValues<PayrollStatus>())
                        {
                            <MudSelectItem T="PayrollStatus" Value="s">@s</MudSelectItem>
                        }
                    </MudSelect>
                    <PayrollTable Items="_filteredByStatus"
                                  Selected="Selected"
                                  OnRowSelected="SelectRow"
                                  OnEditClicked="OnEditClicked"
                                  OnDeleteClicked="OnDeleteClicked"
                                  OnManageAttachedFilesClicked="OnManageAttachedFilesClicked" />
                </MudTabPanel>

                @* ── Outstanding ───────────────────────────────── *@
                <MudTabPanel Text="Outstanding">
                    <PayrollTable Items="_filteredOutstanding"
                                  Selected="Selected"
                                  OnRowSelected="SelectRow"
                                  OnEditClicked="OnEditClicked"
                                  OnDeleteClicked="OnDeleteClicked"
                                  OnManageAttachedFilesClicked="OnManageAttachedFilesClicked" />
                </MudTabPanel>

            </MudTabs>

        </MudPaper>
    </MudItem>

    @* ── Detail Panel ──────────────────────────────────────────── *@
    @if (Selected is { } p)
    {
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4" Elevation="2">

                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.h6">@p.PersonFullName</MudText>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Size="Size.Small"
                                   OnClick="ClosePanel" />
                </MudStack>

                <MudDivider Class="mb-3" />

                <MudGrid Spacing="2">
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Vessel</MudText>
                        <MudText Typo="Typo.body2">@p.VesselName</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Month</MudText>
                        <MudText Typo="Typo.body2">@p.PayrollMonth.ToString("MMM yyyy")</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Service Days</MudText>
                        <MudText Typo="Typo.body2">@p.WorkingDays</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
                        <MudChip T="string" Color="@StatusColor(p.Status)" Size="Size.Small">
                            @p.Status
                        </MudChip>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Basic Wage</MudText>
                        <MudText Typo="Typo.body2">@Money(p.BasicWage)</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Allowances</MudText>
                        <MudText Typo="Typo.body2">@Money(p.Allowances)</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Deductions</MudText>
                        <MudText Typo="Typo.body2">@Money(p.Deductions)</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Gross Amount</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight:600">@Money(p.GrossAmount)</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total Disbursed</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Success">@Money(p.TotalDisbursed)</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Remaining Balance</MudText>
                        <MudText Typo="Typo.body2" Color="@(p.RemainingBalance > 0 ? Color.Warning : Color.Success)">
                            @Money(p.RemainingBalance)
                        </MudText>
                    </MudItem>
                    @if (!string.IsNullOrWhiteSpace(p.Notes))
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Notes</MudText>
                            <MudText Typo="Typo.body2">@p.Notes</MudText>
                        </MudItem>
                    }
                    @if (!string.IsNullOrWhiteSpace(p.CancelReason))
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Cancel Reason</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Error">@p.CancelReason</MudText>
                        </MudItem>
                    }
                </MudGrid>

                <MudDivider Class="my-3" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">Disbursements</MudText>

                @if (HasPendingOnly(p))
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                        Full amount recorded. Confirm the pending disbursements to close this payroll.
                    </MudAlert>
                }

                @if (p.Disbursements?.Any() == true)
                {
                    foreach (var d in p.Disbursements)
                    {
                        <MudPaper Class="pa-2 mb-2" Outlined="true">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudText Typo="Typo.body2" Style="font-weight:600">@Money(d.Amount)</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">@MethodLabel(d.Method)</MudChip>
                                <MudSpacer />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@d.PaidOn.ToString("dd MMM yyyy")</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@DisbursementStatusColor(d.Status)">
                                    @d.Status
                                </MudChip>
                            </MudStack>

                            @if (!string.IsNullOrWhiteSpace(d.Reference))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">Ref: @d.Reference</MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(d.RecipientName))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                    Collected by: @d.RecipientName · ID @d.RecipientIdNumber
                                </MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(d.Notes))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@d.Notes</MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(d.CancelReason))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1">Cancelled: @d.CancelReason</MudText>
                            }

                            @if (d.Status == DisbursementStatus.Pending)
                            {
                                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1" Class="mt-1">
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               Color="Color.Success"
                                               StartIcon="@Icons.Material.Filled.Check"
                                               OnClick="() => OnConfirmDisbursementClicked.InvokeAsync((p.Id, d))">
                                        Confirm
                                    </MudButton>
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.Close"
                                               OnClick="() => OnCancelDisbursementClicked.InvokeAsync((p.Id, d))">
                                        Cancel
                                    </MudButton>
                                </MudStack>
                            }
                        </MudPaper>
                    }
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No disbursements.</MudText>
                }

                <MudDivider Class="my-3" />

                <MudStack Row="true" Spacing="2" Class="flex-wrap">
                    @if (p.Status == PayrollStatus.Draft)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="() => OnEditClicked.InvokeAsync(p)">
                            Edit
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.CheckCircle"
                                   OnClick="() => OnApproveClicked.InvokeAsync(p)">
                            Approve
                        </MudButton>
                    }
                    @if (CanPay(p))
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.Payment"
                                   OnClick="() => OnPayClicked.InvokeAsync(p)">
                            Pay
                        </MudButton>
                    }
                    @if (CanCancel(p))
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   OnClick="() => OnCancelClicked.InvokeAsync(p)">
                            Cancel
                        </MudButton>
                    }
                </MudStack>

            </MudPaper>
        </MudItem>
    }

</MudGrid>

@code {
    [Parameter] public IReadOnlyList<CrewPayrollResponse> PayrollByMonth { get; set; } = [];
    [Parameter] public IReadOnlyList<CrewPayrollResponse> PayrollByStatus { get; set; } = [];
    [Parameter] public IReadOnlyList<CrewPayrollResponse> Outstanding { get; set; } = [];

    /// <summary>Full payroll (with disbursements), loaded by the host. Null = panel closed.</summary>
    [Parameter] public CrewPayrollResponse? Selected { get; set; }
    [Parameter] public EventCallback<CrewPayrollResponse?> OnSelectedChanged { get; set; }

    [Parameter] public EventCallback OnAddClicked { get; set; }
    [Parameter] public EventCallback<CrewPayrollResponse> OnEditClicked { get; set; }
    [Parameter] public EventCallback<CrewPayrollResponse> OnDeleteClicked { get; set; }
    [Parameter] public EventCallback<CrewPayrollResponse> OnApproveClicked { get; set; }
    [Parameter] public EventCallback<CrewPayrollResponse> OnCancelClicked { get; set; }
    [Parameter] public EventCallback<CrewPayrollResponse> OnPayClicked { get; set; }
    [Parameter] public EventCallback<(int payrollId, DisbursementResponse disbursement)> OnConfirmDisbursementClicked { get; set; }
    [Parameter] public EventCallback<(int payrollId, DisbursementResponse disbursement)> OnCancelDisbursementClicked { get; set; }
    [Parameter] public EventCallback<PayrollStatus?> OnStatusChanged { get; set; }
    [Parameter] public EventCallback<DateOnly> OnMonthSelected { get; set; }
    [Parameter] public EventCallback<(int entityId, EntityType entityType)> OnManageAttachedFilesClicked { get; set; }

    private string _search = string.Empty;
    private int _activeTab;
    private DateTime? _selectedMonth = DateTime.Today;
    private PayrollStatus _selectedStatus = PayrollStatus.Draft;

    private IEnumerable<CrewPayrollResponse> _filteredByMonth => Filter(PayrollByMonth);
    private IEnumerable<CrewPayrollResponse> _filteredByStatus => Filter(PayrollByStatus);
    private IEnumerable<CrewPayrollResponse> _filteredOutstanding => Filter(Outstanding);

    private IEnumerable<CrewPayrollResponse> Filter(IEnumerable<CrewPayrollResponse> source) =>
        string.IsNullOrWhiteSpace(_search)
            ? source
            : source.Where(p =>
                (p.PersonFullName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.VesselName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

    private Task SelectRow(CrewPayrollResponse payroll) => OnSelectedChanged.InvokeAsync(payroll);
    private Task ClosePanel() => OnSelectedChanged.InvokeAsync(null);

    private async Task HandleMonthChanged(DateTime? date)
    {
        _selectedMonth = date;
        if (date.HasValue)
            await OnMonthSelected.InvokeAsync(DateOnly.FromDateTime(date.Value));
    }

    private async Task HandleStatusChanged(PayrollStatus status)
    {
        _selectedStatus = status;
        await OnStatusChanged.InvokeAsync(status);
    }

    // ── Rules mirrored from the domain (server still enforces them) ──────────
    private static bool CanPay(CrewPayrollResponse p) =>
        p.Status is PayrollStatus.Approved or PayrollStatus.PartiallyPaid && p.RemainingBalance > 0;

    private static bool CanCancel(CrewPayrollResponse p) =>
        p.Status != PayrollStatus.Cancelled && p.TotalDisbursed == 0;

    private static bool HasPendingOnly(CrewPayrollResponse p) =>
        p.Status == PayrollStatus.PartiallyPaid && p.RemainingBalance <= 0;

    private string Money(decimal value) => $"{value:N2} {Selected?.CurrencyCode}";

    private static string MethodLabel(PaymentMethod? method) => method switch
    {
        PaymentMethod.CashOnBoard => "Cash On Board",
        PaymentMethod.CashAtOffice => "Office",
        PaymentMethod.BankTransfer => "Bank Transfer",
        _ => method?.ToString() ?? string.Empty
    };

    private static Color StatusColor(PayrollStatus status) => status switch
    {
        PayrollStatus.Draft => Color.Default,
        PayrollStatus.Approved => Color.Success,
        PayrollStatus.PartiallyPaid => Color.Warning,
        PayrollStatus.FullyPaid => Color.Info,
        PayrollStatus.Cancelled => Color.Error,
        _ => Color.Default
    };

    private static Color DisbursementStatusColor(DisbursementStatus? status) => status switch
    {
        DisbursementStatus.Confirmed => Color.Success,
        DisbursementStatus.Pending => Color.Warning,
        DisbursementStatus.Cancelled => Color.Error,
        _ => Color.Default
    };
}