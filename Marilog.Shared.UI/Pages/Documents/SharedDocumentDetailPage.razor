@using Marilog.Contracts.DTOs.Responses
@using MudBlazor
@using Kernel.Enums
@namespace Marilog.Shared.UI.Pages.Documents

@if (Document is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @* ── Sticky header with primary actions ──────────────────── *@
    <MudPaper Class="pa-3 mb-4" Elevation="2" Style="position:sticky; top:0; z-index:10;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="OnBackClicked" />

            <MudStack Spacing="0">
                <MudText Typo="Typo.h5">@Document.DocNumber</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @(Document.DocTypeName ?? "—") &middot; @Document.DocDate.ToString("dd MMM yyyy")
                </MudText>
            </MudStack>

            <MudChip T="string"
                     Color="@(Document.IsFullyPaid ? Color.Success : Color.Warning)"
                     Size="Size.Small">
                @(Document.IsFullyPaid ? "Fully Paid" : "Unpaid")
            </MudChip>

            @if (!Document.IsActive)
            {
                <MudChip T="string" Color="Color.Error" Size="Size.Small">Inactive</MudChip>
            }

            <MudSpacer />

            <MudStack Row="true" Spacing="1">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Payment"
                           OnClick="() => OnAddPaymentClicked.InvokeAsync(Document)"
                           Disabled="Document.IsFullyPaid">
                    Add Payment
                </MudButton>
                <MudTooltip Text="Edit">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   OnClick="() => OnEditClicked.InvokeAsync(Document)" />
                </MudTooltip>
                <MudTooltip Text="Attachments">
                    <MudIconButton Icon="@Icons.Material.Filled.Receipt"
                                   Color="Color.Default"
                                   OnClick="() => OnManageAttachedFilesClicked.InvokeAsync((Document.Id, EntityType.Document))" />
                </MudTooltip>
                <MudTooltip Text="Delete">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   OnClick="() => OnDeleteClicked.InvokeAsync(Document)" />
                </MudTooltip>
            </MudStack>
        </MudStack>
    </MudPaper>

    @* ── Validation alert — only shown when there's a mismatch ── *@
    @if (!Document.Is_TotalAmount_Equal_TotalItemsAmount)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4" Icon="@Icons.Material.Filled.WarningAmber">
            Document total (@Document.TotalAmount.ToString("N2") @Document.CurrencyCode) doesn't match
            items total (@Document.TotalItemsAmount.ToString("N2") @Document.CurrencyCode) —
            difference of @Document.TotalAmount_Minus_TotalItemsAmount.ToString("N2") @Document.CurrencyCode.
        </MudAlert>
    }

    <MudGrid>

        @* ── Header Info ───────────────────────────────────────── *@
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-1" />
                    Document Info
                </MudText>
                <MudGrid Spacing="3">
                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Currency</MudText>
                        <MudText Typo="Typo.body2">@Document.CurrencyCode</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Reference</MudText>
                        <MudText Typo="Typo.body2">@(Document.Reference ?? "—")</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Supplier</MudText>
                        <MudText Typo="Typo.body2">@(Document.SupplierName ?? "—")</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Buyer</MudText>
                        <MudText Typo="Typo.body2">@(Document.BuyerName ?? "—")</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Vessel</MudText>
                        <MudText Typo="Typo.body2">@(Document.VesselName ?? "—")</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Port</MudText>
                        <MudText Typo="Typo.body2">@(Document.PortName ?? "—")</MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @* ── Items Validation ─────────────────────────────── *@
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" Class="mr-1" />
                    Items Validation
                </MudText>
                <MudStack Spacing="2">
                    <MudStack Row="true">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Items Total</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.body2" Style="font-weight:600">
                            @Document.TotalItemsAmount.ToString("N2") @Document.CurrencyCode
                        </MudText>
                    </MudStack>
                    <MudStack Row="true">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Difference</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.body2"
                                 Color="@(Document.TotalAmount_Minus_TotalItemsAmount == 0 ? Color.Success : Color.Warning)"
                                 Style="font-weight:600">
                            @Document.TotalAmount_Minus_TotalItemsAmount.ToString("N2") @Document.CurrencyCode
                        </MudText>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Validation</MudText>
                        <MudSpacer />
                        @if (Document.Is_TotalAmount_Equal_TotalItemsAmount)
                        {
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small"
                                     Icon="@Icons.Material.Filled.CheckCircle">
                                Matched
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Size="Size.Small"
                                     Icon="@Icons.Material.Filled.ErrorOutline">
                                Mismatch
                            </MudChip>
                        }
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>

        @* ── Financial Summary ─────────────────────────────────── *@
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" Class="mr-1" />
                    Financial Summary
                </MudText>
                <MudStack Spacing="2">
                    <MudStack Row="true">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Total Amount</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.body2" Style="font-weight:600">
                            @Document.TotalAmount.ToString("N2") @Document.CurrencyCode
                        </MudText>
                    </MudStack>
                    <MudStack Row="true">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Total Paid</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.body2" Color="Color.Success">
                            @Document.TotalPaid.ToString("N2") @Document.CurrencyCode
                        </MudText>
                    </MudStack>
                    <MudDivider />
                    <MudStack Row="true">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Remaining</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.body2"
                                 Color="@(Document.RemainingBalance > 0 ? Color.Warning : Color.Success)"
                                 Style="font-weight:600">
                            @Document.RemainingBalance.ToString("N2") @Document.CurrencyCode
                        </MudText>
                    </MudStack>
                </MudStack>

                <MudExpansionPanels Class="mt-3" Elevation="0">
                    <MudExpansionPanel Text="@($"Base currency ({Document.CurrencyCodeBase})")" Dense="true">
                        <MudStack Spacing="2">
                            <MudStack Row="true">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Total</MudText>
                                <MudSpacer />
                                <MudText Typo="Typo.body2" Style="font-weight:600">
                                    @Document.TotalAmountBase.ToString("N2") @Document.CurrencyCodeBase
                                </MudText>
                            </MudStack>
                            <MudStack Row="true">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Paid</MudText>
                                <MudSpacer />
                                <MudText Typo="Typo.body2" Color="Color.Success">
                                    @Document.PaidAmountBase.ToString("N2") @Document.CurrencyCodeBase
                                </MudText>
                            </MudStack>
                            <MudStack Row="true">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Remaining</MudText>
                                <MudSpacer />
                                <MudText Typo="Typo.body2"
                                         Color="@(Document.RemainingBase > 0 ? Color.Warning : Color.Success)"
                                         Style="font-weight:600">
                                    @Document.RemainingBase.ToString("N2") @Document.CurrencyCodeBase
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudPaper>
        </MudItem>

        @* ── Items ─────────────────────────────────────────────── *@
        <MudItem xs="12">
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.subtitle1">
                        <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" Class="mr-1" />
                        Items
                    </MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="() => OnAddItemClicked.InvokeAsync(Document)">
                        Add Item
                    </MudButton>
                </MudStack>
                <MudTable Items="Document.Items" Dense="true" Hover="true" Striped="true">
                    <HeaderContent>
                        <MudTh>Product</MudTh>
                        <MudTh>Qty</MudTh>
                        <MudTh>Unit</MudTh>
                        <MudTh Style="text-align:right">Unit Price</MudTh>
                        <MudTh Style="text-align:right">Line Total</MudTh>
                        <MudTh Style="width:96px"></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.ProductName</MudTd>
                        <MudTd>@context.Quantity.ToString("N2")</MudTd>
                        <MudTd>@(context.Unit ?? "—")</MudTd>
                        <MudTd Style="text-align:right">@context.UnitPrice.ToString("N2")</MudTd>
                        <MudTd Style="text-align:right; font-weight:600">@context.LineTotal.ToString("N2")</MudTd>
                        <MudTd>
                            <MudStack Row="true" Spacing="0">
                                <MudTooltip Text="Edit">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   OnClick="() => OnEditItemClicked.InvokeAsync((Document.Id, context))" />
                                </MudTooltip>
                                <MudTooltip Text="Delete">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="() => OnRemoveItemClicked.InvokeAsync((Document.Id, context.Id))" />
                                </MudTooltip>
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Color="Color.Secondary">No items yet.</MudText>
                    </NoRecordsContent>
                    <FooterContent>
                        <MudTd colspan="4">
                            <MudText Typo="Typo.body2" Style="font-weight:600">Total</MudText>
                        </MudTd>
                        <MudTd Style="text-align:right">
                            <MudText Typo="Typo.body2" Style="font-weight:600">
                                @Document.Items.Sum(i => i.LineTotal).ToString("N2")
                            </MudText>
                        </MudTd>
                        <MudTd />
                    </FooterContent>
                </MudTable>
            </MudPaper>
        </MudItem>

        @* ── Payments ──────────────────────────────────────────── *@
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Small" Class="mr-1" />
                    Payments
                </MudText>
                <MudTable Items="Document.Payments" Dense="true" Hover="true" Striped="true">
                    <HeaderContent>
                        <MudTh>SWIFT Ref</MudTh>
                        <MudTh>Payment Method</MudTh>
                        <MudTh>Date</MudTh>
                        <MudTh Style="text-align:right">Amount</MudTh>
                        <MudTh Style="width:96px"></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@(context.SwiftTransfer?.SwiftReference ?? "—")</MudTd>
                        <MudTd>@context.PaymentMethod.ToString()</MudTd>
                        <MudTd>@context.PaymentDate.ToString("dd MMM yyyy")</MudTd>
                        <MudTd Style="text-align:right; font-weight:600">@context.PaidAmount.ToString("N2")</MudTd>
                        <MudTd>
                            <MudStack Row="true" Spacing="0">
                                <MudTooltip Text="Edit">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   OnClick="() => OnEditPaymentClicked.InvokeAsync((Document, context))" />
                                </MudTooltip>
                                <MudTooltip Text="Delete">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="() => OnRemovePaymentClicked.InvokeAsync((Document.Id, context.Id))" />
                                </MudTooltip>
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Color="Color.Secondary">No payments recorded.</MudText>
                    </NoRecordsContent>
                    <FooterContent>
                        <MudTd colspan="3">
                            <MudText Typo="Typo.body2" Style="font-weight:600">Total Paid</MudText>
                        </MudTd>
                        <MudTd Style="text-align:right">
                            <MudText Typo="Typo.body2" Style="font-weight:600">
                                @Document.Payments.Sum(p => p.PaidAmount).ToString("N2")
                            </MudText>
                        </MudTd>
                        <MudTd />
                    </FooterContent>
                </MudTable>
            </MudPaper>
        </MudItem>

    </MudGrid>
}

@code {
    [Parameter] public EventCallback<(DocumentResponse doc, PaymentResponse Payment)> OnEditPaymentClicked { get; set; }
    [Parameter] public EventCallback<(int DocumentId, int PaymentId)> OnRemovePaymentClicked { get; set; }
    [Parameter] public DocumentResponse? Document { get; set; }
    [Parameter] public EventCallback OnBackClicked { get; set; }
    [Parameter] public EventCallback<DocumentResponse> OnEditClicked { get; set; }
    [Parameter] public EventCallback<DocumentResponse> OnDeleteClicked { get; set; }
    [Parameter] public EventCallback<DocumentResponse> OnAddPaymentClicked { get; set; }
    [Parameter] public EventCallback<DocumentResponse> OnAddItemClicked { get; set; }
    [Parameter] public EventCallback<(int DocumentId, DocumentItemResponse Item)> OnEditItemClicked { get; set; }
    [Parameter] public EventCallback<(int DocumentId, int ItemId)> OnRemoveItemClicked { get; set; }
    [Parameter] public EventCallback<(int entityId, EntityType entityType)> OnManageAttachedFilesClicked { get; set; }
}
