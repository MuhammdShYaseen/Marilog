@using Marilog.Contracts.DTOs.Responses
@using MudBlazor
@using Kernel.Enums
@namespace Marilog.Shared.UI.Pages.Documents

@if (Document is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <div class="az-doc">

        @* ── Header: title, status and command bar (sticky) ──────── *@
        <div class="az-doc-header">
            <div class="az-doc-title-row">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" OnClick="OnBackClicked" />

                <div class="az-doc-title">
                    <MudText Typo="Typo.h6">@Document.DocNumber</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @(Document.DocTypeName ?? "Document") &middot; @Document.DocDate.ToString("dd MMM yyyy")
                    </MudText>
                </div>

                @if (IsNonFinancial)
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0">Non-financial</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="@(Document.IsFullyPaid ? Color.Success : Color.Warning)"
                             Size="Size.Small" Variant="Variant.Filled" Class="ma-0">
                        @(Document.IsFullyPaid ? "Fully paid" : "Unpaid")
                    </MudChip>
                }

                @if (HasAdjustments)
                {
                    <MudTooltip Text="@($"Original {Document.TotalAmount:N2} → Net {Document.NetAmount:N2} {Document.CurrencyCode}")">
                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0"
                                 Icon="@Icons.Material.Filled.PriceChange">
                            Price adjusted
                        </MudChip>
                    </MudTooltip>
                }

                @if (!Document.IsActive)
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0">Inactive</MudChip>
                }
            </div>

            <div class="az-doc-commandbar">
                <MudTooltip Text="@(IsNonFinancial ? "No financial side — payments not applicable" : string.Empty)">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Payment"
                               Disabled="@(Document.IsFullyPaid || IsNonFinancial)"
                               OnClick="() => OnAddPaymentClicked.InvokeAsync(Document)">
                        Add payment
                    </MudButton>
                </MudTooltip>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="() => OnEditClicked.InvokeAsync(Document)">
                    Edit
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Receipt"
                           OnClick="() => OnManageAttachedFilesClicked.InvokeAsync((Document.Id, EntityType.Document))">
                    Files
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.Comment"
                           OnClick="() => OnCommentsClicked.InvokeAsync((Document.Id, EntityType.Document))">
                    Comments
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="() => OnDeleteClicked.InvokeAsync(Document)">
                    Delete
                </MudButton>
            </div>
        </div>

        <div class="az-doc-body">

            @* ── Mismatch warning — only when items don't add up ───── *@
            @if (!Document.Is_TotalAmount_Equal_TotalItemsAmount)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Square="true" Icon="@Icons.Material.Filled.WarningAmber">
                    Document total (@Money(Document.TotalAmount)) doesn't match
                    items total (@Money(Document.TotalItemsAmount)) —
                    difference of @Money(Document.TotalAmount_Minus_TotalItemsAmount).
                    @if (HasAdjustments)
                    {
                        <text> This check uses the original amount; price adjustments are excluded.</text>
                    }
                </MudAlert>
            }

            @* ── Amounts ───────────────────────────────────────────── *@
            <div class="az-doc-tiles">
                <div class="az-doc-tile">
                    <div class="az-doc-label">@(HasAdjustments ? "Original amount" : "Total amount")</div>
                    <MudText Typo="Typo.h6">@Money(Document.TotalAmount)</MudText>
                    @if (ShowBase)
                    {
                        <div class="az-doc-base">@BaseMoney(Document.TotalAmountBase)</div>
                    }
                </div>

                @if (HasAdjustments)
                {
                    <div class="az-doc-tile">
                        <div class="az-doc-label">Adjustments</div>
                        <MudText Typo="Typo.h6" Color="Color.Info">@FormatSigned(Document.AdjustmentsTotal) @Document.CurrencyCode</MudText>
                    </div>
                    <div class="az-doc-tile">
                        <div class="az-doc-label">Net amount</div>
                        <MudText Typo="Typo.h6">@Money(Document.NetAmount)</MudText>
                        @if (ShowBase)
                        {
                            <div class="az-doc-base">@BaseMoney(Document.NetAmountBase)</div>
                        }
                    </div>
                }

                <div class="az-doc-tile">
                    <div class="az-doc-label">Total paid</div>
                    <MudText Typo="Typo.h6" Color="Color.Success">@Money(Document.TotalPaid)</MudText>
                    @if (ShowBase)
                    {
                        <div class="az-doc-base">@BaseMoney(Document.PaidAmountBase)</div>
                    }
                </div>

                <div class="az-doc-tile">
                    <div class="az-doc-label">Remaining</div>
                    <MudText Typo="Typo.h6" Color="@(Document.RemainingBalance > 0 ? Color.Warning : Color.Success)">
                        @Money(Document.RemainingBalance)
                    </MudText>
                    @if (ShowBase)
                    {
                        <div class="az-doc-base">@BaseMoney(Document.RemainingBase)</div>
                    }
                </div>
            </div>

            @* ── Essentials ────────────────────────────────────────── *@
            <div class="az-doc-card">
                <div class="az-doc-card-head">
                    <span class="az-doc-section-title">Essentials</span>
                </div>
                <div class="az-doc-card-body">
                    <div class="az-doc-essentials">
                        <div>
                            <div class="az-doc-label">Document type</div>
                            <div class="az-doc-value">@Dash(Document.DocTypeName)</div>
                        </div>
                        <div>
                            <div class="az-doc-label">Document date</div>
                            <div class="az-doc-value">@Document.DocDate.ToString("dd MMM yyyy")</div>
                        </div>
                        <div>
                            <div class="az-doc-label">Due date</div>
                            <div class="az-doc-value">
                                @if (Document.DocDue is DateOnly due)
                                {
                                    <span>@due.ToString("dd MMM yyyy")</span>
                                    @if (DueState is { } state)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@state.Color" Class="ma-0">
                                            @state.Text
                                        </MudChip>
                                    }
                                }
                                else
                                {
                                    <span class="az-doc-muted">—</span>
                                }
                            </div>
                        </div>
                        <div>
                            <div class="az-doc-label">Side</div>
                            <div class="az-doc-value">@SideLabel(Document.Side)</div>
                        </div>
                        <div>
                            <div class="az-doc-label">Reference</div>
                            <div class="az-doc-value">@Dash(Document.Reference)</div>
                        </div>
                        <div>
                            <div class="az-doc-label">Currency</div>
                            <div class="az-doc-value">@Document.CurrencyCode</div>
                        </div>
                        <div>
                            <div class="az-doc-label">Supplier</div>
                            <div class="az-doc-value">@Link(Document.SupplierName, Document.SupplierId, "/companies")</div>
                        </div>
                        <div>
                            <div class="az-doc-label">Buyer</div>
                            <div class="az-doc-value">@Link(Document.BuyerName, Document.BuyerId, "/companies")</div>
                        </div>
                        <div>
                            <div class="az-doc-label">Vessel</div>
                            <div class="az-doc-value">@Link(Document.VesselName, Document.VesselId, "/vessels")</div>
                        </div>
                        <div>
                            <div class="az-doc-label">Port</div>
                            <div class="az-doc-value">@Dash(Document.PortName)</div>
                        </div>
                        <div>
                            <div class="az-doc-label">Voyage</div>
                            <div class="az-doc-value">@Link(Document.VoyageId is null ? null : "View voyage", Document.VoyageId, "/voyages")</div>
                        </div>
                        <div>
                            <div class="az-doc-label">Parent document</div>
                            <div class="az-doc-value">@Link(Document.ParentDocumentId is null ? null : "View parent", Document.ParentDocumentId, "/documents")</div>
                        </div>
                    </div>
                </div>
            </div>

            @* ── Items ─────────────────────────────────────────────── *@
            <div class="az-doc-card">
                <div class="az-doc-card-head">
                    <span class="az-doc-section-title">Items</span>
                    <span class="az-doc-muted">(@Document.Items.Count)</span>
                    <MudTooltip Text="@ItemsCheckTooltip">
                        @if (Document.Is_TotalAmount_Equal_TotalItemsAmount)
                        {
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small" Class="ma-0"
                                     Icon="@Icons.Material.Filled.CheckCircle">
                                Matches total
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small" Class="ma-0"
                                     Icon="@Icons.Material.Filled.ErrorOutline">
                                Mismatch @Money(Document.TotalAmount_Minus_TotalItemsAmount)
                            </MudChip>
                        }
                    </MudTooltip>
                    <MudSpacer />
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="() => OnAddItemClicked.InvokeAsync(Document)">
                        Add item
                    </MudButton>
                </div>
                <MudTable Items="Document.Items" Dense="true" Hover="true" Elevation="0" Square="true">
                    <HeaderContent>
                        <MudTh>Product</MudTh>
                        <MudTh Class="az-num">Qty</MudTh>
                        <MudTh>Unit</MudTh>
                        <MudTh Class="az-num">Unit price</MudTh>
                        <MudTh Class="az-num">Line total</MudTh>
                        <MudTh Style="width:80px"></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.ProductName</MudTd>
                        <MudTd Class="az-num">@context.Quantity.ToString("N2")</MudTd>
                        <MudTd>@Dash(context.Unit)</MudTd>
                        <MudTd Class="az-num">@context.UnitPrice.ToString("N2")</MudTd>
                        <MudTd Class="az-num" Style="font-weight:600">@context.LineTotal.ToString("N2")</MudTd>
                        <MudTd>
                            <div class="az-doc-row-actions">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" title="Edit"
                                               OnClick="() => OnEditItemClicked.InvokeAsync((Document.Id, context))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" title="Delete"
                                               OnClick="() => OnRemoveItemClicked.InvokeAsync((Document.Id, context.Id))" />
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="az-doc-empty">No items yet.</div>
                    </NoRecordsContent>
                    <FooterContent>
                        <MudTd colspan="4" Style="font-weight:600">Items total</MudTd>
                        <MudTd Class="az-num" Style="font-weight:600">@Money(Document.Items.Sum(i => i.LineTotal))</MudTd>
                        <MudTd />
                    </FooterContent>
                </MudTable>
            </div>

            @* ── Price adjustments ─────────────────────────────────── *@
            <div class="az-doc-card">
                <div class="az-doc-card-head">
                    <span class="az-doc-section-title">Price adjustments</span>
                    <span class="az-doc-muted">(@Adjustments.Count)</span>
                    <MudSpacer />
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="() => OnAddAdjustmentClicked.InvokeAsync(Document)">
                        Add adjustment
                    </MudButton>
                </div>
                <MudTable Items="Adjustments" Dense="true" Hover="true" Elevation="0" Square="true">
                    <HeaderContent>
                        <MudTh>Date</MudTh>
                        <MudTh>Reason</MudTh>
                        <MudTh>Type</MudTh>
                        <MudTh Class="az-num">Amount</MudTh>
                        <MudTh Style="width:80px"></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.AdjustmentDate.ToString("dd MMM yyyy")</MudTd>
                        <MudTd>@Dash(context.Reason)</MudTd>
                        <MudTd>
                            @if (context.Amount >= 0)
                            {
                                <MudChip T="string" Color="Color.Warning" Variant="Variant.Text" Size="Size.Small" Class="ma-0"
                                         Icon="@Icons.Material.Filled.TrendingUp">
                                    Increase
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Size="Size.Small" Class="ma-0"
                                         Icon="@Icons.Material.Filled.TrendingDown">
                                    Decrease
                                </MudChip>
                            }
                        </MudTd>
                        <MudTd Class="az-num" Style="font-weight:600">@FormatSigned(context.Amount)</MudTd>
                        <MudTd>
                            <div class="az-doc-row-actions">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" title="Edit"
                                               OnClick="() => OnEditAdjustmentClicked.InvokeAsync((Document, context))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" title="Delete"
                                               OnClick="() => OnRemoveAdjustmentClicked.InvokeAsync((Document.Id, context.Id))" />
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="az-doc-empty">No price adjustments — the document is settled at its original amount.</div>
                    </NoRecordsContent>
                    <FooterContent>
                        <MudTd colspan="3" Style="font-weight:600">Net adjustment</MudTd>
                        <MudTd Class="az-num" Style="font-weight:600">@FormatSigned(Document.AdjustmentsTotal)</MudTd>
                        <MudTd />
                    </FooterContent>
                </MudTable>
                @if (HasAdjustments)
                {
                    <div class="az-doc-note">
                        Payments settle against the net amount (@Money(Document.NetAmount)).
                    </div>
                }
            </div>

            @* ── Payments ──────────────────────────────────────────── *@
            <div class="az-doc-card">
                <div class="az-doc-card-head">
                    <span class="az-doc-section-title">Payments</span>
                    <span class="az-doc-muted">(@Document.Payments.Count)</span>
                </div>
                <MudTable Items="Document.Payments" Dense="true" Hover="true" Elevation="0" Square="true">
                    <HeaderContent>
                        <MudTh>Date</MudTh>
                        <MudTh>Method</MudTh>
                        <MudTh>SWIFT ref</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh Class="az-num">Amount</MudTh>
                        <MudTh Style="width:80px"></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.PaymentDate.ToString("dd MMM yyyy")</MudTd>
                        <MudTd>@context.PaymentMethod</MudTd>
                        <MudTd>@Link(context.SwiftTransfer?.SwiftReference, context.SwiftTransferId, "/swift-transfers")</MudTd>
                        <MudTd>@Dash(context.Discreption)</MudTd>
                        <MudTd Class="az-num" Style="font-weight:600">@context.PaidAmount.ToString("N2")</MudTd>
                        <MudTd>
                            <div class="az-doc-row-actions">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" title="Edit"
                                               OnClick="() => OnEditPaymentClicked.InvokeAsync((Document, context))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" title="Delete"
                                               OnClick="() => OnRemovePaymentClicked.InvokeAsync((Document.Id, context.Id))" />
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="az-doc-empty">No payments recorded.</div>
                    </NoRecordsContent>
                    <FooterContent>
                        <MudTd colspan="4" Style="font-weight:600">Total paid</MudTd>
                        <MudTd Class="az-num" Style="font-weight:600">@Money(Document.Payments.Sum(p => p.PaidAmount))</MudTd>
                        <MudTd />
                    </FooterContent>
                </MudTable>
            </div>

        </div>
    </div>
}

<style>
    .az-doc {
        background-color: var(--mud-palette-background);
        min-height: 100%;
    }

        /* ── Header ── */
        .az-doc .az-doc-header {
            position: sticky;
            top: var(--mud-appbar-height, 0px); /* on its own page: stay below the app bar */
            z-index: 10;
            padding: 8px 16px 0 8px;
            background-color: var(--mud-palette-surface);
            border-bottom: 1px solid var(--mud-palette-lines-default);
        }

    /* inside the drawer the drawer itself scrolls: stick to its top */
    .mud-drawer .az-doc .az-doc-header {
        top: 0;
    }

    .az-doc .az-doc-title-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
    }

    .az-doc .az-doc-title {
        display: flex;
        flex-direction: column;
        margin-right: 8px;
    }

    .az-doc .az-doc-commandbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 2px;
        padding: 4px 0 4px 32px;
    }

        .az-doc .az-doc-commandbar .mud-button-root,
        .az-doc .az-doc-card-head .mud-button-root {
            text-transform: none;
        }

    /* ── Body ── */
    .az-doc .az-doc-body {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 16px;
    }

    /* ── Amount tiles: 1px grid lines between tiles ── */
    .az-doc .az-doc-tiles {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 1px;
        background-color: var(--mud-palette-lines-default);
        border: 1px solid var(--mud-palette-lines-default);
    }

    .az-doc .az-doc-tile {
        padding: 10px 14px;
        background-color: var(--mud-palette-surface);
    }

    .az-doc .az-doc-base {
        font-size: .75rem;
        color: var(--mud-palette-text-secondary);
    }

    /* ── Cards ── */
    .az-doc .az-doc-card {
        background-color: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
    }

    .az-doc .az-doc-card-head {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 40px;
        padding: 4px 12px;
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }

    .az-doc .az-doc-card-body {
        padding: 12px 14px;
    }

    .az-doc .az-doc-section-title {
        text-transform: uppercase;
        font-size: .7rem;
        font-weight: 600;
        letter-spacing: .04em;
        color: var(--mud-palette-text-secondary);
    }

    .az-doc .az-doc-essentials {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 12px 24px;
    }

    .az-doc .az-doc-label {
        font-size: .75rem;
        color: var(--mud-palette-text-secondary);
    }

    .az-doc .az-doc-value {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;
        font-size: .875rem;
        color: var(--mud-palette-text-primary);
    }

    .az-doc .az-doc-muted {
        font-size: .75rem;
        color: var(--mud-palette-text-secondary);
    }

    .az-doc .az-doc-empty {
        padding: 8px 0;
        color: var(--mud-palette-text-secondary);
    }

    .az-doc .az-doc-note {
        padding: 6px 12px;
        font-size: .75rem;
        color: var(--mud-palette-text-secondary);
        border-top: 1px solid var(--mud-palette-lines-default);
    }

    /* ── Tables ── */
    .az-doc .mud-table-head .mud-table-cell {
        text-transform: uppercase;
        font-size: .7rem;
        font-weight: 600;
        letter-spacing: .04em;
        color: var(--mud-palette-text-secondary);
        background-color: var(--mud-palette-background-gray);
    }

    .az-doc .mud-table-cell {
        font-size: .8125rem;
        padding-top: 4px;
        padding-bottom: 4px;
    }

    .az-doc .az-num {
        text-align: right;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .az-doc .az-doc-row-actions {
        display: flex;
        justify-content: flex-end;
        white-space: nowrap;
    }
</style>

@code {
    [Parameter] public DocumentResponse? Document { get; set; }

    [Parameter] public EventCallback OnBackClicked { get; set; }
    [Parameter] public EventCallback<DocumentResponse> OnEditClicked { get; set; }
    [Parameter] public EventCallback<DocumentResponse> OnDeleteClicked { get; set; }

    [Parameter] public EventCallback<DocumentResponse> OnAddItemClicked { get; set; }
    [Parameter] public EventCallback<(int DocumentId, DocumentItemResponse Item)> OnEditItemClicked { get; set; }
    [Parameter] public EventCallback<(int DocumentId, int ItemId)> OnRemoveItemClicked { get; set; }

    [Parameter] public EventCallback<DocumentResponse> OnAddAdjustmentClicked { get; set; }
    [Parameter] public EventCallback<(DocumentResponse Doc, AdjustmentResponse Adjustment)> OnEditAdjustmentClicked { get; set; }
    [Parameter] public EventCallback<(int DocumentId, int AdjustmentId)> OnRemoveAdjustmentClicked { get; set; }

    [Parameter] public EventCallback<DocumentResponse> OnAddPaymentClicked { get; set; }
    [Parameter] public EventCallback<(DocumentResponse doc, PaymentResponse Payment)> OnEditPaymentClicked { get; set; }
    [Parameter] public EventCallback<(int DocumentId, int PaymentId)> OnRemovePaymentClicked { get; set; }

    [Parameter] public EventCallback<(int entityId, EntityType entityType)> OnManageAttachedFilesClicked { get; set; }
    [Parameter] public EventCallback<(int entityId, EntityType entityType)> OnCommentsClicked { get; set; }

    private bool IsNonFinancial => Document?.Side == FinancialSide.None;

    private IReadOnlyList<AdjustmentResponse> Adjustments => Document?.Adjustments ?? [];

    private bool HasAdjustments => Adjustments.Count > 0;

    // Base-currency figures are only worth showing when they differ from the document's currency.
    private bool ShowBase => Document is not null
                             && !string.IsNullOrWhiteSpace(Document.CurrencyCodeBase)
                             && Document.CurrencyCodeBase != Document.CurrencyCode;

    private string ItemsCheckTooltip => Document is null
        ? string.Empty
        : $"Document total {Money(Document.TotalAmount)} · Items total {Money(Document.TotalItemsAmount)}"
          + (HasAdjustments ? " · compared against the original amount" : string.Empty);

    // ── Due date: colour + days left. Null when there is nothing to say. ──
    private (string Text, Color Color)? DueState
    {
        get
        {
            if (Document?.DocDue is not DateOnly due || IsNonFinancial) return null;
            if (Document.IsFullyPaid) return ("Paid", Color.Success);

            var days = due.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber;
            return days switch
            {
                < 0 => ($"Overdue by {Days(-days)}", Color.Error),
                0 => ("Due today", Color.Error),
                <= 7 => ($"Due in {Days(days)}", Color.Warning),
                _ => ($"{Days(days)} left", Color.Success)
            };
        }
    }

    private static string Days(int n) => n == 1 ? "1 day" : $"{n} days";

    private string Money(decimal value) => $"{value:N2} {Document?.CurrencyCode}";

    private string BaseMoney(decimal value) => $"{value:N2} {Document?.CurrencyCodeBase}";

    private static string FormatSigned(decimal value)
        => value > 0 ? $"+{value:N2}" : value.ToString("N2");

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string SideLabel(FinancialSide side) => side switch
    {
        FinancialSide.Revenue => "Revenue",
        FinancialSide.Expense => "Expense",
        _ => "Non-financial"
    };

    // A link to the record's own page when it has one, plain text otherwise.
    private RenderFragment Link(string? text, int? id, string basePath)
    {
        if (id is int recordId && !string.IsNullOrWhiteSpace(text))
            return @<MudLink Href="@($"{basePath}/{recordId}")" Typo="Typo.body2">@text</MudLink>;

        return @<span>@Dash(text)</span>;
    }
}