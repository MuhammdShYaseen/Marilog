@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.Documents

<MudDataGrid T="DocumentResponse"
             Items="Items"
             Hover="true"
             Dense="true"
             Striped="true"
             Breakpoint="Breakpoint.Sm"
             Elevation="1"
             Class="rounded-lg">

    <Columns>

        <HierarchyColumn T="DocumentResponse"
                         ButtonDisabledFunc="x => !x.HasChildren" />

        <TemplateColumn Title="Doc No." SortBy="x => x.DocNumber">
            <CellTemplate>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1"
                          Class="@(context.Item.Depth > 0 ? "pl-2" : "")">
                    @if (context.Item.Depth > 0)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight"
                                 Size="Size.Small"
                                 Color="Color.Primary"
                                 Style="@($"margin-left:{context.Item.Depth * 16}px")" />
                    }
                    <MudLink OnClick="() => OnRowClick.InvokeAsync(context.Item)"
                             Style="cursor:pointer; font-weight:500">
                        @context.Item.DocNumber
                    </MudLink>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Type" SortBy="x => x.DocTypeName">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                    @context.Item.DocTypeName
                </MudChip>
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.DocDate" Title="Date" Format="dd MMM yyyy" />
        <PropertyColumn Property="x => x.SupplierName" Title="Supplier" />
        <PropertyColumn Property="x => x.VesselName" Title="Vessel" />
        <PropertyColumn Property="x => x.CurrencyCode" Title="Currency" />

        <TemplateColumn Title="Total" SortBy="x => x.TotalAmount" HeaderStyle="text-align:right" CellStyle="text-align:right">
            <CellTemplate>@context.Item.TotalAmount.ToString("N2")</CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Paid" SortBy="x => x.TotalPaid" HeaderStyle="text-align:right" CellStyle="text-align:right">
            <CellTemplate>@context.Item.TotalPaid.ToString("N2")</CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Balance" SortBy="x => x.RemainingBalance" HeaderStyle="text-align:right" CellStyle="text-align:right">
            <CellTemplate>
                <MudText Color="@(context.Item.RemainingBalance > 0 ? Color.Warning : Color.Success)"
                         Style="font-weight:600">
                    @context.Item.RemainingBalance.ToString("N2")
                </MudText>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Status" SortBy="x => x.IsFullyPaid">
            <CellTemplate>
                <MudChip T="string"
                         Icon="@(context.Item.IsFullyPaid ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Schedule)"
                         Color="@(context.Item.IsFullyPaid ? Color.Success : Color.Warning)"
                         Size="Size.Small"
                         Variant="Variant.Filled">
                    @(context.Item.IsFullyPaid ? "Paid" : "Unpaid")
                </MudChip>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="" Sortable="false" CellStyle="width:120px">
            <CellTemplate>
                <MudStack Row="true" Spacing="1">
                    <MudTooltip Text="Edit">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="() => OnEditClicked.InvokeAsync(context.Item)" />
                    </MudTooltip>
                    <MudTooltip Text="Delete">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="() => OnDeleteClicked.InvokeAsync(context.Item)" />
                    </MudTooltip>
                    <MudTooltip Text="Attachments">
                        <MudIconButton Icon="@Icons.Material.Filled.Receipt"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="() => OnManageAttachedFilesClicked.InvokeAsync((context.Item.Id, EntityType.Document))" />
                    </MudTooltip>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>

    </Columns>

    <ChildRowContent>
        @foreach (var child in context.Item.Children)
        {
            <MudElement HtmlTag="div" Class="mud-background-gray-light">
                <DocumentTreeRow Item="child"
                                 OnRowClick="OnRowClick"
                                 OnEditClicked="OnEditClicked"
                                 OnDeleteClicked="OnDeleteClicked"
                                 OnManageAttachedFilesClicked="OnManageAttachedFilesClicked" />
            </MudElement>
        }
    </ChildRowContent>

    <NoRecordsContent>
        <MudStack AlignItems="AlignItems.Center" Class="pa-8" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">No documents found.</MudText>
        </MudStack>
    </NoRecordsContent>

</MudDataGrid>

@code {
    [Parameter] public IEnumerable<DocumentResponse> Items { get; set; } = [];
    [Parameter] public EventCallback<DocumentResponse> OnRowClick { get; set; }
    [Parameter] public EventCallback<DocumentResponse> OnEditClicked { get; set; }
    [Parameter] public EventCallback<DocumentResponse> OnDeleteClicked { get; set; }
    [Parameter] public EventCallback<(int entityId, EntityType entityType)> OnManageAttachedFilesClicked { get; set; }
}