@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.Documents

@* ============================================================================
   These inline widths are now just a harmless fallback — the real,
   authoritative widths are the !important CSS rules in DocumentTable.razor's
   <style> block (targeting .wa-tree-table td:nth-child(n)). Confirmed from
   the real rendered DOM that this table's own <colgroup> widths did NOT
   match these <td> widths before, which was the actual cause of children
   overflowing/misaligning under their parent. Both are now numerically
   identical to DocumentTable.razor's values — if you ever change a width,
   change it in DocumentTable.razor's <style> block first, then mirror it
   here and in the colgroup there.
   ============================================================================ *@

<MudTr Class="@(Item.Depth > 0 ? "wa-tree-row-nested" : "")">
    <MudTd Style="width:48px; overflow:hidden" />

    <MudTd Style="width:220px; overflow:hidden">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="flex-nowrap">
            <MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight"
                     Size="Size.Small"
                     Color="Color.Primary"
                     Style="@($"margin-left:{Item.Depth * 16}px; flex-shrink:0")" />

            <MudLink OnClick="() => OnRowClick.InvokeAsync(Item)"
                     Style="cursor:pointer; font-weight:500; overflow:hidden; text-overflow:ellipsis; white-space:nowrap"
                     Title="@Item.DocNumber">
                @Item.DocNumber
            </MudLink>
        </MudStack>
    </MudTd>

    <MudTd Style="width:150px; overflow:hidden">
        <MudTooltip Text="@(Item.DocTypeName ?? "—")">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="wa-doctype-chip">
                @(Item.DocTypeName ?? "—")
            </MudChip>
        </MudTooltip>
    </MudTd>

    <MudTd Style="width:120px; overflow:hidden">@Item.DocDate.ToString("dd MMM yyyy")</MudTd>
    <MudTd Style="width:160px; overflow:hidden">@(Item.SupplierName ?? "—")</MudTd>
    <MudTd Style="width:110px; overflow:hidden">@(Item.VesselName ?? "—")</MudTd>
    <MudTd Style="width:90px; overflow:hidden">@Item.CurrencyCode</MudTd>

    <MudTd Style="width:110px; text-align:right; overflow:hidden">@Item.TotalAmount.ToString("N2")</MudTd>
    <MudTd Style="width:110px; text-align:right; overflow:hidden">@Item.TotalPaid.ToString("N2")</MudTd>

    <MudTd Style="width:110px; text-align:right; overflow:hidden">
        <MudText Color="@(Item.RemainingBalance > 0 ? Color.Warning : Color.Success)"
                 Style="font-weight:600">
            @Item.RemainingBalance.ToString("N2")
        </MudText>
    </MudTd>

    <MudTd Style="width:100px; overflow:hidden">
        <MudChip T="string"
                 Icon="@(Item.IsFullyPaid ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Schedule)"
                 Color="@(Item.IsFullyPaid ? Color.Success : Color.Warning)"
                 Size="Size.Small"
                 Variant="Variant.Filled">
            @(Item.IsFullyPaid ? "Paid" : "Unpaid")
        </MudChip>
    </MudTd>

    <MudTd Style="width:120px; overflow:hidden">
        <MudStack Row="true" Spacing="1" Class="flex-nowrap">
            <MudTooltip Text="Edit">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Size="Size.Small"
                               Color="Color.Primary"
                               OnClick="() => OnEditClicked.InvokeAsync(Item)" />
            </MudTooltip>

            <MudTooltip Text="Delete">
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               OnClick="() => OnDeleteClicked.InvokeAsync(Item)" />
            </MudTooltip>

            <MudTooltip Text="Attachments">
                <MudIconButton Icon="@Icons.Material.Filled.Receipt"
                               Size="Size.Small"
                               Color="Color.Secondary"
                               OnClick="() => OnManageAttachedFilesClicked.InvokeAsync((Item.Id, EntityType.Document))" />
            </MudTooltip>
        </MudStack>
    </MudTd>
</MudTr>

@if (Item.Children?.Any() == true)
{
    @foreach (var child in Item.Children)
    {
        <DocumentTreeRow Item="child"
                         OnRowClick="OnRowClick"
                         OnEditClicked="OnEditClicked"
                         OnManageAttachedFilesClicked="OnManageAttachedFilesClicked"
                         OnDeleteClicked="OnDeleteClicked" />
    }
}

@code {

    [Parameter, EditorRequired]
    public DocumentResponse Item { get; set; } = default!;

    [Parameter]
    public EventCallback<DocumentResponse> OnRowClick { get; set; }

    [Parameter]
    public EventCallback<DocumentResponse> OnEditClicked { get; set; }

    [Parameter]
    public EventCallback<DocumentResponse> OnDeleteClicked { get; set; }

    [Parameter]
    public EventCallback<(int entityId, EntityType entityType)> OnManageAttachedFilesClicked { get; set; }
}
