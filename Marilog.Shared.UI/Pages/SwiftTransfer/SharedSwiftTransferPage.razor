@using Marilog.Contracts.DTOs.Reports.SwiftTransferReports
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.SwiftTransfer
@* ────────────────────────────────────────────────────────────────────────────
   SharedSwiftTransferPage
   Overall page shell: header + Add button, table, detail panel below on
   selection. Owns local UI-only state (selected id, detail-loading flag,
   drawer-open flag) — never fetches business data itself. Add/Edit/Delete
   bubble up unchanged to the Platform host, which is the only place that
   owns a service ref.
   ──────────────────────────────────────────────────────────────────────── *@
<MudPaper Class="pa-4" Elevation="0">
    <MudText Typo="Typo.h5" Class="mb-2">SWIFT Transfers</MudText>

    <div class="d-flex align-center gap-1 mb-3 pb-1"
         style="border-bottom:1px solid var(--mud-palette-lines-default);">
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => OnAddClicked.InvokeAsync())">
            New transfer
        </MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@IsLoading"
                   OnClick="@(() => OnRefreshClicked.InvokeAsync())">
            Refresh
        </MudButton>
    </div>
    <SwiftTransferFilterBar Options="@FilterOptions"
                            Companies="@Companies"
                            OnFilterChanged="@OnFilterChanged" />

    <SwiftTransferSummaryStrip Items="@Items" />
    <SharedSwiftTransferTable Items="@Items"
                              IsLoading="@IsLoading"
                              SelectedItem="@_selectedSummary"
                              OnRowSelected="@HandleRowSelectedAsync"
                              OnEditClicked="@OnEditClicked"
                              OnDeleteClicked="@OnDeleteClicked"
                              OnMarkReceivedClicked="@OnMarkReceivedClicked"
                              OnCancelClicked="@OnCancelClicked"
                              OnManageAttachedFilesClicked="OnManageAttachedFilesClicked" />

    <MudDrawer Open="@_isDetailDrawerOpen" OpenChanged="@OnDrawerOpenChanged"
               Anchor="Anchor.Right"
               Variant="DrawerVariant.Temporary"
               Elevation="0"
               Width="560px"
               Style="border-left:1px solid var(--mud-palette-lines-default);">

        @if (_selectedDetail is not null)
        {
            <SharedSwiftTransferDetailPanel Transfer="@_selectedDetail"
                                            IsLoadingPayments="@_isLoadingDetail"
                                            OnMarkReceivedClicked="@OnMarkReceivedClicked"
                                            OnEditClicked="@OnEditClicked"
                                            OnCancelClicked="@OnCancelClicked"
                                            OnManageAttachedFilesClicked="@OnManageAttachedFilesClicked"
                                            OnClose="@CloseDetail" />
        }

    </MudDrawer>
</MudPaper>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SwiftTransferResponse> Items { get; set; } = null!;
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>Host wires this to ISwiftTransferService.GetWithPaymentsAsync(id, ct).</summary>
    [Parameter, EditorRequired]
    public Func<int, CancellationToken, Task<SwiftTransferResponse?>> LoadDetailFunc { get; set; } = null!;

    [Parameter, EditorRequired] public EventCallback OnAddClicked { get; set; }
    [Parameter, EditorRequired] public EventCallback<SwiftTransferResponse> OnEditClicked { get; set; }
    [Parameter, EditorRequired] public EventCallback<SwiftTransferResponse> OnDeleteClicked { get; set; }
    [Parameter] public EventCallback<(int entityId, EntityType entityType)> OnManageAttachedFilesClicked { get; set; }


    [Parameter] public EventCallback<SwiftTransferResponse> OnMarkReceivedClicked { get; set; }
    [Parameter] public EventCallback<SwiftTransferResponse> OnCancelClicked { get; set; }


    [Parameter, EditorRequired] public SwiftTransferFilterOptions FilterOptions { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<CompanyResponse> Companies { get; set; } = null!;
    [Parameter, EditorRequired] public EventCallback<SwiftTransferFilterOptions> OnFilterChanged { get; set; }

    [Parameter] public EventCallback OnRefreshClicked { get; set; }

    SwiftTransferResponse? _selectedSummary;
    SwiftTransferResponse? _selectedDetail;
    bool _isLoadingDetail;
    bool _isDetailDrawerOpen;

    async Task HandleRowSelectedAsync(SwiftTransferResponse item)
    {
        if (item.Id is 0)
            return;

        // Toggle off if clicking the already-selected row.
        if (_selectedSummary?.Id == item.Id)
        {
            CloseDetail();
            return;
        }

        _selectedSummary = item;
        _selectedDetail = item;          // show list data immediately while full detail loads
        _isLoadingDetail = true;
        _isDetailDrawerOpen = true;
        StateHasChanged();

        _selectedDetail = await LoadDetailFunc(item.Id, CancellationToken.None) ?? item;
        _isLoadingDetail = false;
    }

    /// <summary>Lets the Platform host refresh the open panel after an edit closes.</summary>
    public async Task RefreshSelectedIfOpenAsync()
    {
        if (_selectedSummary?.Id is int id)
        {
            _isLoadingDetail = true;
            StateHasChanged();
            _selectedDetail = await LoadDetailFunc(id, CancellationToken.None);
            _isLoadingDetail = false;
        }
    }

    void OnDrawerOpenChanged(bool open)
    {
        if (!open)
            CloseDetail();
    }

    void CloseDetail()
    {
        _selectedSummary = null;
        _isDetailDrawerOpen = false;
        // _selectedDetail is kept so the content doesn't vanish mid-animation.
    }
}
