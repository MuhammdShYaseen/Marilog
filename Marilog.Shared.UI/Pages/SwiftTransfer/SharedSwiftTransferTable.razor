@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.SwiftTransfer
@* ────────────────────────────────────────────────────────────────────────────
   SharedSwiftTransferTable
   Stateless list rendering. Data in via Items, every row action out via
   EventCallback. No service refs. Actions that the backend would reject are
   disabled up front with the reason shown.
   ──────────────────────────────────────────────────────────────────────── *@
<MudTable Items="@Items" T="SwiftTransferResponse"
          Hover="true" Dense="true" Elevation="0" Outlined="true"
          Loading="@IsLoading" RowsPerPage="50"
          RowStyleFunc="@RowStyleFunc" RowClassFunc="@RowClassFunc"
          OnRowClick="@(e => OnRowSelected.InvokeAsync(e.Item))">
    <HeaderContent>
        <MudTh>Reference</MudTh>
        <MudTh>
            <MudTableSortLabel T="SwiftTransferResponse" SortBy="@(x => x.TransactionDate)"
                               InitialDirection="SortDirection.Descending">Date</MudTableSortLabel>
        </MudTh>
        <MudTh>Currency</MudTh>
        <MudTh Style="text-align:right">
            <MudTableSortLabel T="SwiftTransferResponse" SortBy="@(x => x.Amount)">Amount</MudTableSortLabel>
        </MudTh>
        <MudTh Style="text-align:right">
            <MudTableSortLabel T="SwiftTransferResponse" SortBy="@(x => x.UnallocatedAmount)">Unallocated</MudTableSortLabel>
        </MudTh>
        <MudTh>Sender</MudTh>
        <MudTh>Receiver</MudTh>
        <MudTh>Status</MudTh>
        <MudTh></MudTh>
    </HeaderContent>

    <RowTemplate>
        @{
            var status = SwiftTransferStatusDisplay.For(context);
            var isCancelled = context.Status == SwiftTransferStatus.Cancelled;
            var hasPayments = context.AllocatedAmount > 0;
            var showUnallocated = context.Status == SwiftTransferStatus.Received;
        }
        <MudTd DataLabel="Reference">@context.SwiftReference</MudTd>
        <MudTd DataLabel="Date">@context.TransactionDate.ToString("yyyy-MM-dd")</MudTd>
        <MudTd DataLabel="Currency">@context.CurrencyCode</MudTd>
        <MudTd DataLabel="Amount" Style="text-align:right">@context.Amount.ToString("N2")</MudTd>
        <MudTd DataLabel="Unallocated" Style="text-align:right">
            @(showUnallocated ? context.UnallocatedAmount.ToString("N2") : "—")
        </MudTd>
        <MudTd DataLabel="Sender">@(context.SenderCompanyName ?? "—")</MudTd>
        <MudTd DataLabel="Receiver">@(context.ReceiverCompanyName ?? "—")</MudTd>
        <MudTd DataLabel="Status">
            <MudTooltip Text="@status.Tooltip">
                <div class="d-flex align-center gap-1">
                    <MudIcon Icon="@status.Icon" Color="@status.Color" Size="Size.Small" />
                    <MudText Typo="Typo.body2">@status.Text</MudText>
                </div>
            </MudTooltip>
        </MudTd>
        <MudTd Style="text-align:right; white-space:nowrap;">
            @* stopPropagation: row actions must not also open the detail drawer *@
            <div class="d-inline-flex align-center" @onclick:stopPropagation="true">
                @if (context.Status == SwiftTransferStatus.Pending)
                {
                    <MudTooltip Text="Confirm bank receipt">
                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success"
                                       OnClick="@(() => OnMarkReceivedClicked.InvokeAsync(context))" />
                    </MudTooltip>
                }

                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" Disabled="@isCancelled"
                                 OnClick="@(() => OnEditClicked.InvokeAsync(context))">
                        @(isCancelled ? "Edit (cancelled)" : "Edit")
                    </MudMenuItem>

                    <MudMenuItem Icon="@Icons.Material.Filled.Receipt"
                                 OnClick="@(() => OnManageAttachedFilesClicked.InvokeAsync((context.Id, EntityType.SwiftTransfer)))">
                        Attached files
                    </MudMenuItem>

                    <MudDivider />

                    @if (!isCancelled)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Block" Disabled="@hasPayments"
                                     OnClick="@(() => OnCancelClicked.InvokeAsync(context))">
                            @(hasPayments ? "Cancel transfer (remove payments first)" : "Cancel transfer")
                        </MudMenuItem>
                    }

                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" Disabled="@hasPayments"
                                 OnClick="@(() => OnDeleteClicked.InvokeAsync(context))">
                        @(hasPayments ? "Delete (remove payments first)" : "Delete")
                    </MudMenuItem>
                </MudMenu>
            </div>
        </MudTd>
    </RowTemplate>

    <NoRecordsContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary">No SWIFT transfers match these filters.</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Loading SWIFT transfers...</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 25, 50, 100 })" />
    </PagerContent>
</MudTable>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SwiftTransferResponse> Items { get; set; } = null!;
    [Parameter] public SwiftTransferResponse? SelectedItem { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    [Parameter, EditorRequired] public EventCallback<SwiftTransferResponse> OnRowSelected { get; set; }
    [Parameter, EditorRequired] public EventCallback<SwiftTransferResponse> OnEditClicked { get; set; }
    [Parameter, EditorRequired] public EventCallback<SwiftTransferResponse> OnDeleteClicked { get; set; }
    [Parameter] public EventCallback<SwiftTransferResponse> OnMarkReceivedClicked { get; set; }
    [Parameter] public EventCallback<SwiftTransferResponse> OnCancelClicked { get; set; }
    [Parameter] public EventCallback<(int entityId, EntityType entityType)> OnManageAttachedFilesClicked { get; set; }

    static string RowStyleFunc(SwiftTransferResponse item, int index) =>
        item.Status == SwiftTransferStatus.Cancelled ? "opacity: 0.55;" : string.Empty;

    string RowClassFunc(SwiftTransferResponse item, int index) =>
        SelectedItem is not null && item.Id == SelectedItem.Id ? "mud-theme-primary-hover selected-row" : string.Empty;
}