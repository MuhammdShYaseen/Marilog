@using Marilog.Contracts.DTOs.Requests.SwiftTransferDTOs
@using Marilog.Contracts.DTOs.Responses
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.SwiftTransfer

@* ────────────────────────────────────────────────────────────────────────────
   SwiftTransferEditDialog — edit only (new transfers go through SwiftCreateWizard).
   Reference, date and companies can't change after creation: shown, disabled.
   No client service injected here; the host wires OnUpdateAsync to ISwiftTransferService.
   ──────────────────────────────────────────────────────────────────────── *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" />
            Edit SWIFT Transfer — @Existing.SwiftReference
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="SWIFT Reference" Value="@Existing.SwiftReference"
                                  Disabled="true" HelperText="Not editable after creation" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="Transaction Date"
                                  Value="@Existing.TransactionDate.ToString("dd MMM yyyy")"
                                  Disabled="true" HelperText="Not editable after creation" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" Label="Currency" @bind-Value="_currencyId"
                               Required="true" RequiredError="Currency is required">
                        @foreach (var currency in Currencies)
                        {
                            <MudSelectItem T="int?" Value="@((int?)currency.Id)">@currency.Code — @currency.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal" Label="Amount" @bind-Value="_amount"
                                     Required="true" RequiredError="Amount is required"
                                     Min="0.01m" Format="N2" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="Sender Company" Value="@CompanyName(Existing.SenderCompanyId)"
                                  Disabled="true" HelperText="Not editable after creation" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="Receiver Company" Value="@CompanyName(Existing.ReceiverCompanyId)"
                                  Disabled="true" HelperText="Not editable after creation" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" Label="Sender Bank" @bind-Value="_senderBankId" Clearable="true">
                        @foreach (var bank in Banks)
                        {
                            <MudSelectItem T="int?" Value="@((int?)bank.BankId)">@bank.BankName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" Label="Receiver Bank" @bind-Value="_receiverBankId" Clearable="true">
                        @foreach (var bank in Banks)
                        {
                            <MudSelectItem T="int?" Value="@((int?)bank.BankId)">@bank.BankName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string" Label="Payment Reference" @bind-Value="_paymentReference" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string" Label="Raw Message" @bind-Value="_rawMessage" Lines="4" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@_isSaving" OnClick="SubmitAsync">
            @(_isSaving ? "Saving..." : "Save Changes")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] ISnackbar Snackbar { get; set; } = null!;

    [Parameter, EditorRequired] public SwiftTransferResponse Existing { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<CompanyResponse> Companies { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<BankResponse> Banks { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<CurrencyResponse> Currencies { get; set; } = null!;

    /// <summary>Host wires this to ISwiftTransferService.UpdateAsync(...); returns success/failure.</summary>
    [Parameter, EditorRequired]
    public Func<int, UpdateSwiftTransferRequest, CancellationToken, Task<bool>> OnUpdateAsync { get; set; } = null!;

    MudForm _form = null!;
    bool _isSaving;

    int? _currencyId;
    decimal _amount;
    int? _senderBankId;
    int? _receiverBankId;
    string? _paymentReference;
    string? _rawMessage;

    protected override void OnInitialized()
    {
        _currencyId = Existing.CurrencyId;
        _amount = Existing.Amount;
        _senderBankId = Existing.SenderBankId;
        _receiverBankId = Existing.ReceiverBankId;
        _paymentReference = Existing.PaymentReference;
        _rawMessage = Existing.RawMessage;
    }

    async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid || _currencyId is null)
            return;

        _isSaving = true;
        try
        {
            var request = new UpdateSwiftTransferRequest
            {
                CurrencyId = _currencyId.Value,
                Amount = _amount,
                SenderBankId = _senderBankId,
                ReceiverBankId = _receiverBankId,
                PaymentReference = _paymentReference,
                RawMessage = _rawMessage
            };

            if (await OnUpdateAsync(Existing.Id, request, CancellationToken.None))
            {
                Snackbar.Add("SWIFT transfer updated.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Failed to update SWIFT transfer.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    string? CompanyName(int? id) => Companies.FirstOrDefault(c => c.Id == id)?.Name;

    void Cancel() => MudDialog.Cancel();
}