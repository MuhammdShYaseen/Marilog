@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.SwiftTransfer
@* ────────────────────────────────────────────────────────────────────────────
   SharedSwiftTransferDetailPanel
   Rule 15: appears below the table when a row is selected, not a dialog.
   Shows the transfer's core fields plus its allocated Payments, sorted with
   the most recent first and an allocation summary at the top.

   ASSUMPTION (not supplied): PaymentResponse is assumed to expose
   Id, Amount, PaymentDate (DateOnly), Reference/Description (string?), and
   IsActive (bool). Adjust the bindings in the payments loop below if the
   real shape differs — everything else in this component is independent
   of that assumption.
   ──────────────────────────────────────────────────────────────────────── *@
<MudPaper Class="pa-4 mt-4" Outlined="true">
    @if (IsLoadingPayments)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" />
    }

    @* ── Header ─────────────────────────────────────────────── *@
    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mb-1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Primary" Size="Size.Large" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@Transfer.SwiftReference</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @Transfer.TransactionDate.ToString("dd MMM yyyy") &middot; @Transfer.CurrencyCode
                </MudText>
            </MudStack>
        </MudStack>

        @if (Transfer.IsFullyAllocated)
        {
            <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle" Variant="Variant.Filled">
                Fully Allocated
            </MudChip>
        }
        else
        {
            <MudChip T="string" Color="Color.Warning" Icon="@Icons.Material.Filled.Schedule" Variant="Variant.Filled">
                Partially Allocated
            </MudChip>
        }
    </MudStack>

    @* ── Allocation progress ───────────────────────────────── *@
    <MudProgressLinear Value="@_allocationPercent"
                       Color="@(Transfer.IsFullyAllocated ? Color.Success : Color.Warning)"
                       Class="my-3"
                       Rounded="true"
                       Size="Size.Small" />

    <MudGrid Spacing="3" Class="mb-2">
        <MudItem xs="6" sm="3">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Amount</MudText>
            <MudText Typo="Typo.body1" Style="font-weight:600">
                @Transfer.Amount.ToString("N2") @Transfer.CurrencyCode
            </MudText>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Allocated</MudText>
            <MudText Typo="Typo.body1" Color="Color.Success">
                @Transfer.AllocatedAmount.ToString("N2") @Transfer.CurrencyCode
            </MudText>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Unallocated</MudText>
            <MudText Typo="Typo.body1"
                     Color="@(Transfer.UnallocatedAmount > 0 ? Color.Warning : Color.Success)"
                     Style="font-weight:600">
                @Transfer.UnallocatedAmount.ToString("N2") @Transfer.CurrencyCode
            </MudText>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Payment Reference</MudText>
            <MudText Typo="Typo.body1">@(Transfer.PaymentReference ?? "—")</MudText>
        </MudItem>
    </MudGrid>

    <MudDivider Class="my-3" />

    @* ── Sender → Receiver flow ────────────────────────────── *@
    <MudGrid Spacing="2" AlignItems="AlignItems.Center">
        <MudItem xs="12" sm="5">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Sender</MudText>
            <MudText Typo="Typo.body1" Style="font-weight:600">@(Transfer.SenderCompanyName ?? "—")</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@(Transfer.SenderBankName ?? "—")</MudText>
        </MudItem>

        <MudItem xs="12" sm="2" Class="d-flex justify-center">
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Color="Color.Secondary" />
        </MudItem>

        <MudItem xs="12" sm="5">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Receiver</MudText>
            <MudText Typo="Typo.body1" Style="font-weight:600">@(Transfer.ReceiverCompanyName ?? "—")</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@(Transfer.ReceiverBankName ?? "—")</MudText>
        </MudItem>
    </MudGrid>

    <MudDivider Class="my-4" />

    @* ── Payments ───────────────────────────────────────────── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" Color="Color.Primary" />
        <MudText Typo="Typo.subtitle1">Payments (@_orderedPayments.Count)</MudText>
    </MudStack>

    @if (_orderedPayments.Count == 0)
    {
        <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="py-6">
            <MudIcon Icon="@Icons.Material.Filled.Payment" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">No payments allocated against this transfer yet.</MudText>
        </MudStack>
    }
    else
    {
        <MudStack Spacing="2">
            @foreach (var payment in _orderedPayments)
            {
                <MudPaper Class="pa-3" Elevation="0" Outlined="true"
                          Style="@(!payment.IsActive ? "opacity:0.6" : "")">

                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">

                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle2">Payment #@payment.Id</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @payment.PaymentDate.ToString("dd MMM yyyy")
                            </MudText>
                        </MudStack>

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined"
                                     Icon="@Icons.Material.Filled.CreditCard">
                                @payment.PaymentMethod
                            </MudChip>

                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                                     Icon="@Icons.Material.Filled.Description">
                                Doc #@payment.DocumentId
                            </MudChip>

                            @if (!payment.IsActive)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">
                                    Inactive
                                </MudChip>
                            }
                        </MudStack>

                        <MudText Typo="Typo.h6" Style="font-weight:600">
                            @payment.PaidAmount.ToString("N2") @Transfer.CurrencyCode
                        </MudText>

                    </MudStack>

                </MudPaper>
            }
        </MudStack>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public SwiftTransferResponse Transfer { get; set; } = null!;
    [Parameter] public bool IsLoadingPayments { get; set; }

    List<PaymentResponse> _orderedPayments = new();
    double _allocationPercent;

    protected override void OnParametersSet()
    {
        _orderedPayments = (Transfer.Payments ?? new())
            .OrderByDescending(p => p.PaymentDate)
            .ToList();

        _allocationPercent = Transfer.Amount > 0
            ? (double)(Transfer.AllocatedAmount / Transfer.Amount) * 100
            : 0;
    }
}