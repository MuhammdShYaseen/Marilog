@using Marilog.Contracts.DTOs.Responses
@using Marilog.Kernel.Enums
@using MudBlazor
@namespace Marilog.Shared.UI.Pages.SwiftTransfer
@* ────────────────────────────────────────────────────────────────────────────
   SharedSwiftTransferDetailPanel
   Azure-style blade rendered inside the page's right drawer: title, command
   bar, essentials, parties, raw message, allocated payments. Logic-free:
   every command bubbles up unchanged to the Platform host.
   ──────────────────────────────────────────────────────────────────────── *@
<div class="d-flex flex-column" style="height:100%;">

    @* ── Title ──────────────────────────────────────────────── *@
    <div class="d-flex align-start justify-space-between px-4 pt-4">
        <div>
            <MudText Typo="Typo.h6">@Transfer.SwiftReference</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">SWIFT transfer</MudText>
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                       OnClick="@(() => OnClose.InvokeAsync())" />
    </div>

    @* ── Command bar ────────────────────────────────────────── *@
    <div class="d-flex flex-wrap align-center gap-1 px-2 py-1 mt-2"
         style="border-top:1px solid var(--mud-palette-lines-default); border-bottom:1px solid var(--mud-palette-lines-default);">
        @if (IsPending)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.CheckCircle"
                       OnClick="@(() => OnMarkReceivedClicked.InvokeAsync(Transfer))">
                Confirm receipt
            </MudButton>
        }

        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Edit" Disabled="@IsCancelled"
                   OnClick="@(() => OnEditClicked.InvokeAsync(Transfer))">
            Edit
        </MudButton>

        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Receipt"
                   OnClick="@(() => OnManageAttachedFilesClicked.InvokeAsync((Transfer.Id, EntityType.SwiftTransfer)))">
            Attached files
        </MudButton>

        @if (!IsCancelled)
        {
            <MudTooltip Text="@(HasPayments ? "Remove allocated payments first" : "Cancel this transfer")">
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Block" Disabled="@HasPayments"
                           OnClick="@(() => OnCancelClicked.InvokeAsync(Transfer))">
                    Cancel transfer
                </MudButton>
            </MudTooltip>
        }
    </div>

    @if (IsLoadingPayments)
    {
        <MudProgressLinear Indeterminate="true" Size="Size.Small" />
    }

    <div class="pa-4" style="overflow-y:auto; flex:1;">

        @* ── Status notice ──────────────────────────────────── *@
        @if (IsPending)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-3">
                Awaiting bank confirmation for @SwiftTransferStatusDisplay.DaysPending(Transfer) day(s).
                Payments can be allocated once receipt is confirmed.
            </MudAlert>
        }
        else if (IsCancelled)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined" Class="mb-3">
                Cancelled: @(Transfer.CancellationReason ?? "no reason recorded")
            </MudAlert>
        }

        @* ── Essentials ─────────────────────────────────────── *@
        <MudText Typo="Typo.subtitle2" Class="mb-2">Essentials</MudText>
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="6">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
                <div class="d-flex align-center gap-1">
                    <MudIcon Icon="@_status.Icon" Color="@_status.Color" Size="Size.Small" />
                    <MudText Typo="Typo.body2">@_status.Text</MudText>
                </div>
            </MudItem>
            <MudItem xs="6">
                @Field("Transaction date", Transfer.TransactionDate.ToString("dd MMM yyyy"))
            </MudItem>
            <MudItem xs="6">
                @Field("Amount", $"{Transfer.Amount:N2} {Transfer.CurrencyCode}", bold: true)
            </MudItem>
            <MudItem xs="6">
                @Field("Bank receipt date", Transfer.ReceivedDate?.ToString("dd MMM yyyy") ?? "—")
            </MudItem>
            <MudItem xs="6">
                @Field("Allocated", $"{Transfer.AllocatedAmount:N2} {Transfer.CurrencyCode}")
            </MudItem>
            <MudItem xs="6">
                @Field("Unallocated", IsReceived ? $"{Transfer.UnallocatedAmount:N2} {Transfer.CurrencyCode}" : "—", bold: true)
            </MudItem>
            <MudItem xs="12">
                @Field("Payment reference", Transfer.PaymentReference ?? "—")
            </MudItem>
        </MudGrid>

        @if (IsReceived)
        {
            <div class="d-flex align-center gap-2 mb-4">
                <MudProgressLinear Value="@_allocationPercent" Size="Size.Small" Rounded="true"
                                   Color="@(Transfer.IsFullyAllocated ? Color.Success : Color.Warning)" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space:nowrap;">
                    @_allocationPercent.ToString("0")% allocated
                </MudText>
            </div>
        }

        <MudDivider Class="mb-3" />

        @* ── Parties ────────────────────────────────────────── *@
        <MudText Typo="Typo.subtitle2" Class="mb-2">Parties</MudText>
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="6">
                @Party("Sender", Transfer.SenderCompanyName, Transfer.SenderBankName, Transfer.SenderBankNav)
            </MudItem>
            <MudItem xs="6">
                @Party("Receiver", Transfer.ReceiverCompanyName, Transfer.ReceiverBankName, Transfer.ReceiverBankNav)
            </MudItem>
        </MudGrid>

        @* ── Raw message ────────────────────────────────────── *@
        @if (!string.IsNullOrWhiteSpace(Transfer.RawMessage))
        {
            <MudExpansionPanels Elevation="0" Outlined="true" Class="mb-3">
                <MudExpansionPanel Text="Raw SWIFT message">
                    <pre style="font-family:Consolas, 'Courier New', monospace; font-size:12px; white-space:pre; overflow-x:auto; margin:0;">@Transfer.RawMessage</pre>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        <MudDivider Class="mb-3" />

        @* ── Payments ───────────────────────────────────────── *@
        <MudText Typo="Typo.subtitle2" Class="mb-2">Allocated payments (@_orderedPayments.Count)</MudText>

        @if (_orderedPayments.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @(IsReceived ? "No payments allocated yet." : "Nothing can be allocated until the bank confirms receipt.")
            </MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true" Outlined="true" Elevation="0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Document</th>
                        <th>Supplier</th>
                        <th style="text-align:right">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in _orderedPayments)
                    {
                        <tr style="@(payment.IsActive ? null : "opacity:0.55;")">
                            <td style="white-space:nowrap;">
                                <MudText Typo="Typo.body2">@payment.PaymentDate.ToString("dd MMM yyyy")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@payment.PaymentMethod</MudText>
                            </td>
                            <td>
                                <MudText Typo="Typo.body2" Style="font-weight:600;">
                                    @(payment.DocNumber ?? $"Doc #{payment.DocumentId}")
                                    @if (!payment.IsActive)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Error" Inline="true"> (inactive)</MudText>
                                    }
                                </MudText>
                                @if (!string.IsNullOrWhiteSpace(payment.DocReference))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Ref: @payment.DocReference</MudText>
                                }
                            </td>
                            <td>@(payment.DocSupplierName ?? "—")</td>
                            <td style="text-align:right; white-space:nowrap;">@payment.PaidAmount.ToString("N2")</td>
                        </tr>
                    }
                    <tr>
                        <td colspan="3"><b>Total allocated</b></td>
                        <td style="text-align:right"><b>@Transfer.AllocatedAmount.ToString("N2") @Transfer.CurrencyCode</b></td>
                    </tr>
                </tbody>
            </MudSimpleTable>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SwiftTransferResponse Transfer { get; set; } = null!;
    [Parameter] public bool IsLoadingPayments { get; set; }

    [Parameter] public EventCallback<SwiftTransferResponse> OnMarkReceivedClicked { get; set; }
    [Parameter] public EventCallback<SwiftTransferResponse> OnEditClicked { get; set; }
    [Parameter] public EventCallback<SwiftTransferResponse> OnCancelClicked { get; set; }
    [Parameter] public EventCallback<(int entityId, EntityType entityType)> OnManageAttachedFilesClicked { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    bool IsPending => Transfer.Status == SwiftTransferStatus.Pending;
    bool IsCancelled => Transfer.Status == SwiftTransferStatus.Cancelled;
    bool IsReceived => Transfer.Status == SwiftTransferStatus.Received;
    bool HasPayments => Transfer.AllocatedAmount > 0;

    SwiftTransferStatusDisplay.Info _status;
    List<PaymentResponse> _orderedPayments = new();
    double _allocationPercent;

    protected override void OnParametersSet()
    {
        _status = SwiftTransferStatusDisplay.For(Transfer);

        _orderedPayments = (Transfer.Payments ?? new())
            .OrderByDescending(p => p.PaymentDate)
            .ToList();

        _allocationPercent = Transfer.Amount > 0
            ? Math.Min(100, (double)(Transfer.AllocatedAmount / Transfer.Amount) * 100)
            : 0;
    }

    static RenderFragment Field(string label, string value, bool bold = false) => @<div>
        <MudText Typo="Typo.caption" Color="Color.Secondary">@label</MudText>
        <MudText Typo="Typo.body2" Style="@(bold ? "font-weight:600;" : null)">@value</MudText>
    </div>;

    static RenderFragment Party(string role, string? company, string? bankName, BankResponse? bank) => @<div>
        <MudText Typo="Typo.caption" Color="Color.Secondary">@role</MudText>
        <MudText Typo="Typo.body2" Style="font-weight:600;">@(company ?? "—")</MudText>
        <MudText Typo="Typo.body2">@(bankName ?? "No bank recorded")</MudText>
        @if (!string.IsNullOrWhiteSpace(bank?.SwiftBic) || !string.IsNullOrWhiteSpace(bank?.CountryName))
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @string.Join(", ", new[] { bank?.SwiftBic, bank?.CountryName }.Where(s => !string.IsNullOrWhiteSpace(s)))
            </MudText>
        }
    </div>;
}