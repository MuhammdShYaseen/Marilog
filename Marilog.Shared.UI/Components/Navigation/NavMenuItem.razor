@using Marilog.Contracts.DTOs.Responses
@using Marilog.Shared.UI.Components.Comments
@using Marilog.Shared.UI.Pages.NavMenuDesigner
@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor

@if (Item.Children.Count > 0)
{
    <MudNavGroup Title="@Item.Title"
                 Icon="@GetIcon(Item.Icon)">
        <TitleContent>
            @Item.Title<CommentBadge Types="@CommentNav.TypesFor(Item)" />
        </TitleContent>
        <ChildContent>
            @foreach (var child in Item.Children)
            {
                <NavMenuItem Item="child" />
            }
        </ChildContent>
    </MudNavGroup>
}
else
{
    <MudNavLink Href="@Item.Route"
                Match="NavLinkMatch.All"
                Icon="@GetIcon(Item.Icon)"
                Class="mud-inherit-text">

        @Item.Title<CommentBadge Types="@CommentNav.TypesFor(Item)" />

    </MudNavLink>
}

@code {

    [Parameter]
    public NavItemResponse Item { get; set; }
        = default!;

    string GetIcon(string? icon) => NavIcons.Resolve(icon) ?? Icons.Material.Filled.QuestionMark;
    
}