@using Marilog.Contracts.DTOs.Responses
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using MudBlazor
@using Microsoft.AspNetCore.Components.Web
@namespace Marilog.Shared.UI.Components.ManagingStoredFiles
@implements IAsyncDisposable
<MudDialog Class="wa-viewer">

    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4" Class="wa-title-bar">

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="wa-title-main">
                <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Primary" />

                <MudStack Spacing="0" Class="wa-title-text" title="@ContextLabel">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="wa-title-caption">Attached Files</MudText>
                    <MudText Typo="Typo.subtitle1" Class="wa-title-label">@TitleLine</MudText>
                    @if (!string.IsNullOrWhiteSpace(SubtitleLine))
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="wa-title-sub">@SubtitleLine</MudText>
                    }
                </MudStack>

                @if (_isUploading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                }
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="wa-title-actions">
                @if (HasCut)
                {
                    <MudButton Size="Size.Small"
                               Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.ContentPaste"
                               OnClick="PasteAsync">
                        Paste here
                    </MudButton>
                }

                <MudButton Size="Size.Small"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.CreateNewFolder"
                           OnClick="CreateFolderAsync">
                    New folder
                </MudButton>

                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                    <MudIconButton Icon="@Icons.Material.Filled.ViewList"
                                   Color="@(_viewMode == ViewMode.List ? Color.Primary : Color.Default)"
                                   OnClick="@(() => _viewMode = ViewMode.List)" />
                    <MudIconButton Icon="@Icons.Material.Filled.GridView"
                                   Color="@(_viewMode == ViewMode.Grid ? Color.Primary : Color.Default)"
                                   OnClick="@(() => _viewMode = ViewMode.Grid)" />
                </MudButtonGroup>

                <MudTooltip Text="Open in new tab">
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                   Size="Size.Small"
                                   OnClick="OpenInNewTabAsync" />
                </MudTooltip>
            </MudStack>

        </MudStack>
    </TitleContent>

    <DialogContent>

        @if (_isLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Class="py-8">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </MudStack>
        }
        else
        {
            <div class="wa-files-column">

                @* ── Breadcrumb — every crumb is also a drop target (handled in JS) ── *@
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="wa-breadcrumb mb-3">
                    <div class="wa-crumb" data-wa-drop="root" @onclick="() => OpenFolder(null)">
                        <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" />
                        <MudText Typo="Typo.body2">Root</MudText>
                    </div>

                    @foreach (var crumb in BreadcrumbPath)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Secondary" />
                        <div class="wa-crumb" data-wa-drop="@crumb.Id" @onclick="() => OpenFolder(crumb.Id)">
                            <MudText Typo="Typo.body2">@crumb.Name</MudText>
                        </div>
                    }
                </MudStack>

                @* ── Folders of the current level ── *@
                @if (VisibleFolders.Any())
                {
                    <div class="wa-folder-strip mb-3">
                        @foreach (var folder in VisibleFolders)
                        {
                            <div class="@FolderItemClass(folder)"
                                 draggable="true"
                                 data-wa-drag-folder="@folder.Id"
                                 data-wa-drop="@folder.Id"
                                 @onclick="e => OnFolderClick(folder, e)">

                                <MudIcon Icon="@Icons.Material.Filled.Folder" Color="Color.Warning" />
                                <MudText Typo="Typo.body2" Class="wa-folder-name">@folder.Name</MudText>

                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true">
                                    <MudMenuItem Icon="@Icons.Material.Filled.FolderOpen"
                                                 OnClick="() => OpenFolder(folder.Id)">Open</MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.DriveFileRenameOutline"
                                                 OnClick="() => RenameFolderAsync(folder)">Rename</MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.ContentCut"
                                                 OnClick="() => CutFolder(folder)">Cut</MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                                 OnClick="() => DeleteFolderAsync(folder)">Delete</MudMenuItem>
                                </MudMenu>

                            </div>
                        }
                    </div>
                }

                @if (_viewMode == ViewMode.List)
                {
                    <div class="wa-dropzone-bar mb-3">
                        @* Same MudFileUpload usage as FileUploadDialog — untouched. *@
                        <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                       Files="_pendingFiles"
                                       FilesChanged="OnFilesChanged"
                                       DragAndDrop="true"
                                       AppendMultipleFiles="true"
                                       MaximumFileCount="20">
                        </MudFileUpload>
                    </div>

                    <MudTable T="StoredFileResponse"
                              Items="VisibleFiles"
                              Hover="true"
                              Class="manage-files-table"
                              OnRowClick="OnTableRowClick"
                              RowClassFunc="@((f, index) => f.Id == _selectedFile?.Id ? "selected-row" : string.Empty)">

                        <HeaderContent>
                            <MudTh>File</MudTh>
                            <MudTh>Size</MudTh>
                            <MudTh>Tags</MudTh>
                            <MudTh>Added Date</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>

                        <RowTemplate Context="file">

                            <MudTd DataLabel="File">
                                <div class="@FileDragClass(file)" draggable="true" data-wa-drag-file="@file.Id">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@GetFileIcon(file)" Size="Size.Small" Color="Color.Primary" />
                                        <MudText>@file.OriginalFileName</MudText>
                                    </MudStack>
                                </div>
                            </MudTd>

                            <MudTd DataLabel="Size">
                                @FormatSize(file.Size)
                            </MudTd>

                            <MudTd DataLabel="Tags">
                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" AlignItems="AlignItems.Center">
                                    @if (file.Tags != null)
                                    {
                                        foreach (var tag in file.Tags)
                                        {
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Color="@ParseColor(tag.Color)"
                                                     Variant="Variant.Filled"
                                                     OnClose="@(() => RemoveTagAsync(file, tag))">
                                                @tag.Name
                                            </MudChip>
                                        }
                                    }
                                    <MudMenu Icon="@Icons.Material.Filled.Sell" Size="Size.Small" Dense="true">
                                        @TagPickerContent(file)
                                    </MudMenu>
                                </MudStack>
                            </MudTd>

                            <MudTd DataLabel="Date">
                                @file.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                            </MudTd>

                            <MudTd>
                                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">

                                    <MudTooltip Text="Open in new tab">
                                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                       Size="Size.Small"
                                                       OnClick="@(() => OpenFileInNewTabAsync(file))" />
                                    </MudTooltip>

                                    <MudTooltip Text="Download">
                                        <MudIconButton Icon="@Icons.Material.Filled.Download"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       OnClick="@(() => DownloadAsync(file))" />
                                    </MudTooltip>

                                    <MudTooltip Text="Delete">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="@(() => DeleteAsync(file))" />
                                    </MudTooltip>

                                </MudStack>
                            </MudTd>

                        </RowTemplate>

                    </MudTable>
                }
                else
                {
                    <div class="file-grid">

                        @foreach (var file in VisibleFiles)
                        {
                            <div class="@FileDragClass(file)" draggable="true" data-wa-drag-file="@file.Id">
                                <StoredFileCard File="file"
                                                IsSelected="@(file.Id == _selectedFile?.Id)"
                                                DownloadUrl="@BuildDownloadUrl(file)"
                                                ThumbnailUrl="@BuildThumbnailUrl(file)"
                                                PresetColors="_presetColors"
                                                OnSelect="SelectFile"
                                                OnDownload="DownloadAsync"
                                                OnDelete="DeleteAsync"
                                                OnAddTag="HandleCardAddTag"
                                                OnRemoveTag="HandleCardRemoveTag" />
                            </div>
                        }

                        <div class="wa-dropzone-tile">
                            @* Same MudFileUpload usage as FileUploadDialog — untouched. *@
                            <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                           Files="_pendingFiles"
                                           FilesChanged="OnFilesChanged"
                                           DragAndDrop="true"
                                           AppendMultipleFiles="true"
                                           MaximumFileCount="20">
                            </MudFileUpload>
                        </div>

                    </div>
                }

            </div>

            @* ── Detail / preview panel now lives in a slide-in drawer ──── *@
            <MudDrawer Open="_isDrawerOpen"
                       OpenChanged="OnDrawerOpenChanged"
                       Anchor="Anchor.End"
                       Elevation="4"
                       Variant="DrawerVariant.Temporary"
                       Fixed="false"
                       Width="40vw"
                       Class="wa-detail-drawer">

                @if (_selectedFile is not null)
                {
                    <div class="pa-4 wa-drawer-body">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">

                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@GetFileIcon(_selectedFile)" Color="Color.Primary" />
                                <MudText Typo="Typo.subtitle1">@_selectedFile.OriginalFileName</MudText>
                            </MudStack>

                            <MudStack Row="true" Spacing="1">
                                <MudTooltip Text="Cut (then open a folder and paste)">
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCut"
                                                   Size="Size.Small"
                                                   OnClick="@(() => CutFile(_selectedFile))" />
                                </MudTooltip>
                                <MudTooltip Text="Open in new tab">
                                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenFileInNewTabAsync(_selectedFile))" />
                                </MudTooltip>
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                               Size="Size.Small"
                                               OnClick="ClearSelection" />
                            </MudStack>

                        </MudStack>

                        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3 wa-tab-panels"
                                 @bind-ActivePanelIndex="_activeTabIndex">

                            <MudTabPanel Text="Text" Icon="@Icons.Material.Filled.Description">

                                @if (string.IsNullOrEmpty(_selectedFile.Content))
                                {
                                    <MudText Color="Color.Secondary" Class="py-4">
                                        No text content available for this file yet.
                                    </MudText>
                                }
                                else
                                {
                                    <MudStack Spacing="2" Class="wa-tab-fill">

                                        <MudTextField T="string"
                                                      @bind-Value="_editableContent"
                                                      Lines="14"
                                                      Variant="Variant.Outlined"
                                                      FullWidth="true"
                                                      Class="wa-fill-editor" />

                                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                                            <MudButton Variant="Variant.Text"
                                                       Disabled="@(!_isContentDirty)"
                                                       OnClick="ResetContent">
                                                Discard
                                            </MudButton>

                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Primary"
                                                       StartIcon="@Icons.Material.Filled.Save"
                                                       Disabled="@(!_isContentDirty)"
                                                       OnClick="SaveContentAsync">
                                                @(_isSavingContent ? "Saving..." : "Save")
                                            </MudButton>
                                        </MudStack>

                                    </MudStack>
                                }

                            </MudTabPanel>

                            <MudTabPanel Text="Preview" Icon="@Icons.Material.Filled.Visibility">

                                @{
                                    var previewUrl = $"{BuildDownloadUrl(_selectedFile)}?inline=true";
                                    var kind = GetPreviewKind(_selectedFile);
                                }

                                <div class="wa-tab-fill">
                                    @switch (kind)
                                    {
                                        case PreviewKind.Frame:
                                            @* MudBlazor has no iframe-equivalent component; this raw tag is a required exception. *@
                                            <iframe src="@previewUrl" class="wa-preview-frame"></iframe>
                                            break;

                                        case PreviewKind.Image:
                                            <div class="wa-preview-media">
                                                <img src="@previewUrl" alt="@_selectedFile.OriginalFileName" />
                                            </div>
                                            break;

                                        case PreviewKind.Video:
                                            <div class="wa-preview-media">
                                                <video src="@previewUrl" controls></video>
                                            </div>
                                            break;

                                        case PreviewKind.Audio:
                                            <div class="wa-preview-media">
                                                <audio src="@previewUrl" controls></audio>
                                            </div>
                                            break;

                                        default:
                                            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="py-8">
                                                <MudIcon Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Large" Color="Color.Secondary" />
                                                <MudText Color="Color.Secondary">The browser can't preview this file type.</MudText>
                                                <MudButton Variant="Variant.Outlined"
                                                           StartIcon="@Icons.Material.Filled.Download"
                                                           OnClick="@(() => DownloadAsync(_selectedFile))">
                                                    Download instead
                                                </MudButton>
                                            </MudStack>
                                            break;
                                    }
                                </div>

                            </MudTabPanel>

                        </MudTabs>

                    </div>
                }

            </MudDrawer>
        }

    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>

</MudDialog>

@code {
    private RenderFragment TagPickerContent(StoredFileResponse file) => @<MudStack Spacing="2" Class="pa-3" Style="min-width:240px">

        <MudTextField T="string"
                      @bind-Value="_newTagName"
                      Label="Tag Name"
                      Immediate="true" />

        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
            @foreach (var color in _presetColors)
            {
                <MudChip T="string"
                         Size="Size.Small"
                         Color="@color.Value"
                         Variant="@(color.Name == _newTagColor ? Variant.Filled : Variant.Outlined)"
                         OnClick="@(() => _newTagColor = color.Name)">
                    @color.Name
                </MudChip>
            }
        </MudStack>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Disabled="@string.IsNullOrWhiteSpace(_newTagName)"
                   OnClick="@(() => AddTagAsync(file))">
            Add
        </MudButton>

    </MudStack>;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Inject]
    private IDialogService DialogService { get; set; } = default!;

    [Inject]
    private IJSRuntime JsRuntime { get; set; } = default!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = default!;

    // ── all client-service dependencies come from the host via Parameters ──

    [Parameter, EditorRequired]
    public Func<CancellationToken, Task<IReadOnlyList<StoredFileResponse>>> LoadFilesFunc { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<int, CancellationToken, Task> DeleteFileFunc { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<int, string, string, CancellationToken, Task> AddTagFunc { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<int, int, CancellationToken, Task> RemoveTagFunc { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<IReadOnlyList<IBrowserFile>, int?, CancellationToken, Task<bool>> UploadFilesFunc { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<CancellationToken, Task<IReadOnlyList<StoredFolderResponse>>> LoadFoldersFunc { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<string, int?, CancellationToken, Task<StoredFolderResponse>> CreateFolderFunc { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<int, string, CancellationToken, Task> RenameFolderFunc { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<int, int?, CancellationToken, Task> MoveFolderFunc { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<int, CancellationToken, Task> DeleteFolderFunc { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<IReadOnlyList<int>, int?, CancellationToken, Task> MoveFilesFunc { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<StoredFileResponse, string> BuildDownloadUrl { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<StoredFileResponse, string> BuildThumbnailUrl { get; set; } = default!;

    // Optional: not wired by the host yet until the update-content endpoint exists.
    [Parameter]
    public Func<int, string, CancellationToken, Task<bool>>? SaveContentFunc { get; set; }

    // Optional: host wires this to build/navigate to a routable page mirroring this
    // dialog's content (e.g. "/documents/{id}/files"). A dialog has no URL of its own,
    // so a genuine "open in new tab" requires the host to supply one.
    [Parameter]
    public Func<Task>? OnOpenInNewTabClicked { get; set; }

    [Parameter]
    public string? ContextLabel { get; set; }

    private enum ViewMode { List, Grid }

    private ViewMode _viewMode = ViewMode.Grid;

    // Same staged-files pattern as FileUploadDialog — MudFileUpload owns this list,
    // we upload immediately and clear it right after (see OnFilesChanged below).
    private IReadOnlyList<IBrowserFile>? _pendingFiles;

    private IReadOnlyList<StoredFileResponse> _files = Array.Empty<StoredFileResponse>();

    private IReadOnlyList<StoredFolderResponse> _folders = Array.Empty<StoredFolderResponse>();
    private int? _currentFolderId;   // null = root
    private int? _selectedFolderId;

    private List<int>? _cutFileIds;
    private int? _cutFolderId;

    private bool HasCut => _cutFileIds is { Count: > 0 } || _cutFolderId is not null;

    private IEnumerable<StoredFolderResponse> VisibleFolders =>
        _folders.Where(f => f.ParentFolderId == _currentFolderId);

    private IReadOnlyList<StoredFileResponse> VisibleFiles =>
        _files.Where(f => f.FolderId == _currentFolderId).ToList();

    private List<StoredFolderResponse> BreadcrumbPath
    {
        get
        {
            var path = new List<StoredFolderResponse>();
            var byId = _folders.ToDictionary(f => f.Id);
            var id = _currentFolderId;

            while (id is int c && byId.TryGetValue(c, out var folder))
            {
                path.Insert(0, folder);
                id = folder.ParentFolderId;
            }

            return path;
        }
    }

    private bool _isLoading;
    private bool _isUploading;

    private StoredFileResponse? _selectedFile;
    private bool _isDrawerOpen;
    private string _editableContent = string.Empty;
    private bool _isSavingContent;

    private const int PreviewTabIndex = 1;
    private int _activeTabIndex = PreviewTabIndex;

    private bool _isContentDirty =>
    _selectedFile is not null && _editableContent != (_selectedFile.Content ?? string.Empty);

    private string _newTagName = string.Empty;
    private string _newTagColor = nameof(Color.Primary);

    private IJSObjectReference? _dropPasteModule;
    private DotNetObjectReference<ManageStoredFilesDialog>? _dotNetRef;

    private readonly (string Name, Color Value)[] _presetColors =
    {
        (nameof(Color.Primary), Color.Primary),
        (nameof(Color.Secondary), Color.Secondary),
        (nameof(Color.Tertiary), Color.Tertiary),
        (nameof(Color.Success), Color.Success),
        (nameof(Color.Warning), Color.Warning),
        (nameof(Color.Error), Color.Error),
        (nameof(Color.Info), Color.Info),
        (nameof(Color.Dark), Color.Dark),
    };

    private enum PreviewKind { Frame, Image, Video, Audio, None }

    private static PreviewKind GetPreviewKind(StoredFileResponse file)
    {
        var type = file.ContentType?.ToLowerInvariant() ?? string.Empty;
        var ext = System.IO.Path.GetExtension(file.OriginalFileName).ToLowerInvariant();

        if (type.StartsWith("image/") || ext is ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp" or ".svg")
            return PreviewKind.Image;

        if (type.StartsWith("video/") || ext is ".mp4" or ".webm" or ".ogv" or ".mov")
            return PreviewKind.Video;

        if (type.StartsWith("audio/") || ext is ".mp3" or ".wav" or ".m4a" or ".ogg")
            return PreviewKind.Audio;

        if (type is "application/pdf" or "text/plain" or "application/json" or "application/xml" or "text/xml"
            || ext is ".pdf" or ".txt" or ".log" or ".json" or ".xml")
            return PreviewKind.Frame;

        return PreviewKind.None;
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;
        StateHasChanged();

        _files = await LoadFilesFunc(CancellationToken.None);
        _folders = await LoadFoldersFunc(CancellationToken.None);

        if (_currentFolderId is int current && _folders.All(f => f.Id != current))
            _currentFolderId = null;

        _isLoading = false;
        StateHasChanged();
    }

    private void SelectFile(StoredFileResponse file)
    {
        _selectedFolderId = null;
        _selectedFile = file;
        _editableContent = file.Content ?? string.Empty;
        _activeTabIndex = PreviewTabIndex;
        _isDrawerOpen = true;
    }

    private void ClearSelection() => OnDrawerOpenChanged(false);

    private void OnDrawerOpenChanged(bool isOpen)
    {
        _isDrawerOpen = isOpen;
        if (!isOpen)
        {
            _selectedFile = null;
            _editableContent = string.Empty;
        }
    }


    // ContextLabel convention: first line = title, anything after the first '\n' = details
    private string TitleLine =>
        (ContextLabel ?? string.Empty).Split('\n', 2)[0].Trim();

    private string? SubtitleLine
    {
        get
        {
            var parts = (ContextLabel ?? string.Empty).Split('\n', 2);
            return parts.Length > 1 ? parts[1].Trim() : null;
        }
    }


    private void ResetContent()
    {
        if (_selectedFile is not null)
            _editableContent = _selectedFile.Content ?? string.Empty;
    }

    private void OnTableRowClick(TableRowClickEventArgs<StoredFileResponse> args)
    {
        if (args.Item is null)
            return;

        SelectFile(args.Item);
    }

    private async Task HandleCardAddTag((StoredFileResponse File, string Name, string Color) args)
    {
        await AddTagFunc(args.File.Id, args.Name, args.Color, CancellationToken.None);
        await ReloadAsync();
    }

    private async Task HandleCardRemoveTag((StoredFileResponse File, TagResponse Tag) args)
    {
        await RemoveTagFunc(args.File.Id, args.Tag.Id, CancellationToken.None);
        await ReloadAsync();
    }

    private async Task SaveContentAsync()
    {
        if (_selectedFile is null)
            return;

        if (SaveContentFunc is null)
        {
            Snackbar.Add("Saving content is not available yet — the server endpoint isn't implemented.", Severity.Info);
            return;
        }

        _isSavingContent = true;
        StateHasChanged();

        var success = await SaveContentFunc(_selectedFile.Id, _editableContent, CancellationToken.None);

        _isSavingContent = false;

        if (success)
        {
            Snackbar.Add("Content saved.", Severity.Success);
            await ReloadAsync();

            var refreshed = _files.FirstOrDefault(f => f.Id == _selectedFile.Id);
            if (refreshed is not null)
            {
                var currentTab = _activeTabIndex;
                SelectFile(refreshed);
                _activeTabIndex = currentTab;
            }
        }
        else
        {
            Snackbar.Add("Failed to save content.", Severity.Error);
        }
    }

    // Same MudFileUpload FilesChanged pattern as FileUploadDialog (including the
    // dedup-by-name-and-size step). The only difference: instead of staging the
    // files for a separate "Attach" confirm click, we upload immediately, since
    // this drop-zone lives inline on the page now.
    private async Task OnFilesChanged(IReadOnlyList<IBrowserFile> incoming)
    {
        var deduped = incoming?
            .GroupBy(f => (f.Name, f.Size))
            .Select(g => g.First())
            .ToList();

        if (deduped is null || deduped.Count == 0)
            return;

        _isUploading = true;
        StateHasChanged();

        var success = await UploadFilesFunc(deduped, _currentFolderId, CancellationToken.None);

        _isUploading = false;
        _pendingFiles = null;

        if (success)
        {
            Snackbar.Add(deduped.Count == 1 ? "File attached." : $"{deduped.Count} files attached.", Severity.Success);
            await ReloadAsync();
        }
        else
        {
            Snackbar.Add("An error occurred while uploading files.", Severity.Error);
        }
    }

    private async Task DownloadAsync(StoredFileResponse file)
    {
        var url = BuildDownloadUrl(file);
        await JsRuntime.InvokeVoidAsync("open", url, "_blank");
    }

    private async Task OpenFileInNewTabAsync(StoredFileResponse file)
    {
        var url = BuildDownloadUrl(file);
        await JsRuntime.InvokeVoidAsync("open", $"{url}?inline=true", "_blank");
    }

    private async Task OpenInNewTabAsync()
    {
        if (OnOpenInNewTabClicked is not null)
        {
            await OnOpenInNewTabClicked();
            return;
        }

        Snackbar.Add("This view isn't hooked up to a standalone page yet.", Severity.Info);
    }

    private async Task DeleteAsync(StoredFileResponse file)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            $"Are you sure you want to delete \"{file.OriginalFileName}\"?",
            yesText: "Delete",
            cancelText: "Cancel",
            options: new DialogOptions { CloseButton = true });

        if (confirmed != true)
            return;

        await DeleteFileFunc(file.Id, CancellationToken.None);

        if (_selectedFile?.Id == file.Id)
            ClearSelection();

        Snackbar.Add("File deleted.", Severity.Success);
        await ReloadAsync();
    }

    private async Task AddTagAsync(StoredFileResponse file)
    {
        if (string.IsNullOrWhiteSpace(_newTagName))
            return;

        await AddTagFunc(file.Id, _newTagName.Trim(), _newTagColor, CancellationToken.None);

        _newTagName = string.Empty;
        await ReloadAsync();
    }

    private async Task RemoveTagAsync(StoredFileResponse file, TagResponse tag)
    {
        await RemoveTagFunc(file.Id, tag.Id, CancellationToken.None);
        await ReloadAsync();
    }

    private static Color ParseColor(string? colorName)
    {
        return Enum.TryParse<Color>(colorName, ignoreCase: true, out var parsed)
            ? parsed
            : Color.Default;
    }

    // ── JS: drop/paste upload, internal drag-drop, cut/paste shortcuts ──

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _dotNetRef = DotNetObjectReference.Create(this);

        // bump ?v= whenever fileDropPaste.js changes, so the browser doesn't serve a cached copy
        _dropPasteModule = await JsRuntime.InvokeAsync<IJSObjectReference>(
            "import", "./_content/Marilog.Shared.UI/js/fileDropPaste.js?v=2");

        await _dropPasteModule.InvokeVoidAsync("attach", _dotNetRef);
    }

    public async ValueTask DisposeAsync()
    {
        if (_dropPasteModule is not null)
        {
            try
            {
                await _dropPasteModule.InvokeVoidAsync("detach");
                await _dropPasteModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }

        _dotNetRef?.Dispose();
    }

    // ── Folders: navigation ─────────────────────────────────────────────

    private void OpenFolder(int? folderId)
    {
        _currentFolderId = folderId;
        _selectedFolderId = null;
        ClearSelection();
    }

    private void OnFolderClick(StoredFolderResponse folder, MouseEventArgs e)
    {
        if (e.Detail >= 2)
            OpenFolder(folder.Id);          // second click of a double-click
        else
            _selectedFolderId = folder.Id;  // single click = select (for Ctrl+X)
    }

    private string FolderItemClass(StoredFolderResponse folder) =>
        "wa-folder-item"
        + (folder.Id == _selectedFolderId ? " wa-folder-selected" : string.Empty)
        + (folder.Id == _cutFolderId ? " wa-cut" : string.Empty);

    private string FileDragClass(StoredFileResponse file) =>
        "wa-file-drag" + (_cutFileIds?.Contains(file.Id) == true ? " wa-cut" : string.Empty);

    // ── Folders: CRUD ───────────────────────────────────────────────────

    private async Task CreateFolderAsync()
    {
        var name = await PromptFolderNameAsync("New Folder", string.Empty);
        if (name is null)
            return;

        if (NameExists(name, _currentFolderId, excludeId: null))
        {
            Snackbar.Add($"A folder named \"{name}\" already exists here.", Severity.Warning);
            return;
        }

        await CreateFolderFunc(name, _currentFolderId, CancellationToken.None);
        await ReloadAsync();
    }

    private async Task RenameFolderAsync(StoredFolderResponse folder)
    {
        var name = await PromptFolderNameAsync("Rename Folder", folder.Name);
        if (name is null || name == folder.Name)
            return;

        if (NameExists(name, folder.ParentFolderId, folder.Id))
        {
            Snackbar.Add($"A folder named \"{name}\" already exists here.", Severity.Warning);
            return;
        }

        await RenameFolderFunc(folder.Id, name, CancellationToken.None);
        await ReloadAsync();
    }

    private async Task DeleteFolderAsync(StoredFolderResponse folder)
    {
        if (_files.Any(f => f.FolderId == folder.Id) || _folders.Any(f => f.ParentFolderId == folder.Id))
        {
            Snackbar.Add("Only empty folders can be deleted.", Severity.Warning);
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            $"Are you sure you want to delete the folder \"{folder.Name}\"?",
            yesText: "Delete",
            cancelText: "Cancel",
            options: new DialogOptions { CloseButton = true });

        if (confirmed != true)
            return;

        await DeleteFolderFunc(folder.Id, CancellationToken.None);

        if (_cutFolderId == folder.Id)
            _cutFolderId = null;

        Snackbar.Add("Folder deleted.", Severity.Success);
        await ReloadAsync();
    }

    private async Task<string?> PromptFolderNameAsync(string title, string initialName)
    {
        var parameters = new DialogParameters<FolderNameDialog> { { x => x.InitialName, initialName } };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<FolderNameDialog>(title, parameters, options);
        var result = await dialog.Result;

        return result is null || result.Canceled ? null : result.Data as string;
    }

    private bool NameExists(string name, int? parentFolderId, int? excludeId) =>
        _folders.Any(f => f.ParentFolderId == parentFolderId
                       && f.Id != excludeId
                       && string.Equals(f.Name, name.Trim(), StringComparison.OrdinalIgnoreCase));

    // ── Moving (shared by drag-drop and cut-paste) ──────────────────────

    private async Task MoveFilesToAsync(IReadOnlyList<int> fileIds, int? targetFolderId)
    {
        var ids = fileIds
            .Where(id => _files.Any(f => f.Id == id && f.FolderId != targetFolderId))
            .ToList();

        if (ids.Count == 0)
            return;

        await MoveFilesFunc(ids, targetFolderId, CancellationToken.None);

        Snackbar.Add(ids.Count == 1 ? "File moved." : $"{ids.Count} files moved.", Severity.Success);
        await ReloadAsync();
    }

    private async Task MoveFolderToAsync(int folderId, int? targetParentId)
    {
        var folder = _folders.FirstOrDefault(f => f.Id == folderId);
        if (folder is null || folder.ParentFolderId == targetParentId || targetParentId == folderId)
            return;

        if (IsSelfOrDescendant(targetParentId, folderId))
        {
            Snackbar.Add("A folder can't be moved into one of its subfolders.", Severity.Warning);
            return;
        }

        if (NameExists(folder.Name, targetParentId, folder.Id))
        {
            Snackbar.Add($"A folder named \"{folder.Name}\" already exists there.", Severity.Warning);
            return;
        }

        await MoveFolderFunc(folderId, targetParentId, CancellationToken.None);

        Snackbar.Add("Folder moved.", Severity.Success);
        await ReloadAsync();
    }

    private bool IsSelfOrDescendant(int? candidateId, int folderId)
    {
        var byId = _folders.ToDictionary(f => f.Id);
        var id = candidateId;

        while (id is int c)
        {
            if (c == folderId)
                return true;

            id = byId.TryGetValue(c, out var f) ? f.ParentFolderId : null;
        }

        return false;
    }

    // ── Drag & drop (driven by JS, which calls in here on drop) ─────────

    [JSInvokable]
    public Task OnInternalDrop(string kind, int id, int? targetFolderId) =>
        InvokeAsync(async () =>
        {
            if (kind == "file")
                await MoveFilesToAsync([id], targetFolderId);
            else if (kind == "folder")
                await MoveFolderToAsync(id, targetFolderId);
        });

    // ── Cut & paste ─────────────────────────────────────────────────────

    private void CutFolder(StoredFolderResponse folder)
    {
        _cutFolderId = folder.Id;
        _cutFileIds = null;
    }

    private void CutFile(StoredFileResponse file)
    {
        _cutFileIds = [file.Id];
        _cutFolderId = null;
        ClearSelection(); // close the drawer so the user can navigate to the target folder
    }

    [JSInvokable]
    public async Task OnCutShortcut()
    {
        if (_selectedFolderId is int folderId)
        {
            _cutFolderId = folderId;
            _cutFileIds = null;
        }
        else if (_selectedFile is not null)
        {
            _cutFileIds = [_selectedFile.Id];
            _cutFolderId = null;
        }
        else
        {
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnPasteShortcut() => InvokeAsync(PasteAsync);

    private async Task PasteAsync()
    {
        var fileIds = _cutFileIds;
        var folderId = _cutFolderId;
        _cutFileIds = null;
        _cutFolderId = null;

        if (fileIds is { Count: > 0 })
            await MoveFilesToAsync(fileIds, _currentFolderId);
        else if (folderId is int id)
            await MoveFolderToAsync(id, _currentFolderId);
    }

    private static string GetFileIcon(StoredFileResponse file)
    {
        var ext = System.IO.Path.GetExtension(file.OriginalFileName).ToLowerInvariant();

        return ext switch
        {
            ".pdf" => Icons.Material.Filled.PictureAsPdf,
            ".doc" or ".docx" => Icons.Material.Filled.Description,
            ".xls" or ".xlsx" or ".csv" => Icons.Material.Filled.TableChart,
            ".ppt" or ".pptx" => Icons.Material.Filled.Slideshow,
            ".zip" or ".rar" or ".7z" => Icons.Material.Filled.FolderZip,
            ".txt" => Icons.Material.Filled.Article,
            _ => Icons.Material.Filled.InsertDriveFile
        };
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";

        if (bytes < 1024 * 1024)
            return $"{bytes / 1024d:F1} KB";

        return $"{bytes / 1024d / 1024d:F1} MB";
    }

    private void Close()
    {
        MudDialog.Close();
    }
}

