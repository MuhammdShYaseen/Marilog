@using Marilog.Kernel.Enums
@using Marilog.Ship.Services.GeneralAccount

@* The five MGA pages + summary. Read-only: the draft and a closed MGA look the same.
   LiveSummary = the summary with the count being entered on the MGA page. *@

<MudTabs Elevation="0" Outlined="true" Rounded="true" PanelClass="pa-3" Class="mt-2">

    @* ── Page 1 ───────────────────────────────────────────────────────────── *@
    <MudTabPanel Text="1. Ship's Movements">
        <MudSimpleTable Dense="true" Bordered="true">
            <thead>
                <tr><th>Voyage</th><th>Port</th><th>Arrival</th><th>Departure</th><th>Purpose</th></tr>
            </thead>
            <tbody>
                @if (Report.Movements.Count == 0)
                {
                    <tr><td colspan="5">No port calls in this period.</td></tr>
                }
                @foreach (var m in Report.Movements)
                {
                    <tr>
                        <td>@m.VoyageNumber</td>
                        <td>@m.PortName</td>
                        <td>@When(m.Arrival)</td>
                        <td>@When(m.Departure)</td>
                        <td>@m.Purpose</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudTabPanel>

    @* ── Page 2 ───────────────────────────────────────────────────────────── *@
    <MudTabPanel Text="2. Crew Wages">
        <MudText Typo="Typo.caption" Class="mb-2 d-block">
            Crew paid through the master's account. Same wage rule as Marilog payroll. Amounts in @Report.BaseCurrencyCode.
        </MudText>
        <MudSimpleTable Dense="true" Bordered="true">
            <thead>
                <tr>
                    <th>Crew member</th>
                    <th>Rank</th>
                    <th style="text-align:right">Wage / month</th>
                    <th style="text-align:right">Days</th>
                    <th style="text-align:right">Wages</th>
                    <th style="text-align:right">Extras</th>
                    <th style="text-align:right">Deductions</th>
                    <th style="text-align:right">Net</th>
                </tr>
            </thead>
            <tbody>
                @if (Report.Wages.Count == 0)
                {
                    <tr><td colspan="8">No crew paid through the master in this period.</td></tr>
                }
                @foreach (var w in Report.Wages)
                {
                    <tr>
                        <td>@w.CrewName</td>
                        <td>@w.RankName</td>
                        <td style="text-align:right">@M(w.MonthlyWage)</td>
                        <td style="text-align:right">@w.Days</td>
                        <td style="text-align:right">@M(w.Wages)</td>
                        <td style="text-align:right">@M(w.Extras)</td>
                        <td style="text-align:right">@M(w.Deductions)</td>
                        <td style="text-align:right">@M(w.Net)</td>
                    </tr>
                }
                <tr style="font-weight:600">
                    <td colspan="4">Total</td>
                    <td style="text-align:right">@M(Report.Wages.Sum(x => x.Wages))</td>
                    <td style="text-align:right">@M(Report.Wages.Sum(x => x.Extras))</td>
                    <td style="text-align:right">@M(Report.Wages.Sum(x => x.Deductions))</td>
                    <td style="text-align:right">@M(Report.Wages.Sum(x => x.Net))</td>
                </tr>
            </tbody>
        </MudSimpleTable>
    </MudTabPanel>

    @* ── Page 3 ───────────────────────────────────────────────────────────── *@
    <MudTabPanel Text="3. Master's Expenses">
        <MudSimpleTable Dense="true" Bordered="true">
            <thead>
                <tr>
                    <th>Paid on</th>
                    <th>Document</th>
                    <th>Type</th>
                    <th>Supplier</th>
                    <th>Port</th>
                    <th>Paid with</th>
                    <th style="text-align:right">Amount</th>
                    <th style="text-align:right">@Report.BaseCurrencyCode</th>
                </tr>
            </thead>
            <tbody>
                @if (Report.Expenses.Count == 0)
                {
                    <tr><td colspan="8">No payments in this period.</td></tr>
                }
                @foreach (var e in Report.Expenses)
                {
                    <tr>
                        <td>@e.Date.ToString("dd.MM.yyyy")</td>
                        <td>@e.DocNumber</td>
                        <td>@e.DocTypeName</td>
                        <td>@e.SupplierName</td>
                        <td>@e.PortName</td>
                        <td>@MethodLabel(e.Method)</td>
                        <td style="text-align:right">@M(e.Amount) @e.CurrencyCode</td>
                        <td style="text-align:right">@M(e.BaseAmount)</td>
                    </tr>
                }
                <tr style="font-weight:600">
                    <td colspan="7">Total</td>
                    <td style="text-align:right">@M(Report.Expenses.Sum(x => x.BaseAmount))</td>
                </tr>
            </tbody>
        </MudSimpleTable>

        @if (Report.CigarettePurchases.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Cigarettes bought (not an expense: cash became cigarettes on board)</MudText>
            <MudSimpleTable Dense="true" Bordered="true">
                <tbody>
                    @foreach (var e in Report.CigarettePurchases)
                    {
                        <tr>
                            <td>@e.Date.ToString("dd.MM.yyyy")</td>
                            <td>@e.DocNumber</td>
                            <td>@e.SupplierName</td>
                            <td>@MethodLabel(e.Method)</td>
                            <td style="text-align:right">@M(e.Amount) @e.CurrencyCode</td>
                            <td style="text-align:right">@M(e.BaseAmount) @Report.BaseCurrencyCode</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudTabPanel>

    @* ── Page 4 ───────────────────────────────────────────────────────────── *@
    <MudTabPanel Text="4. Received from Owner">
        <MudSimpleTable Dense="true" Bordered="true">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Port</th>
                    <th>Reference</th>
                    <th style="text-align:right">Amount</th>
                    <th style="text-align:right">@Report.BaseCurrencyCode</th>
                </tr>
            </thead>
            <tbody>
                @if (Report.Received.Count == 0)
                {
                    <tr><td colspan="6">Nothing received in this period.</td></tr>
                }
                @foreach (var r in Report.Received)
                {
                    <tr>
                        <td>@r.Date.ToString("dd.MM.yyyy")</td>
                        <td>@r.Description</td>
                        <td>@r.PortName</td>
                        <td>@r.Reference</td>
                        <td style="text-align:right">@M(r.Amount) @r.CurrencyCode</td>
                        <td style="text-align:right">@M(r.BaseAmount)</td>
                    </tr>
                }
                <tr style="font-weight:600">
                    <td colspan="5">Total</td>
                    <td style="text-align:right">@M(Report.Received.Sum(x => x.BaseAmount))</td>
                </tr>
            </tbody>
        </MudSimpleTable>
    </MudTabPanel>

    @* ── Page 5 ───────────────────────────────────────────────────────────── *@
    <MudTabPanel Text="5. Crew Accounts">
        <MudText Typo="Typo.caption" Class="mb-2 d-block">
            Balance + is owed to the crew member, − is an advance. Amounts in @Report.BaseCurrencyCode.
        </MudText>
        <MudSimpleTable Dense="true" Bordered="true">
            <thead>
                <tr>
                    <th>Crew member</th>
                    <th>Rank</th>
                    <th style="text-align:right">Previous</th>
                    <th style="text-align:right">Wages</th>
                    <th style="text-align:right">Extras</th>
                    <th style="text-align:right">Cash</th>
                    <th style="text-align:right">Cigarettes</th>
                    <th style="text-align:right">Other</th>
                    <th style="text-align:right">Paid ashore</th>
                    <th style="text-align:right">Balance</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in MasterCrew)
                {
                    <tr>
                        <td>@a.CrewName</td>
                        <td>@a.RankName</td>
                        <td style="text-align:right">@M(a.PreviousBalance)</td>
                        <td style="text-align:right">@M(a.Wages)</td>
                        <td style="text-align:right">@M(a.Extras)</td>
                        <td style="text-align:right">@M(a.Cash)</td>
                        <td style="text-align:right">@M(a.Cigarettes)</td>
                        <td style="text-align:right">@M(a.Other)</td>
                        <td style="text-align:right">@M(a.PaidAshore)</td>
                        <td style="text-align:right;font-weight:600">@M(a.Balance)</td>
                    </tr>
                }
                <tr style="font-weight:600">
                    <td colspan="2">Total</td>
                    <td style="text-align:right">@M(MasterCrew.Sum(x => x.PreviousBalance))</td>
                    <td style="text-align:right">@M(MasterCrew.Sum(x => x.Wages))</td>
                    <td style="text-align:right">@M(MasterCrew.Sum(x => x.Extras))</td>
                    <td style="text-align:right">@M(MasterCrew.Sum(x => x.Cash))</td>
                    <td style="text-align:right">@M(MasterCrew.Sum(x => x.Cigarettes))</td>
                    <td style="text-align:right">@M(MasterCrew.Sum(x => x.Other))</td>
                    <td style="text-align:right">@M(MasterCrew.Sum(x => x.PaidAshore))</td>
                    <td style="text-align:right">@M(MasterCrew.Sum(x => x.Balance))</td>
                </tr>
            </tbody>
        </MudSimpleTable>

        @if (OfficeCrew.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">For office deduction (wages paid by the office)</MudText>
            <MudText Typo="Typo.caption" Class="mb-2 d-block">
                Cash and cigarettes are credited to the master; the office deducts them from the wages. Other deductions are for information.
            </MudText>
            <MudSimpleTable Dense="true" Bordered="true">
                <thead>
                    <tr>
                        <th>Crew member</th>
                        <th>Rank</th>
                        <th style="text-align:right">Cash</th>
                        <th style="text-align:right">Cigarettes</th>
                        <th style="text-align:right">Credited to master</th>
                        <th style="text-align:right">Other</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in OfficeCrew)
                    {
                        <tr>
                            <td>@a.CrewName</td>
                            <td>@a.RankName</td>
                            <td style="text-align:right">@M(a.Cash)</td>
                            <td style="text-align:right">@M(a.Cigarettes)</td>
                            <td style="text-align:right;font-weight:600">@M(a.Cash + a.Cigarettes)</td>
                            <td style="text-align:right">@M(a.Other)</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }

        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Transactions per crew member</MudText>
        <MudExpansionPanels MultiExpansion="true" Elevation="0" Outlined="true">
            @foreach (var a in Report.CrewAccounts)
            {
                <MudExpansionPanel Text="@($"{a.CrewName} — {a.RankName}  ·  balance {M(a.Balance)}")">
                    <MudSimpleTable Dense="true">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Entry</th>
                                <th>Details</th>
                                <th style="text-align:right">Amount</th>
                                <th style="text-align:right">@Report.BaseCurrencyCode</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>@Report.From.ToString("dd.MM.yyyy")</td>
                                <td>Previous balance</td>
                                <td></td>
                                <td></td>
                                <td style="text-align:right">@M(a.PreviousBalance)</td>
                            </tr>
                            @foreach (var e in a.Entries)
                            {
                                <tr>
                                    <td>@(e.HasTime ? e.Date.ToString("dd.MM.yyyy HH:mm") : e.Date.ToString("dd.MM.yyyy"))</td>
                                    <td>@e.Kind</td>
                                    <td>@e.Description</td>
                                    <td style="text-align:right">@M(e.Amount) @e.CurrencyCode</td>
                                    <td style="text-align:right">@M(e.BaseAmount)</td>
                                </tr>
                            }
                            <tr style="font-weight:600">
                                <td>@Report.To.ToString("dd.MM.yyyy")</td>
                                <td colspan="3">
                                    @(a.WagesPaidBy == WagesPaidBy.Master ? "Balance" : "Balance (draws above are for office deduction)")
                                </td>
                                <td style="text-align:right">@M(a.Balance)</td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudTabPanel>

    @* ── Summary ──────────────────────────────────────────────────────────── *@
    <MudTabPanel Text="Summary">
        <MudGrid Spacing="4">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2" Class="mb-1">Summary of account (@Report.BaseCurrencyCode)</MudText>
                <MudSimpleTable Dense="true" Bordered="true">
                    <tbody>
                        <tr><td>Previous balance</td><td style="text-align:right">@M(S.PreviousBalance)</td></tr>
                        <tr><td>+ Crew wages (page 2)</td><td style="text-align:right">@M(S.TotalWages)</td></tr>
                        <tr><td>+ Master's expenses (page 3)</td><td style="text-align:right">@M(S.TotalExpenses)</td></tr>
                        <tr><td>+ Crew draws for office deduction (page 5)</td><td style="text-align:right">@M(S.OfficeDeductions)</td></tr>
                        <tr><td>− Received from owner (page 4)</td><td style="text-align:right">@M(-S.TotalReceived)</td></tr>
                        <tr><td>± Exchange difference on cash</td><td style="text-align:right">@M(S.ExchangeDifference)</td></tr>
                        <tr><td>± Count difference (+ shortage, − surplus)</td><td style="text-align:right">@M(S.CountDifference)</td></tr>
                        <tr style="font-weight:600">
                            <td>Closing balance (+ master's favour, − owner's favour)</td>
                            <td style="text-align:right">@M(S.ClosingBalance)</td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2" Class="mb-1">Final check (@Report.BaseCurrencyCode)</MudText>
                <MudSimpleTable Dense="true" Bordered="true">
                    <tbody>
                        <tr><td>Closing balance</td><td style="text-align:right">@M(S.ClosingBalance)</td></tr>
                        <tr><td>− Crew balances (page 5)</td><td style="text-align:right">@M(-S.CrewBalances)</td></tr>
                        <tr><td>+ Cash on board</td><td style="text-align:right">@M(S.CashOnBoard)</td></tr>
                        <tr><td>+ Cigarettes on board</td><td style="text-align:right">@M(S.CigarettesOnBoard)</td></tr>
                        <tr style="font-weight:600">
                            <td>Difference</td>
                            <td style="text-align:right">
                                <MudText Typo="Typo.body2" Color="@(S.Difference == 0 ? Color.Success : Color.Error)">@M(S.Difference)</MudText>
                            </td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="mb-1">Cash and cigarettes on board</MudText>
                <MudSimpleTable Dense="true" Bordered="true">
                    <thead>
                        <tr>
                            <th></th>
                            <th style="text-align:right">Previous</th>
                            <th style="text-align:right">Expected</th>
                            <th style="text-align:right">Counted</th>
                            <th style="text-align:right">Rate to @Report.BaseCurrencyCode</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Report.Cash)
                        {
                            <tr>
                                <td>Cash @c.CurrencyCode</td>
                                <td style="text-align:right">@M(c.Previous)</td>
                                <td style="text-align:right">@M(c.Expected)</td>
                                <td style="text-align:right">@(c.Counted is { } n ? M(n) : "—")</td>
                                <td style="text-align:right">@c.RateToBase.ToString("0.######")</td>
                            </tr>
                        }
                        <tr>
                            <td>Cigarettes (value, @Report.BaseCurrencyCode)</td>
                            <td style="text-align:right">@M(Report.PreviousCigarettes)</td>
                            <td style="text-align:right">@M(Report.ExpectedCigarettes)</td>
                            <td style="text-align:right">@(Report.CountedCigarettes is { } k ? M(k) : "—")</td>
                            <td></td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </MudItem>
        </MudGrid>
    </MudTabPanel>
</MudTabs>

@code {
    [Parameter, EditorRequired] public MgaReport Report { get; set; } = default!;
    [Parameter] public MgaSummary? LiveSummary { get; set; }

    private MgaSummary S => LiveSummary ?? Report.Summary;

    private List<MgaCrewAccount> MasterCrew =>
        Report.CrewAccounts.Where(x => x.WagesPaidBy == WagesPaidBy.Master).ToList();
    private List<MgaCrewAccount> OfficeCrew =>
        Report.CrewAccounts.Where(x => x.WagesPaidBy == WagesPaidBy.Office).ToList();

    private static string M(decimal value) => value.ToString("N2");
    private static string When(DateTime? value) => value?.ToString("dd.MM.yyyy HH:mm") ?? "—";

    private static string MethodLabel(PaymentMethod method) => method switch
    {
        PaymentMethod.CashOnBoard or PaymentMethod.Cash => "Cash on board",
        PaymentMethod.CigarettesOnBoard => "Cigarettes on board",
        PaymentMethod.CashAtOffice => "Cash at office",
        PaymentMethod.BankTransfer => "Bank transfer",
        _ => method.ToString()
    };
}