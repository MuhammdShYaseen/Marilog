@page "/crew-account"
@inherits OwningComponentBase
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Contracts.Interfaces.Services.SystemServices
@using Marilog.Ship.Domain.Enums
@using Marilog.Ship.Services.CrewAccount
@using Marilog.Ship.Services.DeductionTypes
@using Marilog.Ship.Services.Setup
@using Microsoft.Extensions.DependencyInjection
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudText Typo="Typo.h5" Class="mb-3">Crew Account</MudText>

<div class="d-flex flex-wrap gap-3 align-center mb-3">
    <MudDatePicker @bind-Date="_from" @bind-Date:after="LoadListsAsync" Label="From" DateFormat="dd.MM.yyyy"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:180px" />
    <MudDatePicker @bind-Date="_to" @bind-Date:after="LoadListsAsync" Label="To" DateFormat="dd.MM.yyyy"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:180px" />
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}

<MudTabs Elevation="0" Outlined="true" PanelClass="pa-3">
    @* ── Withdrawals (MGA page 5) ────────────────────────────────────────── *@
    <MudTabPanel Text="Withdrawals">
        <div class="d-flex justify-end mb-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(_loading || _busy)" OnClick="@(() => OpenWithdrawalAsync(null))">New Withdrawal</MudButton>
        </div>

        <MudSimpleTable Dense="true" Hover="true" Bordered="true">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Crew member</th>
                    <th>Rank</th>
                    <th>Type</th>
                    <th style="text-align:right">Amount</th>
                    <th>Reason</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!_loading && _withdrawals.Count == 0)
                {
                    <tr><td colspan="7">No withdrawals in this period.</td></tr>
                }
                @foreach (var w in _withdrawals)
                {
                    var item = w;
                    <tr>
                        <td>@item.Date.ToString("dd.MM.yyyy")</td>
                        <td>@item.CrewName</td>
                        <td>@item.RankName</td>
                        <td>@WithdrawalLabel(item)</td>
                        <td style="text-align:right">@item.Amount.ToString("N2") @item.CurrencyCode</td>
                        <td>@item.Reason</td>
                        <td style="white-space:nowrap">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Disabled="@_busy"
                                           OnClick="@(() => OpenWithdrawalAsync(item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Disabled="@_busy"
                                           OnClick="@(() => DeleteWithdrawalAsync(item))" />
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudTabPanel>

    @* ── Extras (MGA page 2) ─────────────────────────────────────────────── *@
    <MudTabPanel Text="Extras">
        <div class="d-flex justify-end mb-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(_loading || _busy)" OnClick="@(() => OpenExtraAsync(null))">New Extra</MudButton>
        </div>

        <MudSimpleTable Dense="true" Hover="true" Bordered="true">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Crew member</th>
                    <th>Rank</th>
                    <th>Type</th>
                    <th style="text-align:right">Amount</th>
                    <th>Reason</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!_loading && _extras.Count == 0)
                {
                    <tr><td colspan="7">No extras in this period.</td></tr>
                }
                @foreach (var e in _extras)
                {
                    var item = e;
                    <tr>
                        <td>@item.Date.ToString("dd.MM.yyyy")</td>
                        <td>@item.CrewName</td>
                        <td>@item.RankName</td>
                        <td>@ExtraLabel(item.Type)</td>
                        <td style="text-align:right">@item.Amount.ToString("N2") @item.CurrencyCode</td>
                        <td>@item.Reason</td>
                        <td style="white-space:nowrap">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Disabled="@_busy"
                                           OnClick="@(() => OpenExtraAsync(item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Disabled="@_busy"
                                           OnClick="@(() => DeleteExtraAsync(item))" />
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudTabPanel>
</MudTabs>

@code {
    // OwningComponentBase: this page has its own DI scope → its own ShipContext.
    private ICrewAccountService AccountService => ScopedServices.GetRequiredService<ICrewAccountService>();
    private IShipSetupService SetupService => ScopedServices.GetRequiredService<IShipSetupService>();
    private ICrewContractService ContractService => ScopedServices.GetRequiredService<ICrewContractService>();
    private ICurrencyService CurrencyService => ScopedServices.GetRequiredService<ICurrencyService>();
    private IDeductionTypeService DeductionTypeService => ScopedServices.GetRequiredService<IDeductionTypeService>();

    private bool _loading = true;
    private bool _busy;

    private DateTime? _from;
    private DateTime? _to;
    private IReadOnlyList<CrewWithdrawalResponse> _withdrawals = [];
    private IReadOnlyList<CrewExtraResponse> _extras = [];

    private IReadOnlyList<CrewContractResponse> _crew = [];
    private IReadOnlyList<CurrencyResponse> _currencies = [];
    private IReadOnlyList<DeductionTypeResponse> _deductionTypes = [];

    protected override async Task OnInitializedAsync()
    {
        // This month by default.
        var firstDay = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _from = firstDay;
        _to = firstDay.AddMonths(1).AddDays(-1);

        try
        {
            // Sequential on purpose: one DbContext does not allow parallel queries.
            var status = await SetupService.GetStatusAsync();
            if (status.VesselId is int vesselId)
                _crew = (await ContractService.GetByVesselAsync(vesselId))
                        .OrderBy(x => x.SignOffDate.HasValue).ThenBy(x => x.PersonFullName).ToList();
            _currencies = await CurrencyService.GetActiveAsync();
            _deductionTypes = await DeductionTypeService.GetActiveAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        await LoadListsAsync();
    }

    private async Task LoadListsAsync()
    {
        if (_from is null || _to is null) return;

        _loading = true;
        try
        {
            var from = DateOnly.FromDateTime(_from.Value);
            var to = DateOnly.FromDateTime(_to.Value);
            _withdrawals = await AccountService.GetWithdrawalsAsync(from, to);
            _extras = await AccountService.GetExtrasAsync(from, to);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // ── Withdrawals ──────────────────────────────────────────────────────────

    private async Task OpenWithdrawalAsync(CrewWithdrawalResponse? existing)
    {
        var parameters = new DialogParameters
        {
            [nameof(CrewWithdrawalDialog.Existing)] = existing,
            [nameof(CrewWithdrawalDialog.Crew)] = _crew,
            [nameof(CrewWithdrawalDialog.Currencies)] = _currencies,
            [nameof(CrewWithdrawalDialog.DeductionTypes)] = _deductionTypes,
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CrewWithdrawalDialog>(
            existing is null ? "New Crew Withdrawal" : "Edit Crew Withdrawal", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not SaveCrewWithdrawalRequest request) return;

        await RunAsync(async () =>
        {
            if (existing is null)
                await AccountService.CreateWithdrawalAsync(request);
            else
                await AccountService.UpdateWithdrawalAsync(existing.Id, request);

            Snackbar.Add("Withdrawal saved.", Severity.Success);
            await LoadListsAsync();
        });
    }

    private async Task DeleteWithdrawalAsync(CrewWithdrawalResponse item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Withdrawal",
            $"Delete the withdrawal of {item.Amount:N2} {item.CurrencyCode} by {item.CrewName} on {item.Date:dd.MM.yyyy}?",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;

        await RunAsync(async () =>
        {
            await AccountService.DeleteWithdrawalAsync(item.Id);
            Snackbar.Add("Withdrawal deleted.", Severity.Success);
            await LoadListsAsync();
        });
    }

    // ── Extras ───────────────────────────────────────────────────────────────

    private async Task OpenExtraAsync(CrewExtraResponse? existing)
    {
        var parameters = new DialogParameters
        {
            [nameof(CrewExtraDialog.Existing)] = existing,
            [nameof(CrewExtraDialog.Crew)] = _crew,
            [nameof(CrewExtraDialog.Currencies)] = _currencies,
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CrewExtraDialog>(
            existing is null ? "New Crew Extra" : "Edit Crew Extra", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not SaveCrewExtraRequest request) return;

        await RunAsync(async () =>
        {
            if (existing is null)
                await AccountService.CreateExtraAsync(request);
            else
                await AccountService.UpdateExtraAsync(existing.Id, request);

            Snackbar.Add("Extra saved.", Severity.Success);
            await LoadListsAsync();
        });
    }

    private async Task DeleteExtraAsync(CrewExtraResponse item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Extra",
            $"Delete the {ExtraLabel(item.Type).ToLowerInvariant()} of {item.Amount:N2} {item.CurrencyCode} for {item.CrewName}?",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;

        await RunAsync(async () =>
        {
            await AccountService.DeleteExtraAsync(item.Id);
            Snackbar.Add("Extra deleted.", Severity.Success);
            await LoadListsAsync();
        });
    }

    // ── Labels / helper ──────────────────────────────────────────────────────

    private static string WithdrawalLabel(CrewWithdrawalResponse w) => w.Type switch
    {
        CrewWithdrawalType.Cash => "Cash",
        CrewWithdrawalType.Cigarettes => "Cigarettes",
        CrewWithdrawalType.Other => w.DeductionTypeName ?? "Other",
        _ => w.Type.ToString()
    };

    private static string ExtraLabel(CrewExtraType type) => type switch
    {
        CrewExtraType.Bonus => "Bonus",
        CrewExtraType.TravelTicket => "Travel ticket",
        CrewExtraType.Other => "Other",
        _ => type.ToString()
    };

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}