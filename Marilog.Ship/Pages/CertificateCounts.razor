@using Marilog.Contracts.DTOs.Responses


@* Expired / expiring soon / valid counts for the start page. *@

@if (Summary is null)
{
    <MudText Typo="Typo.body2">—</MudText>
}
else if (Summary.Total == 0)
{
    <MudText Typo="Typo.body2">No certificates entered yet.</MudText>
}
else
{
    <div class="d-flex flex-wrap gap-2">
        <MudChip T="string" Size="Size.Small" Color="@(Summary.Expired > 0 ? Color.Error : Color.Default)">
            Expired: @Summary.Expired
        </MudChip>
        <MudChip T="string" Size="Size.Small" Color="@(Summary.ExpiringSoon > 0 ? Color.Warning : Color.Default)">
            Expiring soon: @Summary.ExpiringSoon
        </MudChip>
        <MudChip T="string" Size="Size.Small" Color="Color.Success">Valid: @Summary.Valid</MudChip>
        @if (Summary.NoExpiry > 0)
        {
            <MudChip T="string" Size="Size.Small">No expiry: @Summary.NoExpiry</MudChip>
        }
    </div>
}

@code {
    [Parameter] public CertificateSummaryResponse? Summary { get; set; }
}