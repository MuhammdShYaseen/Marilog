@page "/"
@page "/vessels"
@inherits OwningComponentBase
@using Marilog.Contracts.DTOs.Requests.VesselDTOs
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Contracts.Interfaces.Services.SystemServices
@using Marilog.Shared.UI.Pages.Vessels
@using Microsoft.Extensions.DependencyInjection
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}

@if (_initialized)
{
    <SharedVesselPage Vessels="@_vessels"
                      OnAddClicked="OpenAddDialog"
                      OnEditClicked="OpenEditDialog"
                      OnDeleteClicked="ConfirmDelete"
                      OnToggleActiveClicked="ToggleActive" />
}

@code {
    // OwningComponentBase: this page has its own DI scope → its own ShipContext.
    // In a desktop app the root scope lives as long as the window, so services are not @inject-ed.
    private IVesselService VesselService => ScopedServices.GetRequiredService<IVesselService>();
    private ICompanyService CompanyService => ScopedServices.GetRequiredService<ICompanyService>();
    private ICountryService CountryService => ScopedServices.GetRequiredService<ICountryService>();
    private IVesselTypeService VesselTypeService => ScopedServices.GetRequiredService<IVesselTypeService>();

    private IReadOnlyList<VesselResponse> _vessels = [];
    private IReadOnlyList<CompanyResponse> _companies = [];
    private IReadOnlyList<CountryResponse> _countries = [];
    private IReadOnlyList<VesselTypeResponse> _vesselTypes = [];
    private bool _loading = true;
    private bool _initialized;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // Sequential on purpose: one DbContext does not allow parallel queries.
    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _vessels = await VesselService.GetAllAsync();
            _companies = await CompanyService.GetActiveAsync();
            _countries = await CountryService.GetAllAsync();
            _vesselTypes = await VesselTypeService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
            _initialized = true;
        }
    }

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters
        {
            [nameof(VesselDialog.Companies)] = _companies,
            [nameof(VesselDialog.Countries)] = _countries,
            [nameof(VesselDialog.VesselTypes)] = _vesselTypes,
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<VesselDialog>("New Vessel", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        var req = (CreateVesselRequest)result.Data!;
        try
        {
            await VesselService.CreateAsync(
                req.CompanyId,
                req.VesselName,
                req.ImoNumber,
                req.GrossTonnage,
                req.FlagCountryId,
                req.Notes,
                req.VesselTypeId);

            Snackbar.Add("Vessel created.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenEditDialog(VesselResponse vessel)
    {
        var parameters = new DialogParameters
        {
            [nameof(VesselDialog.Vessel)] = vessel,
            [nameof(VesselDialog.Companies)] = _companies,
            [nameof(VesselDialog.Countries)] = _countries,
            [nameof(VesselDialog.VesselTypes)] = _vesselTypes,
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<VesselDialog>("Edit Vessel", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        var req = (UpdateVesselRequest)result.Data!;
        try
        {
            await VesselService.UpdateAsync(
                vessel.Id,
                req.VesselName,
                req.ImoNumber,
                req.GrossTonnage,
                req.FlagCountryId,
                req.Notes,
                req.VesselTypeId);

            Snackbar.Add("Vessel updated.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ToggleActive(VesselResponse vessel)
    {
        try
        {
            if (vessel.IsActive)
                await VesselService.DeactivateAsync(vessel.Id);
            else
                await VesselService.ActivateAsync(vessel.Id);

            Snackbar.Add(vessel.IsActive ? "Vessel deactivated." : "Vessel activated.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ConfirmDelete(VesselResponse vessel)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Vessel",
            $"Delete '{vessel.Name}'? This action cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true) return;

        try
        {
            await VesselService.DeleteAsync(vessel.Id);
            Snackbar.Add("Vessel deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}