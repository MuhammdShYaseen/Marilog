@inherits LayoutComponentBase
@using Marilog.Contracts.DTOs.Responses
@using Marilog.Shared.UI.Layout
@using Marilog.Ship.Services.Setup
@using Microsoft.Extensions.DependencyInjection
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Nav

<SharedMainLayout Items="_navItems" AppTitle="Marilog Ship">
    <ChildContent>
        @Body
    </ChildContent>
</SharedMainLayout>

@code {
    private readonly List<NavItemResponse> _navItems =
    [
        new() { Id = 1,  Title = "Setup",             Route = "/setup",             Icon = "Settings",             Order = 1,  IsActive = true },
        new() { Id = 2,  Title = "Vessels",           Route = "/vessels",           Icon = "DirectionsBoat",       Order = 2,  IsActive = true },
        new() { Id = 5,  Title = "Crew",              Route = "/crew",              Icon = "Groups",               Order = 3,  IsActive = true },
        new() { Id = 11, Title = "Voyages",           Route = "/voyages",           Icon = "Sailing",              Order = 4,  IsActive = true },
        new() { Id = 3,  Title = "Purchases",         Route = "/purchases",         Icon = "Receipt",              Order = 5,  IsActive = true },
        new() { Id = 6,  Title = "Owner Remittances", Route = "/owner-remittances", Icon = "Payments",             Order = 6,  IsActive = true },
                new() { Id = 7,  Title = "Crew Account",      Route = "/crew-account",      Icon = "AccountBalanceWallet", Order = 7,  IsActive = true },
        new() { Id = 12, Title = "General Account",   Route = "/mga",               Icon = "AccountBalance",       Order = 8,  IsActive = true },
        new() { Id = 8,  Title = "Currencies",        Route = "/currencies",        Icon = "CurrencyExchange",     Order = 9,  IsActive = true },
        new() { Id = 9,  Title = "Ports",             Route = "/ports",             Icon = "Anchor",               Order = 10, IsActive = true },
        new() { Id = 4,  Title = "Document Types",    Route = "/document-types",    Icon = "Category",             Order = 11, IsActive = true },
        new() { Id = 10, Title = "Deduction Types",   Route = "/deduction-types",   Icon = "ListAlt",              Order = 12, IsActive = true },
    ];

    // Until the initial setup is completed, the app opens on the setup page.
    // The layout lives as long as the window, so it uses a short scope of its own.
    protected override async Task OnInitializedAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var status = await scope.ServiceProvider.GetRequiredService<IShipSetupService>().GetStatusAsync();

        if (!status.IsCompleted && !Nav.Uri.TrimEnd('/').EndsWith("/setup", StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo("/setup");
    }
}